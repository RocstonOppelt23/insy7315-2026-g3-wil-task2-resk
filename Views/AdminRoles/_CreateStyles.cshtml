        .switch { position: relative; width: 38px; height: 21px; flex-shrink: 0; border: 1px solid #cfdae8; border-radius: 999px; background: white; transition: 0.2s; }
        .switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 15px; height: 15px; border-radius: 50%; background: #cfdae8; transition: 0.2s; }
        .toggle:has(input:checked) .switch { border-color: #12b8ce; background: #12b8ce; }
