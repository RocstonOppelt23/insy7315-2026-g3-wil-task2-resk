        .editor-actions form { margin: 0; }
        .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 0 16px; border: 1px solid #d3dce8; border-radius: 8px; background: white; color: #14233e; font-size: 12px; font-weight: 800; text-decoration: none; cursor: pointer; }
