@model RESK.WIL.Models.ProductionDetailsViewModel

@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    Layout = null;
    ViewData["Title"] = "Production Details";

    var currentUser =
        await UserManager.GetUserAsync(User);

    var producerUsername =
        currentUser?.Email
        ?? currentUser?.UserName
        ?? "Producer";

    var producerInitial =
        !string.IsNullOrWhiteSpace(producerUsername)
            ? producerUsername.Substring(0, 1).ToUpper()
            : "P";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Production Details - R.E.S.K</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            background: #f4f7fb;
            color: #14233e;
        }

        button,
        input,
        textarea,
        select,
        a {
            font-family: inherit;
        }


        /* =====================================================
           SIDEBAR
        ===================================================== */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;

            width: 277px;

            display: flex;
            flex-direction: column;

            padding: 39px 21px;

            background: #071d3b;
            color: white;
        }

        .brand {
            display: flex;
            align-items: center;

            gap: 16px;

            margin: 0 14px 50px;
        }

        .brand-icon {
            width: 60px;
            height: 60px;

            display: flex;
            align-items: center;
            justify-content: center;

            flex-shrink: 0;

            border: 2px solid #12b8ce;
            border-radius: 18px;

            color: #14bfd4;

            font-size: 25px;
            font-weight: 900;
        }

        .brand-name {
            color: white;

            font-size: 24px;
            font-weight: 900;

            letter-spacing: 4px;
        }

        .brand-subtitle {
            margin-top: 7px;

            color: #c7d1e1;

            font-size: 9px;
            font-weight: 600;
        }


        /* =====================================================
           STEPS
        ===================================================== */

        .steps-heading {
            margin: 0 14px 12px;

            color: #6f83a2;

            font-size: 10px;
            font-weight: 800;
        }

        .steps {
            display: flex;
            flex-direction: column;

            gap: 7px;
        }

        .step {
            min-height: 51px;

            display: flex;
            align-items: center;

            gap: 13px;

            padding: 0 14px;

            border-radius: 10px;

            color: #8093b1;
        }

        .step.active {
            background: #15345e;
            color: white;
        }

        .step.complete {
            color: #8ca4c2;
        }

        .step-number {
            width: 29px;
            height: 29px;

            display: flex;
            align-items: center;
            justify-content: center;

            flex-shrink: 0;

            border: 1px solid #506685;
            border-radius: 50%;

            color: #9bacc3;

            font-size: 10px;
            font-weight: 800;
        }

        .step.complete .step-number,
        .step.active .step-number {
            border-color: #13b8ce;
            background: #13b8ce;
            color: white;
        }

        .step-name {
            font-size: 11px;
            font-weight: 700;
        }


        /* =====================================================
           PRODUCER PROFILE
        ===================================================== */

        .producer-profile {
            margin-top: auto;

            display: flex;
            align-items: center;

            gap: 11px;

            padding: 13px;

            border-radius: 11px;

            background: #14345e;
        }

        .producer-avatar {
            width: 37px;
            height: 37px;

            display: flex;
            align-items: center;
            justify-content: center;

            flex-shrink: 0;

            border-radius: 50%;

            background: #12b8ce;
            color: white;

            font-size: 11px;
            font-weight: 900;
        }

        .producer-profile-info {
            min-width: 0;
        }

        .producer-name {
            overflow: hidden;

            color: white;

            font-size: 11px;
            font-weight: 800;

            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .producer-role {
            margin-top: 5px;

            color: #b6c4d7;

            font-size: 9px;
        }


        /* =====================================================
           MAIN
        ===================================================== */

        .main {
            min-height: 100vh;

            margin-left: 277px;

            padding-bottom: 50px;

            background: #f4f7fb;
        }

        .page {
            width: calc(100% - 126px);
            max-width: 1000px;

            margin: 0 auto;

            padding-top: 25px;
        }


        /* =====================================================
           HEADER
        ===================================================== */

        .page-header {
            margin-bottom: 25px;
        }

        .page-title {
            color: #071d3b;

            font-size: 23px;
            font-weight: 900;
        }

        .page-description {
            margin-top: 8px;

            color: #71839e;

            font-size: 12px;
        }


        /* =====================================================
           PROGRESS
        ===================================================== */

        .progress-section {
            margin-bottom: 20px;
        }

        .progress-info {
            display: flex;
            justify-content: space-between;

            margin-bottom: 8px;

            color: #71839e;

            font-size: 10px;
            font-weight: 700;
        }

        .progress-track {
            width: 100%;
            height: 6px;

            overflow: hidden;

            border-radius: 20px;

            background: #dce4ef;
        }

        .progress-bar {
            width: 60%;
            height: 100%;

            border-radius: 20px;

            background: #12b8ce;
        }


        /* =====================================================
           FORM CARD
        ===================================================== */

        .form-card {
            padding: 29px 32px;

            border: 1px solid #d6dfeb;
            border-radius: 14px;

            background: white;
        }

        .card-title {
            color: #071d3b;

            font-size: 19px;
            font-weight: 900;
        }

        .card-description {
            margin-top: 8px;

            color: #71839e;

            font-size: 11px;
        }


        /* =====================================================
           FORM
        ===================================================== */

        .form-grid {
            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            gap: 21px 23px;

            margin-top: 27px;
        }

        .form-group {
            display: flex;
            flex-direction: column;

            gap: 8px;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-label {
            color: #14233e;

            font-size: 11px;
            font-weight: 800;
        }

        .required {
            color: #d64d58;
        }

        .form-control {
            width: 100%;
            height: 47px;

            padding: 0 14px;

            border: 1px solid #cfdae8;
            border-radius: 9px;

            outline: none;

            background: white;
            color: #14233e;

            font-size: 12px;
        }

        .form-control:focus {
            border-color: #12b8ce;

            box-shadow:
                0 0 0 3px rgba(18, 184, 206, .10);
        }

        textarea.form-control {
            min-height: 105px;

            padding: 13px 14px;

            line-height: 1.55;

            resize: vertical;
        }

        .currency-field {
            position: relative;
        }

        .currency-prefix {
            position: absolute;

            left: 14px;
            top: 50%;

            transform: translateY(-50%);

            color: #60728d;

            font-size: 12px;
            font-weight: 700;
        }

        .currency-field .form-control {
            padding-left: 34px;
        }

        .field-help {
            color: #8494aa;

            font-size: 9px;

            line-height: 1.5;
        }

        .validation-message {
            color: #cf4d56;

            font-size: 10px;
            font-weight: 600;
        }

        .validation-summary {
            margin-bottom: 20px;

            padding: 13px 15px;

            border: 1px solid #f0c2c5;
            border-radius: 9px;

            background: #fff7f7;
            color: #b84048;

            font-size: 11px;
        }

        .validation-summary:empty {
            display: none;
        }


        /* =====================================================
           BUTTONS
        ===================================================== */

        .actions {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-top: 24px;
        }

        .back-button,
        .draft-button,
        .continue-button {
            min-height: 43px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            border-radius: 8px;

            font-size: 11px;
            font-weight: 800;

            text-decoration: none;
        }

        .back-button {
            min-width: 118px;

            border: 1px solid #d3ddea;

            background: white;
            color: #526783;
        }

        .right-actions {
            display: flex;

            gap: 11px;
        }

        .draft-button {
            min-width: 128px;

            border: 1px solid #d3ddea;

            background: white;
            color: #526783;

            cursor: pointer;
        }

        .continue-button {
            min-width: 139px;

            border: none;

            background: #12b8ce;
            color: white;

            cursor: pointer;
        }

        .continue-button:hover {
            background: #0faabd;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @@media(max-width: 900px) {

            .sidebar {
                position: relative;

                width: 100%;
                min-height: auto;
            }

            .main {
                margin-left: 0;
            }

            .page {
                width: calc(100% - 40px);
            }

            .producer-profile {
                margin-top: 30px;
            }

        }

        @@media(max-width: 650px) {

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .actions {
                flex-direction: column;

                gap: 12px;
            }

            .back-button,
            .right-actions,
            .draft-button,
            .continue-button {
                width: 100%;
            }

            .right-actions {
                flex-direction: column;
            }

        }

    </style>

    <style id="reskWizardButtons">
        .resk-cancel { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1px solid #e1e7ef; border-radius: 8px; background: transparent; color: #61728d; font-size: 13px; font-weight: 800; text-decoration: none; transition: background 0.2s, border-color 0.2s, color 0.2s; }
        .resk-cancel:hover { border-color: #f0c2c5; background: #fff7f7; color: #b84048; }
        .resk-save-draft { min-height: 44px; padding: 0 22px; border: 1px solid #d3dce8; border-radius: 8px; background: #ffffff; color: #14233e; font-family: inherit; font-size: 13px; font-weight: 800; cursor: pointer; transition: border-color 0.2s, color 0.2s; }
        .resk-save-draft:hover { border-color: #12b8ce; color: #0a9fb2; }
    </style>    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=resk2" />
</head>


<body>


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-icon">
                R
            </div>

            <div>

                <div class="brand-name">
                    R.E.S.K
                </div>

                <div class="brand-subtitle">
                    SOFTWARE STUDIO
                </div>

            </div>

        </div>


        <div class="steps-heading">
            NEW PROPOSAL
        </div>


        <div class="steps">


            <div class="step complete">

                <div class="step-number">
                    ✓
                </div>

                <div class="step-name">
                    Producer details
                </div>

            </div>


            <div class="step complete">

                <div class="step-number">
                    ✓
                </div>

                <div class="step-name">
                    Programme details
                </div>

            </div>


            <div class="step active">

                <div class="step-number">
                    3
                </div>

                <div class="step-name">
                    Production details
                </div>

            </div>


            <div class="step">

                <div class="step-number">
                    4
                </div>

                <div class="step-name">
                    Attachments
                </div>

            </div>


            <div class="step">

                <div class="step-number">
                    5
                </div>

                <div class="step-name">
                    Review & submit
                </div>

            </div>


        </div>


        <div class="producer-profile">

            <div class="producer-avatar">@await Component.InvokeAsync("ProducerAvatar", new { part = "avatar" })</div>

            <div class="producer-profile-info">

                <div class="producer-name">@await Component.InvokeAsync("ProducerAvatar", new { part = "name" })</div>

                <div class="producer-role">
                    Community Producer
                </div>

            </div>

        </div>


    
        <!-- ===== PRODUCER ACCOUNT (photo, name, Account settings, Log out) ===== -->
        <style>
            .producer-account:not(.resk-account), .sidebar > .producer-profile { display: none !important; }
            .resk-account { position: relative; margin-top: auto; padding: 0 8px; }
            .resk-profile { width: 100%; display: flex; align-items: center; gap: 11px; padding: 12px 10px; border: none; border-radius: 11px; background: #142a4b; color: #ffffff; cursor: pointer; text-align: left; font-family: inherit; }
            .resk-profile:hover { background: #193456; }
            .resk-avatar { width: 34px; height: 34px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: #0bb6ca; color: #ffffff; font-size: 11px; font-weight: 800; }
            .resk-text { min-width: 0; flex: 1; }
            .resk-name { overflow: hidden; color: #ffffff; font-size: 13px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
            .resk-role { margin-top: 4px; color: #b5c0d1; font-size: 10px; }
            .resk-menu { position: absolute; left: 8px; right: 8px; bottom: calc(100% + 9px); z-index: 10; padding: 7px; border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; background: #142a4b; box-shadow: 0 18px 35px rgba(0,0,0,0.25); opacity: 0; visibility: hidden; transform: translateY(8px); transition: 0.2s; }
            .resk-account.open .resk-menu { opacity: 1; visibility: visible; transform: translateY(0); }
            .resk-menu-link, .resk-logout { width: 100%; display: block; padding: 10px 11px; border: none; border-radius: 7px; background: transparent; color: #d6deea; font-family: inherit; font-size: 12px; font-weight: 600; text-align: left; text-decoration: none; cursor: pointer; }
            .resk-menu-link:hover, .resk-logout:hover { background: rgba(255,255,255,0.06); color: #ffffff; }
            .resk-logout { color: #ff9e9e; }
            .resk-divider { height: 1px; margin: 5px 4px; background: rgba(255,255,255,0.08); }
        </style>

        <div class="resk-account" id="reskAccount">

            <div class="resk-menu">
                <a href="/Producer/Settings" class="resk-menu-link">Account settings</a>
                <div class="resk-divider"></div>
                <form method="post" action="/Producer/Logout" style="margin:0;">
                    <button type="submit" class="resk-logout" id="reskLogoutButton" data-step="3">Log out</button>
                </form>
            </div>

            <button type="button" class="resk-profile" id="reskProfileButton" aria-expanded="false">
                <div class="resk-avatar">@await Component.InvokeAsync("ProducerAvatar", new { part = "avatar" })</div>
                <div class="resk-text">
                    <div class="resk-name">@await Component.InvokeAsync("ProducerAvatar", new { part = "name" })</div>
                    <div class="resk-role">Community Producer</div>
                </div>
            </button>

        </div>

        <script>
            (function () {
                var account = document.getElementById("reskAccount");
                var button = document.getElementById("reskProfileButton");
                var logoutButton = document.getElementById("reskLogoutButton");

                button.addEventListener("click", function (event) {
                    event.stopPropagation();
                    var isOpen = account.classList.toggle("open");
                    button.setAttribute("aria-expanded", isOpen ? "true" : "false");
                });

                document.addEventListener("click", function (event) {
                    if (!account.contains(event.target)) {
                        account.classList.remove("open");
                        button.setAttribute("aria-expanded", "false");
                    }
                });

                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape") {
                        account.classList.remove("open");
                        button.setAttribute("aria-expanded", "false");
                    }
                });

                // Log out: save this page to Drafts first, then sign out.
                logoutButton.addEventListener("click", function (event) {
                    var forms = Array.prototype.filter.call(document.querySelectorAll("form"), function (f) {
                        var method = (f.getAttribute("method") || "").toLowerCase();
                        return !account.contains(f) && method === "post";
                    });

                    var form = forms[0];

                    // No proposal form on the page: just log out normally.
                    if (!form) { return; }

                    event.preventDefault();

                    function addHidden(name, value) {
                        var input = document.createElement("input");
                        input.type = "hidden";
                        input.name = name;
                        input.value = value;
                        form.appendChild(input);
                    }

                    addHidden("step", logoutButton.getAttribute("data-step"));
                    addHidden("logout", "true");

                    form.setAttribute("action", "/Producer/SaveDraft");
                    HTMLFormElement.prototype.submit.call(form);
                });
            })();
        </script>
</aside>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="main">


        <div class="page">


            <header class="page-header">

                <h1 class="page-title">
                    Production details
                </h1>

                <p class="page-description">
                    Tell Cape Town TV how your programme will be produced and delivered.
                </p>

            </header>


            <div class="progress-section">

                <div class="progress-info">

                    <span>
                        Step 3 of 5
                    </span>

                    <span>
                        60% complete
                    </span>

                </div>

                <div class="progress-track">

                    <div class="progress-bar">
                    </div>

                </div>

            </div>


            @if (TempData["StepMessage"] != null)
            {
                <div class="validation-summary">
                    @TempData["StepMessage"]
                </div>
            }


            <form asp-controller="Producer"
                  asp-action="ProductionDetails"
                  method="post">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <section class="form-card">


                    <h2 class="card-title">
                        Production information
                    </h2>

                    <p class="card-description">
                        Provide information about your production plan, team, equipment and budget.
                    </p>


                    <div class="form-grid">


                        <!-- NUMBER OF EPISODES -->

                        <div class="form-group">

                            <label asp-for="NumberOfEpisodes"
                                   class="form-label">

                                Number of episodes
                                <span class="required">*</span>

                            </label>

                            <input asp-for="NumberOfEpisodes"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="e.g. 12" />

                            <span asp-validation-for="NumberOfEpisodes"
                                  class="validation-message">
                            </span>

                        </div>


                        <!-- START DATE -->

                        <div class="form-group">

                            <label asp-for="ProposedStartDate"
                                   class="form-label">

                                Proposed start date
                                <span class="required">*</span>

                            </label>

                            <input asp-for="ProposedStartDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="ProposedStartDate"
                                  class="validation-message">
                            </span>

                        </div>


                        <!-- RECORDING LOCATION -->

                        <div class="form-group">

                            <label asp-for="RecordingLocation"
                                   class="form-label">

                                Recording location
                                <span class="required">*</span>

                            </label>

                            <input asp-for="RecordingLocation"
                                   class="form-control"
                                   placeholder="e.g. Cape Town, Western Cape" />

                            <span asp-validation-for="RecordingLocation"
                                  class="validation-message">
                            </span>

                        </div>


                        <!-- COMPANY -->

                        <div class="form-group">

                            <label asp-for="ProductionCompany"
                                   class="form-label">

                                Production company / organisation

                            </label>

                            <input asp-for="ProductionCompany"
                                   class="form-control"
                                   placeholder="Enter organisation name" />

                            <span asp-validation-for="ProductionCompany"
                                  class="validation-message">
                            </span>

                        </div>


                        <!-- PRODUCER DIRECTOR -->

                        <div class="form-group full">

                            <label asp-for="ProducerDirector"
                                   class="form-label">

                                Producer / director
                                <span class="required">*</span>

                            </label>

                            <input asp-for="ProducerDirector"
                                   class="form-control"
                                   placeholder="Enter producer or director name" />

                            <span asp-validation-for="ProducerDirector"
                                  class="validation-message">
                            </span>

                        </div>


                        <!-- CREW -->

                        <div class="form-group full">

                            <label asp-for="CrewContributors"
                                   class="form-label">

                                Crew / contributors
                                <span class="required">*</span>

                            </label>

                            <textarea asp-for="CrewContributors"
                                      class="form-control"
                                      placeholder="List the main crew members, presenters, contributors or production roles."></textarea>

                            <span class="field-help">
                                Include the key people involved in producing the programme.
                            </span>

                            <span asp-validation-for="CrewContributors"
                                  class="validation-message">
                            </span>

                        </div>


                        <!-- EQUIPMENT -->

                        <div class="form-group full">

                            <label asp-for="EquipmentFacilities"
                                   class="form-label">

                                Equipment / facilities
                                <span class="required">*</span>

                            </label>

                            <textarea asp-for="EquipmentFacilities"
                                      class="form-control"
                                      placeholder="Describe cameras, audio equipment, editing facilities, studio requirements or other resources."></textarea>

                            <span asp-validation-for="EquipmentFacilities"
                                  class="validation-message">
                            </span>

                        </div>


                        <!-- BUDGET -->

                        <div class="form-group">

                            <label asp-for="EstimatedBudget"
                                   class="form-label">

                                Estimated production budget
                                <span class="required">*</span>

                            </label>

                            <div class="currency-field">

                                <span class="currency-prefix">
                                    R
                                </span>

                                <input asp-for="EstimatedBudget"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="EstimatedBudget"
                                  class="validation-message">
                            </span>

                        </div>


                        <!-- FUNDING -->

                        <div class="form-group">

                            <label asp-for="FundingStatus"
                                   class="form-label">

                                Funding status
                                <span class="required">*</span>

                            </label>

                            <select asp-for="FundingStatus"
                                    class="form-control">

                                <option value="">
                                    Select funding status
                                </option>

                                <option value="Fully funded">
                                    Fully funded
                                </option>

                                <option value="Partially funded">
                                    Partially funded
                                </option>

                                <option value="Seeking funding">
                                    Seeking funding
                                </option>

                                <option value="Self-funded">
                                    Self-funded
                                </option>

                                <option value="No funding required">
                                    No funding required
                                </option>

                            </select>

                            <span asp-validation-for="FundingStatus"
                                  class="validation-message">
                            </span>

                        </div>


                    </div>


                </section>


                <!-- BUTTONS -->

                <div class="actions">


                    <a asp-controller="Producer"
                       asp-action="ProgrammeDetails"
                       class="back-button">

                        ← Back

                    </a>


