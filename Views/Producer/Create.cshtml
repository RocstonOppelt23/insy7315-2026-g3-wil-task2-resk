@model RESK.WIL.Models.ProducerDetailsViewModel

@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    Layout = null;

    ViewData["Title"] = "Producer Details";

    var currentUser =
        await UserManager.GetUserAsync(User);

    var producerUsername =
        currentUser?.Email
        ?? currentUser?.UserName
        ?? "Producer";

    var producerInitial =
        !string.IsNullOrWhiteSpace(producerUsername)
            ? producerUsername.Substring(0, 1).ToUpper()
            : "P";
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Producer Details - R.E.S.K
    </title>


    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            font-family: Inter, "Segoe UI", Arial, sans-serif;

            background: #f4f7fb;

            color: #14233e;
        }

        button,
        input,
        textarea,
        select,
        a {
            font-family: inherit;
        }


        /* =========================================================
           SIDEBAR
        ========================================================= */

        .sidebar {
            position: fixed;

            top: 0;
            left: 0;
            bottom: 0;

            width: 260px;

            display: flex;
            flex-direction: column;

            padding: 36px 20px 38px;

            background: #0c1a33;

            color: white;
        }


        /* =========================================================
           BRAND
        ========================================================= */

        .brand {
            display: flex;

            align-items: center;

            gap: 15px;

            padding-left: 13px;

            margin-bottom: 42px;
        }

        .brand-icon {
            width: 56px;
            height: 56px;

            display: flex;

            align-items: center;
            justify-content: center;

            border: 2px solid #00b9d0;

            border-radius: 17px;

            color: #00bfd7;

            font-size: 28px;

            font-weight: 800;
        }

        .brand-name {
            color: white;

            font-size: 24px;

            font-weight: 800;

            letter-spacing: 1.5px;
        }

        .brand-subtitle {
            margin-top: 5px;

            color: #d3dae7;

            font-size: 9px;
        }


        /* =========================================================
           STEPS
        ========================================================= */

        .steps-label {
            margin: 0 13px 13px;

            color: #72809a;

            font-size: 10px;

            font-weight: 800;
        }

        .steps {
            display: flex;

            flex-direction: column;

            gap: 7px;
        }

        .step {
            display: flex;

            align-items: center;

            gap: 12px;

            min-height: 47px;

            padding: 0 13px;

            border-radius: 10px;

            color: #8997ac;
        }

        .step.active {
            background: #142a4b;

            color: white;
        }

        .step-number {
            width: 27px;
            height: 27px;

            flex-shrink: 0;

            display: flex;

            align-items: center;
            justify-content: center;

            border: 1px solid #53627a;

            border-radius: 50%;

            color: #9ba8ba;

            font-size: 10px;

            font-weight: 800;
        }

        .step.active .step-number {
            border-color: #11b6ca;

            background: #11b6ca;

            color: white;
        }

        .step-title {
            font-size: 11px;

            font-weight: 700;
        }


        /* =========================================================
           SIDEBAR USER
        ========================================================= */

        .producer-profile {
            margin-top: auto;

            display: flex;

            align-items: center;

            gap: 11px;

            padding: 12px 10px;

            border-radius: 11px;

            background: #142a4b;
        }

        .producer-avatar {
            width: 34px;
            height: 34px;

            flex-shrink: 0;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background: #0bb6ca;

            color: white;

            font-size: 11px;

            font-weight: 800;
        }

        .producer-profile-content {
            min-width: 0;
        }

        .producer-name {
            overflow: hidden;

            color: white;

            font-size: 11px;

            font-weight: 700;

            white-space: nowrap;

            text-overflow: ellipsis;
        }

        .producer-role {
            margin-top: 4px;

            color: #b5c0d1;

            font-size: 9px;
        }


        /* =========================================================
           MAIN
        ========================================================= */

        .main {
            min-height: 100vh;

            margin-left: 260px;

            padding: 31px 52px 50px;
        }

        .page {
            width: 100%;

            max-width: 930px;

            margin: 0 auto;
        }


        /* =========================================================
           PAGE HEADER
        ========================================================= */

        .page-header {
            margin-bottom: 25px;
        }

        .back-link {
            display: inline-block;

            margin-bottom: 18px;

            color: #657791;

            font-size: 11px;

            font-weight: 700;

            text-decoration: none;
        }

        .back-link:hover {
            color: #00a9bd;
        }

        .page-title {
            color: #14233e;

            font-size: 30px;

            font-weight: 800;
        }

        .page-description {
            margin-top: 8px;

            color: #6c7d97;

            font-size: 13px;
        }


        /* =========================================================
           PROGRESS
        ========================================================= */

        .progress-wrapper {
            margin-bottom: 21px;
        }

        .progress-header {
            display: flex;

            justify-content: space-between;

            margin-bottom: 8px;

            color: #6a7b95;

            font-size: 10px;

            font-weight: 700;
        }

        .progress-track {
            width: 100%;

            height: 7px;

            border-radius: 999px;

            background: #dde4ed;

            overflow: hidden;
        }

        .progress-fill {
            width: 20%;

            height: 100%;

            border-radius: inherit;

            background: #11b6ca;
        }


        /* =========================================================
           CARD
        ========================================================= */

        .form-card {
            padding: 26px 30px;

            border: 1px solid #d9e1ec;

            border-radius: 13px;

            background: white;
        }

        .section-title {
            color: #14233e;

            font-size: 20px;

            font-weight: 800;
        }

        .section-description {
            margin-top: 7px;

            color: #6d7e98;

            font-size: 11px;
        }


        /* =========================================================
           FORM
        ========================================================= */

        .form-grid {
            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 19px 22px;

            margin-top: 27px;
        }

        .form-group {
            display: flex;

            flex-direction: column;

            gap: 7px;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-label {
            color: #263751;

            font-size: 11px;

            font-weight: 800;
        }

        .required {
            color: #e05656;
        }

        .form-control {
            width: 100%;

            min-height: 44px;

            padding: 10px 13px;

            border: 1px solid #d4dde8;

            border-radius: 8px;

            outline: none;

            background: white;

            color: #263751;

            font-size: 12px;

            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .form-control:focus {
            border-color: #12b5c9;

            box-shadow:
                0 0 0 3px rgba(18,181,201,0.10);
        }

        textarea.form-control {
            min-height: 90px;

            resize: vertical;
        }

        .readonly-control {
            background: #f6f8fb;

            color: #66768e;
        }

        .field-help {
            color: #8593a8;

            font-size: 9px;
        }

        .validation-message {
            color: #cf4b4b;

            font-size: 10px;

            font-weight: 600;
        }


        /* =========================================================
           CONTACT OPTIONS
        ========================================================= */

        .contact-options {
            display: flex;

            gap: 10px;

            flex-wrap: wrap;
        }

        .contact-option {
            position: relative;
        }

        .contact-option input {
            position: absolute;

            opacity: 0;

            pointer-events: none;
        }

        .contact-option label {
            min-width: 100px;

            display: flex;

            align-items: center;
            justify-content: center;

            padding: 10px 18px;

            border: 1px solid #d6dfe9;

            border-radius: 8px;

            background: white;

            color: #65758e;

            font-size: 11px;

            font-weight: 700;

            cursor: pointer;
        }

        .contact-option input:checked + label {
            border-color: #12b5c9;

            background: #eefbfc;

            color: #009daf;
        }


        /* =========================================================
           ROLE
        ========================================================= */

        .role-box {
            min-height: 44px;

            display: flex;

            align-items: center;

            padding: 0 13px;

            border: 1px solid #d4dde8;

            border-radius: 8px;

            background: #f6f8fb;

            color: #53647e;

            font-size: 12px;

            font-weight: 700;
        }


        /* =========================================================
           MESSAGE
        ========================================================= */

        .success-message {
            margin-bottom: 20px;

            padding: 12px 15px;

            border: 1px solid #8edee8;

            border-radius: 9px;

            background: #eefbfc;

            color: #087e8d;

            font-size: 11px;

            font-weight: 700;
        }


        /* =========================================================
           ACTIONS
        ========================================================= */

        .actions {
            display: flex;

            align-items: center;
            justify-content: space-between;

            gap: 15px;

            margin-top: 22px;
        }

        .cancel-button {
            min-width: 110px;

            display: inline-flex;

            align-items: center;
            justify-content: center;

            padding: 11px 20px;

            border: 1px solid #d5dee9;

            border-radius: 8px;

            background: white;

            color: #5e6f88;

            font-size: 11px;

            font-weight: 700;

            text-decoration: none;
        }

        .cancel-button:hover {
            border-color: #b9c6d6;

            color: #14233e;
        }

        .right-actions {
            display: flex;

            gap: 10px;
        }

        .draft-button {
            min-width: 120px;

            padding: 11px 18px;

            border: 1px solid #d5dee9;

            border-radius: 8px;

            background: white;

            color: #53647e;

            font-size: 11px;

            font-weight: 700;

            cursor: pointer;
        }

        .continue-button {
            min-width: 130px;

            padding: 11px 20px;

            border: 0;

            border-radius: 8px;

            background: #11b6ca;

            color: white;

            font-size: 11px;

            font-weight: 800;

            cursor: pointer;
        }

        .continue-button:hover {
            background: #0da7ba;
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 850px) {

            .sidebar {
                position: relative;

                width: 100%;
            }

            .main {
                margin-left: 0;

                padding: 25px 20px;
            }

            .producer-profile {
                margin-top: 30px;
            }

        }

        @@media (max-width: 600px) {

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .actions {
                flex-direction: column;
                align-items: stretch;
            }

            .right-actions {
                flex-direction: column;
            }

            .cancel-button,
            .draft-button,
            .continue-button {
                width: 100%;
            }

        }

    </style>

    <style id="reskWizardButtons">
        .resk-cancel { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1px solid #e1e7ef; border-radius: 8px; background: transparent; color: #61728d; font-size: 13px; font-weight: 800; text-decoration: none; transition: background 0.2s, border-color 0.2s, color 0.2s; }
        .resk-cancel:hover { border-color: #f0c2c5; background: #fff7f7; color: #b84048; }
        .resk-save-draft { min-height: 44px; padding: 0 22px; border: 1px solid #d3dce8; border-radius: 8px; background: #ffffff; color: #14233e; font-family: inherit; font-size: 13px; font-weight: 800; cursor: pointer; transition: border-color 0.2s, color 0.2s; }
        .resk-save-draft:hover { border-color: #12b8ce; color: #0a9fb2; }
    </style></head>


<body>


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="sidebar">


        <div class="brand">

            <div class="brand-icon">
                R
            </div>

            <div>

                <div class="brand-name">
                    R.E.S.K
                </div>

                <div class="brand-subtitle">
                    SOFTWARE STUDIO
                </div>

            </div>

        </div>


        <!-- =====================================================
             PROPOSAL STEPS
        ====================================================== -->

        <div class="steps-label">
            NEW PROPOSAL
        </div>


        <div class="steps">


            <div class="step active">

                <div class="step-number">
                    1
                </div>

                <div class="step-title">
                    Producer details
                </div>

            </div>


            <div class="step">

                <div class="step-number">
                    2
                </div>

                <div class="step-title">
                    Programme details
                </div>

            </div>


            <div class="step">

                <div class="step-number">
                    3
                </div>

                <div class="step-title">
                    Production details
                </div>

            </div>


            <div class="step">

                <div class="step-number">
                    4
                </div>

                <div class="step-title">
                    Attachments
                </div>

            </div>


            <div class="step">

                <div class="step-number">
                    5
                </div>

                <div class="step-title">
                    Review & submit
                </div>

            </div>


        </div>


        <!-- =====================================================
             LOGGED-IN PRODUCER
        ====================================================== -->

        <div class="producer-profile">


            <div class="producer-avatar">@await Component.InvokeAsync("ProducerAvatar", new { part = "avatar" })</div>


            <div class="producer-profile-content">


                <div class="producer-name">@await Component.InvokeAsync("ProducerAvatar", new { part = "name" })</div>


                <div class="producer-role">
                    Community Producer
                </div>


            </div>


        </div>


    
        <!-- ===== PRODUCER ACCOUNT (photo, name, Account settings, Log out) ===== -->
        <style>
            .producer-account:not(.resk-account), .sidebar > .producer-profile { display: none !important; }
            .resk-account { position: relative; margin-top: auto; padding: 0 8px; }
            .resk-profile { width: 100%; display: flex; align-items: center; gap: 11px; padding: 12px 10px; border: none; border-radius: 11px; background: #142a4b; color: #ffffff; cursor: pointer; text-align: left; font-family: inherit; }
            .resk-profile:hover { background: #193456; }
            .resk-avatar { width: 34px; height: 34px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: #0bb6ca; color: #ffffff; font-size: 11px; font-weight: 800; }
            .resk-text { min-width: 0; flex: 1; }
            .resk-name { overflow: hidden; color: #ffffff; font-size: 13px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
            .resk-role { margin-top: 4px; color: #b5c0d1; font-size: 10px; }
            .resk-menu { position: absolute; left: 8px; right: 8px; bottom: calc(100% + 9px); z-index: 10; padding: 7px; border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; background: #142a4b; box-shadow: 0 18px 35px rgba(0,0,0,0.25); opacity: 0; visibility: hidden; transform: translateY(8px); transition: 0.2s; }
            .resk-account.open .resk-menu { opacity: 1; visibility: visible; transform: translateY(0); }
            .resk-menu-link, .resk-logout { width: 100%; display: block; padding: 10px 11px; border: none; border-radius: 7px; background: transparent; color: #d6deea; font-family: inherit; font-size: 12px; font-weight: 600; text-align: left; text-decoration: none; cursor: pointer; }
            .resk-menu-link:hover, .resk-logout:hover { background: rgba(255,255,255,0.06); color: #ffffff; }
            .resk-logout { color: #ff9e9e; }
            .resk-divider { height: 1px; margin: 5px 4px; background: rgba(255,255,255,0.08); }
        </style>

        <div class="resk-account" id="reskAccount">

            <div class="resk-menu">
                <a href="/Producer/Settings" class="resk-menu-link">Account settings</a>
                <div class="resk-divider"></div>
                <form method="post" action="/Producer/Logout" style="margin:0;">
                    <button type="submit" class="resk-logout" id="reskLogoutButton" data-step="1">Log out</button>
                </form>
            </div>

            <button type="button" class="resk-profile" id="reskProfileButton" aria-expanded="false">
                <div class="resk-avatar">@await Component.InvokeAsync("ProducerAvatar", new { part = "avatar" })</div>
                <div class="resk-text">
                    <div class="resk-name">@await Component.InvokeAsync("ProducerAvatar", new { part = "name" })</div>
                    <div class="resk-role">Community Producer</div>
                </div>
            </button>

        </div>

        <script>
            (function () {
                var account = document.getElementById("reskAccount");
                var button = document.getElementById("reskProfileButton");
                var logoutButton = document.getElementById("reskLogoutButton");

                button.addEventListener("click", function (event) {
                    event.stopPropagation();
                    var isOpen = account.classList.toggle("open");
                    button.setAttribute("aria-expanded", isOpen ? "true" : "false");
                });

                document.addEventListener("click", function (event) {
                    if (!account.contains(event.target)) {
                        account.classList.remove("open");
                        button.setAttribute("aria-expanded", "false");
                    }
                });

                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape") {
                        account.classList.remove("open");
                        button.setAttribute("aria-expanded", "false");
                    }
                });

                // Log out: save this page to Drafts first, then sign out.
                logoutButton.addEventListener("click", function (event) {
                    var forms = Array.prototype.filter.call(document.querySelectorAll("form"), function (f) {
                        var method = (f.getAttribute("method") || "").toLowerCase();
                        return !account.contains(f) && method === "post";
                    });

                    var form = forms[0];

                    // No proposal form on the page: just log out normally.
                    if (!form) { return; }

                    event.preventDefault();

                    function addHidden(name, value) {
                        var input = document.createElement("input");
                        input.type = "hidden";
                        input.name = name;
                        input.value = value;
                        form.appendChild(input);
                    }

                    addHidden("step", logoutButton.getAttribute("data-step"));
                    addHidden("logout", "true");

                    form.setAttribute("action", "/Producer/SaveDraft");
                    HTMLFormElement.prototype.submit.call(form);
                });
            })();
        </script>
</aside>



    <!-- =========================================================
         MAIN
    ========================================================== -->

    <main class="main">


        <div class="page">


            <!-- =================================================
                 HEADER
            ================================================== -->

            <header class="page-header">


                <a asp-controller="Producer"
                   asp-action="Index"
                   class="back-link">

                    ← Back to dashboard

                </a>


                <h1 class="page-title">
                    New proposal
                </h1>


                <p class="page-description">
                    Complete each section to prepare your programme proposal for review.
                </p>


            </header>



            <!-- =================================================
                 PROGRESS
            ================================================== -->

            <div class="progress-wrapper">


                <div class="progress-header">

                    <span>
                        Step 1 of 5
                    </span>

                    <span>
                        20% complete
                    </span>

                </div>


                <div class="progress-track">

                    <div class="progress-fill"></div>

                </div>


            </div>



            @if (TempData["StepMessage"] != null)
            {
                <div class="success-message">
                    @TempData["StepMessage"]
                </div>
            }



            <!-- =================================================
                 PRODUCER DETAILS FORM
            ================================================== -->

            <form asp-controller="Producer"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <section class="form-card">


                    <h2 class="section-title">
                        Producer details
                    </h2>


                    <p class="section-description">
                        Tell us who is submitting this proposal and how we can contact you.
                    </p>



                    <div class="form-grid">


                        <!-- FIRST NAME -->

                        <div class="form-group">


                            <label asp-for="FirstName"
                                   class="form-label">

                                First name
                                <span class="required">*</span>

                            </label>


                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="Enter your first name" />


                            <span asp-validation-for="FirstName"
                                  class="validation-message">
                            </span>


                        </div>



                        <!-- LAST NAME -->

                        <div class="form-group">


                            <label asp-for="LastName"
                                   class="form-label">

                                Last name
                                <span class="required">*</span>

                            </label>


                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Enter your last name" />


                            <span asp-validation-for="LastName"
                                  class="validation-message">
                            </span>


                        </div>



                        <!-- EMAIL -->

                        <div class="form-group">


                            <label asp-for="Email"
                                   class="form-label">

                                Email address
                                <span class="required">*</span>

                            </label>


                            <input asp-for="Email"
                                   class="form-control readonly-control"
                                   readonly />


                            <span class="field-help">
                                Email is linked to your signed-in R.E.S.K account.
                            </span>


                            <span asp-validation-for="Email"
                                  class="validation-message">
                            </span>


                        </div>



                        <!-- MOBILE -->

                        <div class="form-group">


                            <label asp-for="MobileNumber"
                                   class="form-label">

                                Mobile number
                                <span class="required">*</span>

                            </label>


                            <input asp-for="MobileNumber"
                                   class="form-control"
                                   placeholder="+27 00 000 0000" />


                            <span asp-validation-for="MobileNumber"
                                  class="validation-message">
                            </span>


                        </div>



                        <!-- ROLE -->

                        <div class="form-group">


                            <label class="form-label">
                                Account role
                            </label>


                            <div class="role-box">
                                Community Producer
                            </div>


                        </div>



                        <!-- ORGANISATION -->

                        <div class="form-group">


                            <label asp-for="Organisation"
                                   class="form-label">

                                Organisation / production group

                            </label>


                            <input asp-for="Organisation"
                                   class="form-control"
                                   placeholder="Optional" />


                            <span asp-validation-for="Organisation"
                                  class="validation-message">
                            </span>


                        </div>



                        <!-- ADDRESS -->

                        <div class="form-group full">


                            <label asp-for="PhysicalAddress"
                                   class="form-label">

                                Physical address
                                <span class="required">*</span>

                            </label>


                            <textarea asp-for="PhysicalAddress"
                                      class="form-control"
                                      placeholder="Enter your physical address">
                            </textarea>


                            <span asp-validation-for="PhysicalAddress"
                                  class="validation-message">
                            </span>


                        </div>



                        <!-- CONTACT METHOD -->

                        <div class="form-group full">


                            <label class="form-label">

                                Preferred contact method
                                <span class="required">*</span>

                            </label>


                            <div class="contact-options">


                                <div class="contact-option">

                                    <input asp-for="PreferredContactMethod"
                                           type="radio"
                                           value="Email"
                                           id="contactEmail" />

                                    <label for="contactEmail">
                                        Email
                                    </label>

                                </div>


                                <div class="contact-option">

                                    <input asp-for="PreferredContactMethod"
                                           type="radio"
                                           value="Phone"
                                           id="contactPhone" />

                                    <label for="contactPhone">
                                        Phone
                                    </label>

                                </div>


                                <div class="contact-option">

                                    <input asp-for="PreferredContactMethod"
                                           type="radio"
                                           value="Either"
                                           id="contactEither" />

                                    <label for="contactEither">
                                        Either
                                    </label>

                                </div>


                            </div>


                            <span asp-validation-for="PreferredContactMethod"
                                  class="validation-message">
                            </span>


                        </div>


                    </div>


                </section>



                <!-- =================================================
                     ACTION BUTTONS
                ================================================== -->

                <div class="actions">


                    


                    <div class="right-actions">


                        <!--
                            We'll wire Save Draft to the real proposal
                            persistence once the proposal model/database
                            workflow is connected.
                        -->

                        


                        <div style="display:flex;align-items:center;gap:14px;margin-left:auto;flex-wrap:wrap;justify-content:flex-end;">
                        <a href="/Producer/CancelProposal" class="resk-cancel">Cancel</a>
                        <button type="button" class="resk-save-draft" onclick="var f=this.form;var s=document.createElement('input');s.type='hidden';s.name='step';s.value='1';f.appendChild(s);f.action='/Producer/SaveDraft';HTMLFormElement.prototype.submit.call(f);">Save draft</button>
                        <button type="submit"
                                class="continue-button">

                            Continue →

                        </button>
                    </div>


                    </div>


                </div>


            </form>


        </div>


    </main>


</body>

</html>