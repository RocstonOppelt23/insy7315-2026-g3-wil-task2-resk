@model RESK.WIL.Models.Proposal

@{
    Layout = null;
    ViewData["Title"] = "New Proposal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Create Proposal - R.E.S.K</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            background: #f4f7fb;
            color: #13223c;
        }

        .page {
            padding: 40px;
            max-width: 1000px;
            margin: auto;
        }

        .card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .card-header {
            background: #0c1a33;
            color: white;
            padding: 25px 35px;
        }

        .card-header h1 {
            font-size: 28px;
        }

        .card-header p {
            margin-top: 8px;
            color: #ced5e2;
        }

        .card-body {
            padding: 35px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 700;
            color: #14233e;
        }

        .form-control {
            width: 100%;
            padding: 14px;
            border: 1px solid #d7deea;
            border-radius: 10px;
            font-size: 14px;
        }

        textarea {
            resize: vertical;
            min-height: 140px;
        }

        .btn {
            border: none;
            border-radius: 10px;
            padding: 14px 22px;
            font-weight: 700;
            cursor: pointer;
        }

        .btn-primary {
            background: #0bb6ca;
            color: white;
        }

        .btn-primary:hover {
            background: #09a8bb;
        }

        .btn-secondary {
            background: #e9edf4;
            color: #13223c;
            text-decoration: none;
            display: inline-block;
        }

        .button-row {
            display: flex;
            gap: 12px;
            margin-top: 30px;
        }

        .validation-summary-errors {
            background: #ffe7e7;
            color: #cc3939;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

    </style>
</head>
<body>

    <div class="page">

        <div class="card">

            <div class="card-header">

                <h1>Submit New Programme Proposal</h1>

                <p>
                    Complete the proposal form and submit it for review.
                </p>

            </div>

            <div class="card-body">

                <form asp-controller="Producer"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All">
                    </div>

                    <div class="form-group">

                        <label asp-for="Title">
                            Programme Title
                        </label>

                        <input asp-for="Title"
                               class="form-control" />

                    </div>

                    <div class="form-group">

                        <label asp-for="Description">
                            Programme Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control">
                        </textarea>

                    </div>

                    <div class="form-group">

                        <label asp-for="Category">
                            Category
                        </label>

                        <select asp-for="Category"
                                class="form-control">

                            <option value="">
                                Select Category
                            </option>

                            <option value="Documentary">
                                Documentary
                            </option>

                            <option value="News">
                                News
                            </option>

                            <option value="Education">
                                Education
                            </option>

                            <option value="Entertainment">
                                Entertainment
                            </option>

                            <option value="Community">
                                Community
                            </option>

                        </select>

                    </div>

                    <div class="button-row">

                        <a asp-controller="Producer"
                           asp-action="Index"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            Submit Proposal

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>