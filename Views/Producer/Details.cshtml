@model RESK.WIL.Models.ProducerProposalDetailsViewModel

@{
    Layout = null;
    ViewData["Title"] = Model.Title;

    var producerName = Model.ProducerName;

    var initial =
        !string.IsNullOrWhiteSpace(producerName)
            ? producerName.Substring(0, 1).ToUpper()
            : "P";

    // The five workflow stages shown in the progress tracker.
    string[] stages = { "Draft", "Submitted", "In review", "Decision", "Complete" };
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@Model.Title - R.E.S.K</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            background: #f4f7fb;
            color: #13223c;
        }


        /* =========================================================
           PAGE TRANSITION
           Only the main content fades. The sidebar stays still,
           so moving between pages feels smooth.
        ========================================================= */

        .main {
            animation: pageFadeIn 0.4s ease-out both;
        }

        /* Added by the script when a link is clicked. */
        body.page-leaving .main {
            animation: pageFadeOut 0.18s ease-in both;
        }

        @@keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: none; }
        }

        @@keyframes pageFadeOut {
            from { opacity: 1; transform: none; }
            to { opacity: 0; transform: translateY(-4px); }
        }

        @@media (prefers-reduced-motion: reduce) {
            .main,
            body.page-leaving .main {
                animation: none;
            }
        }

        button,
        a {
            font-family: inherit;
        }


        /* =========================================================
           SIDEBAR
        ========================================================= */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 260px;
            display: flex;
            flex-direction: column;
            background: #0c1a33;
            color: white;
            padding: 36px 20px 38px;
            z-index: 100;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 15px;
            padding-left: 13px;
            margin-bottom: 42px;
        }

        .brand-icon {
            width: 56px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #00b9d0;
            border-radius: 17px;
            color: #00bfd7;
            font-size: 28px;
            font-weight: 700;
        }

        .brand-name {
            color: white;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }

        .brand-subtitle {
            margin-top: 5px;
            color: #d3dae7;
            font-size: 9px;
        }

        .nav-label {
            margin: 0 12px 8px;
            color: #72809a;
            font-size: 10px;
            font-weight: 800;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            min-height: 43px;
            padding: 0 32px;
            border-radius: 10px;
            color: #b9c2d1;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            transition: 0.2s;
        }

        .sidebar-link:hover {
            color: white;
            background: rgba(255,255,255,0.05);
            transform: translateX(2px);
        }

        .sidebar-link.active {
            background: #142a4b;
            color: white;
            font-weight: 700;
        }


        /* =========================================================
           PRODUCER ACCOUNT
        ========================================================= */

        .producer-account {
            position: relative;
            margin-top: auto;
            padding: 0 8px;
        }

        .producer-profile {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 12px 10px;
            border: none;
            border-radius: 11px;
            background: #142a4b;
            color: white;
            cursor: pointer;
            text-align: left;
        }

        .producer-profile:hover {
            background: #193456;
        }

        .producer-avatar {
            width: 34px;
            height: 34px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #0bb6ca;
            color: white;
            font-size: 11px;
            font-weight: 800;
        }

        .producer-profile-text {
            min-width: 0;
            flex: 1;
        }

        .producer-name {
            overflow: hidden;
            color: white;
            font-size: 13px;
            font-weight: 700;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .producer-role {
            margin-top: 4px;
            color: #b5c0d1;
            font-size: 10px;
        }

        .profile-menu {
            position: absolute;
            left: 8px;
            right: 8px;
            bottom: calc(100% + 9px);
            padding: 7px;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            background: #142a4b;
            box-shadow: 0 18px 35px rgba(0,0,0,0.25);
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: 0.2s;
        }

        .producer-account.open .profile-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-menu-link,
        .logout-button {
            width: 100%;
            display: block;
            padding: 10px 11px;
            border: none;
            border-radius: 7px;
            background: transparent;
            color: #d6deea;
            font-size: 12px;
            font-weight: 600;
            text-align: left;
            text-decoration: none;
            cursor: pointer;
        }

        .profile-menu-link:hover,
        .logout-button:hover {
            background: rgba(255,255,255,0.06);
            color: white;
        }

        .logout-button {
            color: #ff9e9e;
        }

        .menu-divider {
            height: 1px;
            margin: 5px 4px;
            background: rgba(255,255,255,0.08);
        }


        /* =========================================================
           MAIN
        ========================================================= */

        .main {
            min-height: 100vh;
            margin-left: 260px;
            padding: 28px 52px 38px;
        }

        .page {
            width: 100%;
            max-width: 1070px;
            margin: 0 auto;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 16px;
            color: #00a9bd;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        .page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 22px;
        }

        .page-header h1 {
            color: #14233e;
            font-size: 31px;
            line-height: 1.2;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .page-header p {
            margin-top: 8px;
            color: #697a96;
            font-size: 14px;
        }


        /* =========================================================
           STATUS PILL
        ========================================================= */

        .status-pill {
            display: inline-block;
            flex-shrink: 0;
            margin-top: 6px;
            padding: 7px 16px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
            white-space: nowrap;
        }

        .status-draft {
            background: #eef2f7;
            color: #5b6b85;
        }

        .status-review {
            background: #fdf1d6;
            color: #c77c00;
        }

        .status-approved {
            background: #e3f5ec;
            color: #1f8a5c;
        }

        .status-changes,
        .status-rejected {
            background: #fde7e8;
            color: #c9444d;
        }


        /* =========================================================
           CARDS
        ========================================================= */

        .card {
            margin-bottom: 18px;
            padding: 22px 24px;
            border: 1px solid #d9e1ec;
            border-radius: 13px;
            background: white;
        }

        .card-title {
            color: #14233e;
            font-size: 16px;
            font-weight: 800;
        }

        .card-subtitle {
            margin-top: 5px;
            color: #6d7e99;
            font-size: 11px;
        }


        /* SUMMARY STRIP */

        .summary {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 15px;
            margin-bottom: 18px;
        }

        .summary-item {
            padding: 18px 20px;
            border: 1px solid #d9e1ec;
            border-radius: 13px;
            background: white;
        }

        .summary-label {
            color: #61728d;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .summary-value {
            margin-top: 9px;
            color: #12213b;
            font-size: 15px;
            font-weight: 800;
            overflow-wrap: anywhere;
        }


        /* WORKFLOW TRACKER */

        .stepper {
            display: flex;
            margin-top: 22px;
            list-style: none;
        }

        .step {
            position: relative;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 9px;
            text-align: center;
        }

        /* Line joining each step to the previous one */
        .step + .step::before {
            content: "";
            position: absolute;
            top: 14px;
            right: 50%;
            width: 100%;
            height: 3px;
            background: #e2e8f0;
        }

        .step.done + .step::before,
        .step.done + .step.done::before {
            background: #12b8ce;
        }

        .step-dot {
            position: relative;
            z-index: 1;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #d3ddea;
            border-radius: 50%;
            background: white;
            color: #8190a6;
            font-size: 11px;
            font-weight: 800;
        }

        .step.done .step-dot {
            border-color: #12b8ce;
            background: #12b8ce;
            color: white;
        }

        .step.current .step-dot {
            border-color: #12b8ce;
            color: #0a9fb2;
            box-shadow: 0 0 0 5px rgba(18,184,206,0.14);
        }

        .step-label {
            color: #6d7e99;
            font-size: 11px;
            font-weight: 700;
        }

        .step.done .step-label,
        .step.current .step-label {
            color: #14233e;
        }


        /* ANSWERS + SIDE COLUMN */

        .details-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.9fr) minmax(280px, 1fr);
            gap: 18px;
            align-items: start;
        }

        .field-list {
            margin-top: 16px;
        }

        .field {
            display: grid;
            grid-template-columns: 190px minmax(0, 1fr);
            gap: 16px;
            padding: 12px 0;
            border-top: 1px solid #edf1f6;
        }

        .field:first-child {
            border-top: none;
        }

        .field dt {
            color: #61728d;
            font-size: 12px;
            font-weight: 700;
        }

        .field dd {
            color: #14233e;
            font-size: 13px;
            line-height: 1.6;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }


        /* ATTACHMENTS */

        .file-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 16px;
        }

        .file {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 13px;
            border: 1px solid #dde4ee;
            border-radius: 10px;
            background: #f7f9fc;
        }

        .file-badge {
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: #eefbfc;
            color: #0a9fb2;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .file-info {
            flex: 1;
            min-width: 0;
        }

        .file-label {
            color: #6d7e99;
            font-size: 10px;
            font-weight: 700;
        }

        .file-name {
            margin-top: 3px;
            color: #14233e;
            font-size: 12px;
            font-weight: 700;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .file-download {
            flex-shrink: 0;
            color: #00a9bd;
            font-size: 11px;
            font-weight: 800;
            text-decoration: none;
        }

        .file-download:hover {
            text-decoration: underline;
        }

        .muted {
            margin-top: 14px;
            color: #8493aa;
            font-size: 12px;
        }

        .showreel {
            display: inline-block;
            margin-top: 12px;
            color: #00a9bd;
            font-size: 12px;
            font-weight: 700;
            overflow-wrap: anywhere;
            text-decoration: none;
        }

        .showreel:hover {
            text-decoration: underline;
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 1150px) {

            .summary {
                grid-template-columns: repeat(2, 1fr);
            }

            .details-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 800px) {

            .sidebar {
                position: relative;
                width: 100%;
            }

            .main {
                margin-left: 0;
                padding: 25px 20px;
            }

            .producer-account {
                margin-top: 30px;
            }

            .page-header {
                flex-direction: column;
            }

            .field {
                grid-template-columns: 1fr;
                gap: 4px;
            }
        }

        @@media (max-width: 560px) {

            .summary {
                grid-template-columns: 1fr;
            }

            .page-header h1 {
                font-size: 25px;
            }

            .step-label {
                font-size: 9px;
            }
        }

    </style>

</head>


<body>


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-icon">R</div>

            <div>
                <div class="brand-name">R.E.S.K</div>
                <div class="brand-subtitle">SOFTWARE STUDIO</div>
            </div>

        </div>


        <div class="nav-label">
            PROPOSAL WORKSPACE
        </div>


        <nav class="sidebar-nav">

            <a asp-controller="Producer"
               asp-action="Index"
               class="sidebar-link">
                Dashboard
            </a>

            <a asp-controller="Producer"
               asp-action="Guidelines"
               class="sidebar-link">
                New proposal
            </a>

            <a asp-controller="Producer"
               asp-action="MyProposals"
               class="sidebar-link active"
               aria-current="page">
                My proposals
            </a>

            <a asp-controller="Producer"
               asp-action="Drafts"
               class="sidebar-link">
                Drafts
            </a>

            <a asp-controller="Producer"
               asp-action="Guidelines"
               class="sidebar-link">
                Guidelines
            </a>

            <a href="#"
               class="sidebar-link">
                Settings
            </a>

        </nav>


        <div class="producer-account"
             id="producerAccount">

            <div class="profile-menu">

                <a href="#"
                   class="profile-menu-link">
                    Account settings
                </a>

                <div class="menu-divider"></div>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="logout-button">
                        Log out
                    </button>

                </form>

            </div>

            <button type="button"
                    class="producer-profile"
                    id="producerProfileButton"
                    aria-expanded="false">

                <div class="producer-avatar">
                    @initial
                </div>

                <div class="producer-profile-text">

                    <div class="producer-name"
                         title="@producerName">
                        @producerName
                    </div>

                    <div class="producer-role">
                        Community Producer
                    </div>

                </div>

            </button>

        </div>

    </aside>



    <!-- =========================================================
         MAIN
    ========================================================== -->

    <main class="main">

        <div class="page">


            <a asp-controller="Producer"
               asp-action="MyProposals"
               class="back-link">
                ← Back to my proposals
            </a>


            <!-- HEADER -->

            <header class="page-header">

                <div>

                    <h1>@Model.Title</h1>

                    @if (!string.IsNullOrWhiteSpace(Model.MetaLine))
                    {
                        <p>@Model.MetaLine</p>
                    }

                </div>

                <span class="status-pill @Model.StatusCss">
                    @Model.StatusLabel
                </span>

            </header>


            <!-- SUMMARY -->

            <section class="summary"
                     aria-label="Proposal summary">

                <div class="summary-item">
                    <div class="summary-label">Reference</div>
                    <div class="summary-value">@Model.Reference</div>
                </div>

                <div class="summary-item">
                    <div class="summary-label">Submitted</div>
                    <div class="summary-value">@Model.SubmittedText</div>
                </div>

                <div class="summary-item">
                    <div class="summary-label">Last updated</div>
                    <div class="summary-value">@Model.UpdatedText</div>
                </div>

                <div class="summary-item">
                    <div class="summary-label">Category</div>
                    <div class="summary-value">@Model.Category</div>
                </div>

            </section>


            <!-- WORKFLOW -->

            <section class="card">

                <h2 class="card-title">Workflow progress</h2>

                <p class="card-subtitle">
                    Stage @Model.WorkflowStage of @stages.Length
                </p>

                <ol class="stepper">

                    @for (int i = 1; i <= stages.Length; i++)
                    {
                        var state =
                            Model.WorkflowStage >= stages.Length || i < Model.WorkflowStage
                                ? "done"
                                : i == Model.WorkflowStage
                                    ? "current"
                                    : "todo";

                        <li class="step @state"
                            aria-current="@(state == "current" ? "step" : null)">

                            <span class="step-dot">
                                @(state == "done" ? "✓" : i.ToString())
                            </span>

                            <span class="step-label">
                                @(stages[i - 1])
                            </span>

                        </li>
                    }

                </ol>

            </section>


            <!-- ANSWERS + FILES -->

            <div class="details-grid">


                <div>

                    @if (Model.Sections.Count == 0)
                    {
                        <section class="card">
                            <h2 class="card-title">Proposal details</h2>
                            <p class="muted">No details were saved with this proposal.</p>
                        </section>
                    }

                    @foreach (var detailSection in Model.Sections)
                    {
                        <section class="card">

                            <h2 class="card-title">@detailSection.Title</h2>

                            <dl class="field-list">

                                @foreach (var field in detailSection.Fields)
                                {
                                    <div class="field">
                                        <dt>@field.Label</dt>
                                        <dd>@field.Value</dd>
                                    </div>
                                }

                            </dl>

                        </section>
                    }

                </div>


                <aside>

                    <section class="card">

                        <h2 class="card-title">Attachments</h2>

                        <p class="card-subtitle">
                            Files you uploaded with this proposal.
                        </p>

                        @if (Model.Attachments.Count == 0)
                        {
                            <p class="muted">No files were uploaded.</p>
                        }
                        else
                        {
                            <div class="file-list">

                                @foreach (var file in Model.Attachments)
                                {
                                    var extension =
                                        System.IO.Path.GetExtension(file.FileName)
                                            .TrimStart('.');

                                    <div class="file">

                                        <div class="file-badge"
                                             aria-hidden="true">
                                            @(string.IsNullOrEmpty(extension) ? "FILE" : extension)
                                        </div>

                                        <div class="file-info">

                                            <div class="file-label">
                                                @file.Label
                                            </div>

                                            <div class="file-name"
                                                 title="@file.FileName">
                                                @file.FileName
                                            </div>

                                        </div>

                                        <!-- "download" stops the page fading out,
                                             because the browser stays on this page. -->
                                        <a asp-controller="Producer"
                                           asp-action="Attachment"
                                           asp-route-id="@Model.Id"
                                           asp-route-file="@file.Key"
                                           class="file-download"
                                           download>
                                            Download
                                        </a>

                                    </div>
                                }

                            </div>
                        }

                    </section>


                    <section class="card">

                        <h2 class="card-title">Pilot / showreel</h2>

                        @if (Model.ShowreelUrl != null)
                        {
                            <a href="@Model.ShowreelUrl"
                               class="showreel"
                               target="_blank"
                               rel="noopener noreferrer">
                                @Model.ShowreelUrl
                            </a>
                        }
                        else
                        {
                            <p class="muted">No showreel link was added.</p>
                        }

                    </section>

                </aside>

            </div>

        </div>

    </main>



    <!-- =========================================================
         SCRIPTS
    ========================================================== -->

    <script>

        (function () {

            // -----------------------------------------------------
            // PAGE FADE OUT when following a link to another page
            // -----------------------------------------------------

            const reduceMotion =
                window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            document.addEventListener("click", function (event) {

                const link = event.target.closest("a[href]");

                if (!link || reduceMotion) {
                    return;
                }

                const href = link.getAttribute("href");

                if (!href ||
                    href.startsWith("#") ||
                    link.target === "_blank" ||
                    link.hasAttribute("download") ||
                    link.origin !== window.location.origin ||
                    event.button !== 0 ||
                    event.metaKey || event.ctrlKey ||
                    event.shiftKey || event.altKey) {
                    return;
                }

                event.preventDefault();

                document.body.classList.add("page-leaving");

                setTimeout(function () {
                    window.location.href = link.href;
                }, 170);
            });

            window.addEventListener("pageshow", function () {
                document.body.classList.remove("page-leaving");
            });


            // -----------------------------------------------------
            // PROFILE MENU
            // -----------------------------------------------------

            const producerAccount =
                document.getElementById("producerAccount");

            const producerProfileButton =
                document.getElementById("producerProfileButton");

            producerProfileButton.addEventListener("click", function (event) {

                event.stopPropagation();

                const isOpen =
                    producerAccount.classList.toggle("open");

                producerProfileButton.setAttribute(
                    "aria-expanded",
                    isOpen ? "true" : "false");
            });

            document.addEventListener("click", function (event) {

                if (!producerAccount.contains(event.target)) {
                    producerAccount.classList.remove("open");
                    producerProfileButton.setAttribute("aria-expanded", "false");
                }
            });

            document.addEventListener("keydown", function (event) {

                if (event.key === "Escape") {
                    producerAccount.classList.remove("open");
                    producerProfileButton.setAttribute("aria-expanded", "false");
                }
            });

        })();

    </script>


</body>

</html>