@model RESK.WIL.Models.ProducerDraftsViewModel

@{
    Layout = null;
    ViewData["Title"] = "Drafts";

    var producerName = Model.ProducerName;

    var initial =
        !string.IsNullOrWhiteSpace(producerName)
            ? producerName.Substring(0, 1).ToUpper()
            : "P";

    var hasDrafts = Model.TotalDrafts > 0;

    // Avatar colours cycle through these three.
    string[] avatarColours = { "avatar-teal", "avatar-navy", "avatar-slate" };
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Drafts - R.E.S.K</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            background: #f4f7fb;
            color: #13223c;
            opacity: 0;
            animation: pageFadeIn 0.45s ease forwards;
        }

        /* Added by the script when leaving the page. */
        body.page-leaving {
            animation: pageFadeOut 0.2s ease forwards;
        }

        @@keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: none; }
        }

        @@keyframes pageFadeOut {
            from { opacity: 1; }
            to { opacity: 0; }
        }

        @@media (prefers-reduced-motion: reduce) {
            body,
            body.page-leaving {
                animation: none;
                opacity: 1;
            }
        }

        button,
        input,
        select,
        a {
            font-family: inherit;
        }


        /* =========================================================
           SIDEBAR
        ========================================================= */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 260px;
            display: flex;
            flex-direction: column;
            background: #0c1a33;
            color: white;
            padding: 36px 20px 38px;
            z-index: 100;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 15px;
            padding-left: 13px;
            margin-bottom: 42px;
        }

        .brand-icon {
            width: 56px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #00b9d0;
            border-radius: 17px;
            color: #00bfd7;
            font-size: 28px;
            font-weight: 700;
        }

        .brand-name {
            color: white;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }

        .brand-subtitle {
            margin-top: 5px;
            color: #d3dae7;
            font-size: 9px;
        }

        .nav-label {
            margin: 0 12px 8px;
            color: #72809a;
            font-size: 10px;
            font-weight: 800;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            min-height: 43px;
            padding: 0 32px;
            border-radius: 10px;
            color: #b9c2d1;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            transition: 0.2s;
        }

        .sidebar-link:hover {
            color: white;
            background: rgba(255,255,255,0.05);
            transform: translateX(2px);
        }

        .sidebar-link.active {
            background: #142a4b;
            color: white;
            font-weight: 700;
        }


        /* =========================================================
           PRODUCER ACCOUNT
        ========================================================= */

        .producer-account {
            position: relative;
            margin-top: auto;
            padding: 0 8px;
        }

        .producer-profile {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 12px 10px;
            border: none;
            border-radius: 11px;
            background: #142a4b;
            color: white;
            cursor: pointer;
            text-align: left;
        }

        .producer-profile:hover {
            background: #193456;
        }

        .producer-avatar {
            width: 34px;
            height: 34px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #0bb6ca;
            color: white;
            font-size: 11px;
            font-weight: 800;
        }

        .producer-profile-text {
            min-width: 0;
            flex: 1;
        }

        .producer-name {
            overflow: hidden;
            color: white;
            font-size: 13px;
            font-weight: 700;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .producer-role {
            margin-top: 4px;
            color: #b5c0d1;
            font-size: 10px;
        }

        .profile-menu {
            position: absolute;
            left: 8px;
            right: 8px;
            bottom: calc(100% + 9px);
            padding: 7px;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 10px;
            background: #142a4b;
            box-shadow: 0 18px 35px rgba(0,0,0,0.25);
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: 0.2s;
        }

        .producer-account.open .profile-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-menu-link,
        .logout-button {
            width: 100%;
            display: block;
            padding: 10px 11px;
            border: none;
            border-radius: 7px;
            background: transparent;
            color: #d6deea;
            font-size: 12px;
            font-weight: 600;
            text-align: left;
            text-decoration: none;
            cursor: pointer;
        }

        .profile-menu-link:hover,
        .logout-button:hover {
            background: rgba(255,255,255,0.06);
            color: white;
        }

        .logout-button {
            color: #ff9e9e;
        }

        .menu-divider {
            height: 1px;
            margin: 5px 4px;
            background: rgba(255,255,255,0.08);
        }


        /* =========================================================
           MAIN
        ========================================================= */

        .main {
            min-height: 100vh;
            margin-left: 260px;
            padding: 28px 52px 38px;
        }

        .page {
            width: 100%;
            max-width: 1070px;
            margin: 0 auto;
        }

        .page-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
        }

        .page-header h1 {
            color: #14233e;
            font-size: 31px;
            line-height: 1.2;
            font-weight: 800;
        }

        .page-header p {
            margin-top: 8px;
            color: #697a96;
            font-size: 14px;
        }

        .primary-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 43px;
            padding: 0 24px;
            border: none;
            border-radius: 8px;
            background: #12b8ce;
            color: white;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
            cursor: pointer;
            transition: background 0.2s;
        }

        .primary-button:hover {
            background: #0faabd;
        }


        /* =========================================================
           MESSAGE
        ========================================================= */

        .notice {
            margin-bottom: 18px;
            padding: 12px 16px;
            border: 1px solid #8ee0e9;
            border-radius: 10px;
            background: #eefbfc;
            color: #0f6f7c;
            font-size: 12px;
            font-weight: 600;
        }


        /* =========================================================
           STATS
        ========================================================= */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 15px;
            margin-bottom: 21px;
        }

        .stat-card {
            min-height: 102px;
            padding: 20px;
            border: 1px solid #d9e1ec;
            border-radius: 13px;
            background: white;
        }

        .stat-title {
            margin-bottom: 10px;
            color: #61728d;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .stat-number {
            color: #12213b;
            font-size: 33px;
            line-height: 1;
            font-weight: 800;
        }

        .stat-value {
            color: #12213b;
            font-size: 19px;
            font-weight: 800;
        }

        .stat-value.enabled {
            color: #209766;
        }

        .stat-note {
            margin-top: 6px;
            color: #687995;
            font-size: 11px;
        }


        /* =========================================================
           PANELS
        ========================================================= */

        .panel {
            margin-bottom: 21px;
            border: 1px solid #d9e1ec;
            border-radius: 13px;
            background: white;
        }

        .filters {
            display: flex;
            align-items: flex-end;
            gap: 20px;
            padding: 20px 23px;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .filter-group.search {
            flex: 0 1 360px;
        }

        .filter-group.sort {
            flex: 0 0 210px;
        }

        .filter-label {
            color: #61728d;
            font-size: 11px;
            font-weight: 800;
        }

        .filter-input {
            width: 100%;
            height: 39px;
            padding: 0 13px;
            border: 1px solid #cfdae8;
            border-radius: 8px;
            outline: none;
            background: white;
            color: #14233e;
            font-size: 12px;
        }

        .filter-input:focus {
            border-color: #12b8ce;
            box-shadow: 0 0 0 3px rgba(18,184,206,0.10);
        }

        .drafts-panel {
            padding: 24px 23px 20px;
        }

        .panel-title {
            color: #14233e;
            font-size: 17px;
            font-weight: 800;
        }

        .panel-subtitle {
            margin-top: 6px;
            color: #6d7e99;
            font-size: 12px;
        }


        /* =========================================================
           DRAFT CARDS
        ========================================================= */

        .draft-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-top: 22px;
        }

        .draft-card {
            display: flex;
            align-items: center;
            gap: 18px;
            padding: 20px 18px;
            border: 1px solid #dde4ee;
            border-radius: 12px;
            background: #f7f9fc;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .draft-card:hover {
            border-color: #c7d4e4;
            box-shadow: 0 6px 18px rgba(20,35,62,0.05);
        }

        .draft-card[hidden] {
            display: none;
        }

        .draft-avatar {
            width: 40px;
            height: 40px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: white;
            font-size: 12px;
            font-weight: 800;
        }

        .avatar-teal {
            background: #12b8ce;
        }

        .avatar-navy {
            background: #1c3559;
        }

        .avatar-slate {
            background: #5b6b85;
        }

        .draft-body {
            flex: 1;
            min-width: 0;
        }

        .draft-title {
            color: #14233e;
            font-size: 16px;
            font-weight: 800;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .draft-meta {
            margin-top: 6px;
            color: #6d7e99;
            font-size: 12px;
        }

        .draft-progress {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-top: 12px;
            max-width: 430px;
        }

        .progress-label {
            color: #14233e;
            font-size: 11px;
            font-weight: 800;
        }

        .progress-track {
            flex: 1;
            height: 7px;
            overflow: hidden;
            border-radius: 20px;
            background: #e2e8f0;
        }

        .progress-bar {
            height: 100%;
            border-radius: 20px;
            background: #12b8ce;
        }

        .progress-value {
            width: 32px;
            color: #6d7e99;
            font-size: 11px;
        }

        .draft-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .continue-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 39px;
            padding: 0 17px;
            border: 1px solid #d3ddea;
            border-radius: 8px;
            background: white;
            color: #14233e;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
            transition: 0.2s;
        }

        .continue-button:hover {
            border-color: #12b8ce;
        }

        .continue-button.primary {
            border-color: #12b8ce;
            background: #12b8ce;
            color: white;
        }

        .continue-button.primary:hover {
            background: #0faabd;
        }

        .delete-link {
            padding: 8px 10px;
            border: none;
            border-radius: 7px;
            background: transparent;
            color: #d64d58;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
        }

        .delete-link:hover {
            background: #fdeeee;
        }


        /* ⋯ menu */

        .more-menu {
            position: relative;
        }

        .more-button {
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 7px;
            background: transparent;
            color: #52637d;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 1px;
            cursor: pointer;
        }

        .more-button:hover,
        .more-menu.open .more-button {
            background: #e9eef5;
        }

        .more-list {
            position: absolute;
            right: 0;
            top: calc(100% + 6px);
            min-width: 170px;
            padding: 6px;
            border: 1px solid #d9e1ec;
            border-radius: 10px;
            background: white;
            box-shadow: 0 14px 30px rgba(20,35,62,0.12);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-4px);
            transition: 0.15s;
            z-index: 20;
        }

        .more-menu.open .more-list {
            opacity: 1;
            visibility: visible;
            transform: none;
        }

        .more-item {
            width: 100%;
            display: block;
            padding: 9px 11px;
            border: none;
            border-radius: 7px;
            background: transparent;
            color: #14233e;
            font-size: 12px;
            font-weight: 600;
            text-align: left;
            text-decoration: none;
            cursor: pointer;
        }

        .more-item:hover {
            background: #f2f5f9;
        }

        .more-item.danger {
            color: #d64d58;
        }

        .no-results {
            padding: 30px 10px;
            color: #8493aa;
            font-size: 12px;
            text-align: center;
        }

        .no-results[hidden] {
            display: none;
        }

        .panel-footnote {
            margin-top: 20px;
            color: #6d7e99;
            font-size: 11px;
        }


        /* =========================================================
           EMPTY STATE
        ========================================================= */

        .empty-panel {
            min-height: 560px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            text-align: center;
        }

        .empty-circle {
            width: 104px;
            height: 104px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #eefbfc;
            color: #12b8ce;
            font-size: 34px;
            font-weight: 800;
        }

        .empty-title {
            margin-top: 22px;
            color: #14233e;
            font-size: 24px;
            font-weight: 800;
        }

        .empty-text {
            margin-top: 14px;
            margin-bottom: 30px;
            color: #6d7e99;
            font-size: 14px;
        }


        /* =========================================================
           DELETE MODAL
        ========================================================= */

        .modal-backdrop {
            position: fixed;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(12,26,51,0.25);
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s, visibility 0.2s;
            z-index: 200;
        }

        .modal-backdrop.open {
            opacity: 1;
            visibility: visible;
        }

        .modal {
            width: 100%;
            max-width: 620px;
            padding: 34px 30px 40px;
            border: 1px solid #d9e1ec;
            border-radius: 14px;
            background: white;
            box-shadow: 0 30px 70px rgba(12,26,51,0.18);
            text-align: center;
            transform: translateY(10px) scale(0.98);
            transition: transform 0.2s;
        }

        .modal-backdrop.open .modal {
            transform: none;
        }

        .modal-icon {
            width: 56px;
            height: 56px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #c9525a;
            color: white;
            font-size: 22px;
            font-weight: 800;
        }

        .modal-title {
            margin-top: 18px;
            color: #14233e;
            font-size: 22px;
            font-weight: 800;
        }

        .modal-text {
            margin-top: 18px;
            color: #52637d;
            font-size: 13px;
            line-height: 1.6;
        }

        .modal-actions {
            display: flex;
            justify-content: center;
            gap: 13px;
            margin-top: 64px;
        }

        .modal-button {
            min-width: 141px;
            min-height: 43px;
            padding: 0 20px;
            border: 1px solid #d3ddea;
            border-radius: 8px;
            background: white;
            color: #14233e;
            font-size: 13px;
            font-weight: 800;
            cursor: pointer;
            transition: 0.2s;
        }

        .modal-button:hover {
            border-color: #aebcd0;
        }

        .modal-button.danger {
            min-width: 171px;
            color: #c9444d;
        }

        .modal-button.danger:hover {
            border-color: #c9444d;
            background: #fff6f6;
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 1150px) {

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .draft-card {
                flex-wrap: wrap;
            }

            .draft-actions {
                width: 100%;
                padding-left: 58px;
            }
        }

        @@media (max-width: 800px) {

            .sidebar {
                position: relative;
                width: 100%;
            }

            .main {
                margin-left: 0;
                padding: 25px 20px;
            }

            .producer-account {
                margin-top: 30px;
            }

            .page-header,
            .filters {
                flex-direction: column;
                align-items: stretch;
            }

            .filter-group.search,
            .filter-group.sort {
                flex: 1 1 auto;
            }
        }

        @@media (max-width: 560px) {

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .page-header h1 {
                font-size: 25px;
            }

            .draft-actions {
                padding-left: 0;
                flex-wrap: wrap;
            }

            .modal-actions {
                flex-direction: column;
                margin-top: 34px;
            }
        }

    </style>

    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=resk2" />
</head>


<body>


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-icon">R</div>

            <div>
                <div class="brand-name">R.E.S.K</div>
                <div class="brand-subtitle">SOFTWARE STUDIO</div>
            </div>

        </div>


        <div class="nav-label">
            PROPOSAL WORKSPACE
        </div>


        <nav class="sidebar-nav">

            <a asp-controller="Producer"
               asp-action="Index"
               class="sidebar-link">
                Dashboard
            </a>

            <a asp-controller="Producer"
               asp-action="Guidelines"
               class="sidebar-link">
                New proposal
            </a>

            <a asp-controller="Producer"
               asp-action="MyProposals"
               class="sidebar-link">
                My proposals
            </a>

            <a asp-controller="Producer"
               asp-action="Drafts"
               class="sidebar-link active"
               aria-current="page">
                Drafts
            </a>

            <a asp-controller="Producer"
               asp-action="Guidelines"
               class="sidebar-link">
                Guidelines
            </a>

            <a href="/Producer/Settings"
               class="sidebar-link">
                Settings
            </a>

        </nav>


        <div class="producer-account"
             id="producerAccount">

            <div class="profile-menu">

                <a href="/Producer/Settings"
                   class="profile-menu-link">
                    Account settings
                </a>

                <div class="menu-divider"></div>

                <form asp-controller="ProducerAccount"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="logout-button">
                        Log out
                    </button>

                </form>

            </div>

            <button type="button"
                    class="producer-profile"
                    id="producerProfileButton"
                    aria-expanded="false">

                <div class="producer-avatar">@await Component.InvokeAsync("ProducerAvatar", new { part = "avatar" })</div>

                <div class="producer-profile-text">

                    <div class="producer-name">@await Component.InvokeAsync("ProducerAvatar", new { part = "name" })</div>

                    <div class="producer-role">
                        Community Producer
                    </div>

                </div>

            </button>

        </div>

    </aside>



    <!-- =========================================================
         MAIN
    ========================================================== -->

    <main class="main">

        <div class="page">


            @if (!hasDrafts)
            {
                <!-- =================================================
                     EMPTY STATE
                ================================================== -->

                <header class="page-header">

                    <div>
                        <h1>No saved drafts</h1>
                        <p>Draft proposals will appear here when you save your work.</p>
                    </div>

                </header>


                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="notice" role="status">
                        @Model.Message
                    </div>
                }


                <section class="panel empty-panel">

                    <div class="empty-circle">0</div>

                    <h2 class="empty-title">No saved drafts</h2>

                    <p class="empty-text">
                        Draft proposals will appear here when you save your work.
                    </p>

                    <a asp-controller="Producer"
                       asp-action="Guidelines"
                       class="primary-button">
                        Start new proposal
                    </a>

                </section>
            }
            else
            {
                <!-- =================================================
                     HEADER
                ================================================== -->

                <header class="page-header">

                    <div>
                        <h1>Draft proposals</h1>
                        <p>Continue editing proposals that have not yet been submitted.</p>
                    </div>

                    <a asp-controller="Producer"
                       asp-action="Guidelines"
                       class="primary-button">
                        + Start new proposal
                    </a>

                </header>


                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="notice" role="status">
                        @Model.Message
                    </div>
                }


                <!-- =================================================
                     STATS
                ================================================== -->

                <section class="stats-grid">

                    <article class="stat-card">
                        <div class="stat-title">Total drafts</div>
                        <div class="stat-number">@Model.TotalDrafts</div>
                    </article>

                    <article class="stat-card">
                        <div class="stat-title">Nearly complete</div>
                        <div class="stat-number">@Model.NearlyComplete</div>
                    </article>

                    <article class="stat-card">
                        <div class="stat-title">Last updated</div>
                        <div class="stat-value">@Model.LastUpdatedDay</div>
                        <div class="stat-note">@Model.LastUpdatedTime</div>
                    </article>

                    <article class="stat-card">
                        <div class="stat-title">Auto-save</div>
                        <div class="stat-value enabled">Enabled</div>
                        <div class="stat-note">Saved each time you continue</div>
                    </article>

                </section>


                <!-- =================================================
                     SEARCH + SORT
                ================================================== -->

                <section class="panel filters">

                    <div class="filter-group search">

                        <label class="filter-label"
                               for="draftSearch">
                            SEARCH DRAFTS
                        </label>

                        <input id="draftSearch"
                               class="filter-input"
                               type="search"
                               placeholder="Search by programme title..."
                               autocomplete="off" />

                    </div>

                    <div class="filter-group sort">

                        <label class="filter-label"
                               for="draftSort">
                            SORT BY
                        </label>

                        <select id="draftSort"
                                class="filter-input">
                            <option value="updated-desc">Recently updated</option>
                            <option value="updated-asc">Oldest first</option>
                            <option value="title">Title (A–Z)</option>
                            <option value="progress">Most complete</option>
                        </select>

                    </div>

                </section>


                <!-- =================================================
                     SAVED DRAFTS
                ================================================== -->

                <section class="panel drafts-panel">

                    <h2 class="panel-title">Saved drafts</h2>

                    <p class="panel-subtitle">
                        Drafts remain private until you submit them.
                    </p>


                    <div class="draft-list"
                         id="draftList">

                        @for (int i = 0; i < Model.Drafts.Count; i++)
                        {
                            var draft = Model.Drafts[i];

                            <article class="draft-card"
                                     data-title="@draft.Title.ToLowerInvariant()"
                                     data-updated="@draft.UpdatedSortKey"
                                     data-progress="@draft.ProgressPercent">

                                <div class="draft-avatar @(avatarColours[i % avatarColours.Length])"
                                     aria-hidden="true">
                                    @draft.Initials
                                </div>


                                <div class="draft-body">

                                    <h3 class="draft-title"
                                        title="@draft.Title">
                                        @draft.Title
                                    </h3>

                                    <div class="draft-meta">
                                        @draft.Category • @draft.UpdatedText
                                    </div>

                                    <div class="draft-progress">

                                        <span class="progress-label">Progress</span>

                                        <div class="progress-track"
                                             role="progressbar"
                                             aria-valuemin="0"
                                             aria-valuemax="100"
                                             aria-valuenow="@draft.ProgressPercent"
                                             aria-label="@draft.Title progress">

                                            <div class="progress-bar"
                                                 style="width: @(draft.ProgressPercent)%">
                                            </div>

                                        </div>

                                        <span class="progress-value">@(draft.ProgressPercent)%</span>

                                    </div>

                                </div>


                                <div class="draft-actions">

                                    <a asp-controller="Producer"
                                       asp-action="ContinueDraft"
                                       asp-route-id="@draft.Id"
                                       class="continue-button primary">
                                        Continue editing
                                    </a>

                                    <button type="button"
                                            class="delete-link"
                                            data-delete-id="@draft.Id"
                                            data-delete-title="@draft.Title">
                                        Delete
                                    </button>

                                    <div class="more-menu">

                                        <button type="button"
                                                class="more-button"
                                                aria-haspopup="true"
                                                aria-expanded="false"
                                                aria-label="More options for @draft.Title">
                                            •••
                                        </button>

                                        <div class="more-list">

                                            <a asp-controller="Producer"
                                               asp-action="ContinueDraft"
                                               asp-route-id="@draft.Id"
                                               class="more-item">
                                                Continue editing
                                            </a>

                                            <button type="button"
                                                    class="more-item danger"
                                                    data-delete-id="@draft.Id"
                                                    data-delete-title="@draft.Title">
                                                Delete draft
                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </article>
                        }

                    </div>


                    <p class="no-results"
                       id="noResults"
                       hidden>
                        No drafts match your search.
                    </p>


                    <p class="panel-footnote">
                        Deleting a draft permanently removes the unsent proposal and its uploaded attachments.
                    </p>

                </section>
            }


        </div>

    </main>



    <!-- =========================================================
         DELETE CONFIRMATION
    ========================================================== -->

    <div class="modal-backdrop"
         id="deleteModal"
         aria-hidden="true">

        <div class="modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="deleteTitle"
             aria-describedby="deleteText">

            <div class="modal-icon" aria-hidden="true">!</div>

            <h2 class="modal-title"
                id="deleteTitle">
                Delete this draft?
            </h2>

            <p class="modal-text"
               id="deleteText">
                The draft and its uploaded attachments will be permanently removed.
            </p>

            <form asp-controller="Producer"
                  asp-action="DeleteDraft"
                  method="post"
                  id="deleteForm">

                <input type="hidden"
                       name="id"
                       id="deleteId"
                       value="" />

                <div class="modal-actions">

                    <button type="button"
                            class="modal-button"
                            id="cancelDelete">
                        Cancel
                    </button>

                    <button type="submit"
                            class="modal-button danger"
                            id="confirmDelete">
                        Delete draft
                    </button>

                </div>

            </form>

        </div>

    </div>



    <!-- =========================================================
         SCRIPTS
    ========================================================== -->

    <script>

        (function () {

            // -----------------------------------------------------
            // PAGE FADE OUT when following a link to another page
            // -----------------------------------------------------

            const reduceMotion =
                window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            document.addEventListener("click", function (event) {

                const link = event.target.closest("a[href]");

                if (!link || reduceMotion) {
                    return;
                }

                const href = link.getAttribute("href");

                // Leave normal browser behaviour for new tabs,
                // downloads, in-page links and other sites.
                if (!href ||
                    href.startsWith("#") ||
                    link.target === "_blank" ||
                    link.hasAttribute("download") ||
                    link.origin !== window.location.origin ||
                    event.button !== 0 ||
                    event.metaKey || event.ctrlKey ||
                    event.shiftKey || event.altKey) {
                    return;
                }

                event.preventDefault();

                document.body.classList.add("page-leaving");

                setTimeout(function () {
                    window.location.href = link.href;
                }, 190);
            });

            // Coming back with the Back button: show the page again.
            window.addEventListener("pageshow", function () {
                document.body.classList.remove("page-leaving");
            });


            // -----------------------------------------------------
            // PROFILE MENU
            // -----------------------------------------------------

            const producerAccount =
                document.getElementById("producerAccount");

            const producerProfileButton =
                document.getElementById("producerProfileButton");

            producerProfileButton.addEventListener("click", function (event) {

                event.stopPropagation();

                const isOpen =
                    producerAccount.classList.toggle("open");

                producerProfileButton.setAttribute(
                    "aria-expanded",
                    isOpen ? "true" : "false");
            });


            // -----------------------------------------------------
            // ⋯ MENUS
            // -----------------------------------------------------

            const moreMenus =
                Array.from(document.querySelectorAll(".more-menu"));

            function closeMoreMenus(except) {

                moreMenus.forEach(function (menu) {

                    if (menu !== except) {
                        menu.classList.remove("open");
                        menu.querySelector(".more-button")
                            .setAttribute("aria-expanded", "false");
                    }
                });
            }

            moreMenus.forEach(function (menu) {

                const button = menu.querySelector(".more-button");

                button.addEventListener("click", function (event) {

                    event.stopPropagation();

                    closeMoreMenus(menu);

                    const isOpen = menu.classList.toggle("open");

                    button.setAttribute(
                        "aria-expanded",
                        isOpen ? "true" : "false");
                });
            });

            document.addEventListener("click", function (event) {

                if (!producerAccount.contains(event.target)) {
                    producerAccount.classList.remove("open");
                    producerProfileButton.setAttribute("aria-expanded", "false");
                }

                if (!event.target.closest(".more-menu")) {
                    closeMoreMenus(null);
                }
            });


            // -----------------------------------------------------
            // SEARCH + SORT
            // -----------------------------------------------------

            const list = document.getElementById("draftList");
            const search = document.getElementById("draftSearch");
            const sort = document.getElementById("draftSort");
            const noResults = document.getElementById("noResults");

            if (list && search && sort) {

                const cards =
                    Array.from(list.querySelectorAll(".draft-card"));

                function applyFilter() {

                    const term = search.value.trim().toLowerCase();

                    let visible = 0;

                    cards.forEach(function (card) {

                        const match =
                            card.dataset.title.indexOf(term) !== -1;

                        card.hidden = !match;

                        if (match) {
                            visible++;
                        }
                    });

                    noResults.hidden = visible !== 0;
                }

                function applySort() {

                    const mode = sort.value;

                    const sorted = cards.slice().sort(function (a, b) {

                        if (mode === "title") {
                            return a.dataset.title.localeCompare(b.dataset.title);
                        }

                        if (mode === "progress") {
                            return Number(b.dataset.progress) - Number(a.dataset.progress);
                        }

                        const difference =
                            Number(a.dataset.updated) - Number(b.dataset.updated);

                        return mode === "updated-asc"
                            ? difference
                            : -difference;
                    });

                    sorted.forEach(function (card) {
                        list.appendChild(card);
                    });
                }

                search.addEventListener("input", applyFilter);
                sort.addEventListener("change", applySort);
            }


            // -----------------------------------------------------
            // DELETE CONFIRMATION
            // -----------------------------------------------------

            const modal = document.getElementById("deleteModal");
            const deleteId = document.getElementById("deleteId");
            const deleteText = document.getElementById("deleteText");
            const cancelDelete = document.getElementById("cancelDelete");
            const confirmDelete = document.getElementById("confirmDelete");
            const deleteForm = document.getElementById("deleteForm");

            let lastFocused = null;

            function openModal(id, title) {

                lastFocused = document.activeElement;

                deleteId.value = id;

                deleteText.textContent =
                    "\u201C" + title + "\u201D and its uploaded attachments " +
                    "will be permanently removed.";

                closeMoreMenus(null);

                modal.classList.add("open");
                modal.setAttribute("aria-hidden", "false");

                cancelDelete.focus();
            }

            function closeModal() {

                modal.classList.remove("open");
                modal.setAttribute("aria-hidden", "true");

                if (lastFocused) {
                    lastFocused.focus();
                }
            }

            document.querySelectorAll("[data-delete-id]").forEach(function (button) {

                button.addEventListener("click", function () {
                    openModal(
                        button.dataset.deleteId,
                        button.dataset.deleteTitle);
                });
            });

            cancelDelete.addEventListener("click", closeModal);

            // Clicking the dimmed area closes the popup.
            modal.addEventListener("click", function (event) {
                if (event.target === modal) {
                    closeModal();
                }
            });

            // Stop double clicks sending the delete twice.
            deleteForm.addEventListener("submit", function () {
                confirmDelete.disabled = true;
                confirmDelete.textContent = "Deleting…";
            });


            // -----------------------------------------------------
            // ESCAPE closes whatever is open
            // -----------------------------------------------------

            document.addEventListener("keydown", function (event) {

                if (event.key !== "Escape") {
                    return;
                }

                if (modal.classList.contains("open")) {
                    closeModal();
                }

                closeMoreMenus(null);

                producerAccount.classList.remove("open");
                producerProfileButton.setAttribute("aria-expanded", "false");
            });

        })();

    </script>


</body>

</html>