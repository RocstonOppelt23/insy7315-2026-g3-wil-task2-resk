@model RESK.WIL.Models.AttachmentsViewModel

@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    Layout = null;
    ViewData["Title"] = "Supporting Attachments";

    var currentUser = await UserManager.GetUserAsync(User);

    var username =
        currentUser?.Email
        ?? currentUser?.UserName
        ?? "Producer";

    var initial =
        string.IsNullOrWhiteSpace(username)
            ? "P"
            : username.Substring(0, 1).ToUpper();
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Supporting Attachments - R.E.S.K</title>

    <style>

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html,
            body {
                min-height: 100%;
            }

            body {
                font-family: Inter, "Segoe UI", Arial, sans-serif;
                background: #f4f7fb;
                color: #14233e;
            }

            button,
            input,
            textarea,
            select,
            a {
                font-family: inherit;
            }


            /* =====================================================
                       SIDEBAR
                    ===================================================== */

            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: 277px;
                display: flex;
                flex-direction: column;
                padding: 39px 21px;
                background: #071d3b;
                color: white;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 16px;
                margin: 0 14px 50px;
            }

            .brand-icon {
                width: 60px;
                height: 60px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                border: 2px solid #12b8ce;
                border-radius: 18px;
                color: #12b8ce;
                font-size: 25px;
                font-weight: 900;
            }

            .brand-name {
                color: white;
                font-size: 24px;
                font-weight: 900;
                letter-spacing: 4px;
            }

            .brand-subtitle {
                margin-top: 7px;
                color: #c7d1e1;
                font-size: 9px;
                font-weight: 600;
            }


            /* =====================================================
                       STEPS
                    ===================================================== */

            .steps-heading {
                margin: 0 14px 12px;
                color: #6f83a2;
                font-size: 10px;
                font-weight: 800;
            }

            .steps {
                display: flex;
                flex-direction: column;
                gap: 7px;
            }

            .step {
                min-height: 51px;
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 0 14px;
                border-radius: 10px;
                color: #8093b1;
            }

                .step.active {
                    background: #15345e;
                    color: white;
                }

                .step.complete {
                    color: #8ca4c2;
                }

            .step-number {
                width: 29px;
                height: 29px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                border: 1px solid #506685;
                border-radius: 50%;
                color: #9bacc3;
                font-size: 10px;
                font-weight: 800;
            }

            .step.complete .step-number,
            .step.active .step-number {
                border-color: #12b8ce;
                background: #12b8ce;
                color: white;
            }

            .step-name {
                font-size: 11px;
                font-weight: 700;
            }


            /* =====================================================
                       PROFILE
                    ===================================================== */

            .producer-profile {
                margin-top: auto;
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 13px;
                border-radius: 11px;
                background: #14345e;
            }

            .producer-avatar {
                width: 37px;
                height: 37px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                border-radius: 50%;
                background: #12b8ce;
                color: white;
                font-size: 11px;
                font-weight: 900;
            }

            .producer-profile-info {
                min-width: 0;
            }

            .producer-name {
                max-width: 170px;
                overflow: hidden;
                color: white;
                font-size: 11px;
                font-weight: 800;
                white-space: nowrap;
                text-overflow: ellipsis;
            }

            .producer-role {
                margin-top: 5px;
                color: #b6c4d7;
                font-size: 9px;
            }


            /* =====================================================
                       MAIN CONTENT
                    ===================================================== */

            .main {
                min-height: 100vh;
                margin-left: 277px;
                padding-bottom: 55px;
            }

            .page {
                width: calc(100% - 126px);
                max-width: 1000px;
                margin: 0 auto;
                padding-top: 25px;
            }

            .page-title {
                color: #071d3b;
                font-size: 23px;
                font-weight: 900;
            }

            .page-description {
                margin-top: 8px;
                color: #71839e;
                font-size: 12px;
            }


            /* =====================================================
                       PROGRESS
                    ===================================================== */

            .progress-section {
                margin-top: 25px;
                margin-bottom: 20px;
            }

            .progress-info {
                display: flex;
                justify-content: space-between;
                margin-bottom: 8px;
                color: #71839e;
                font-size: 10px;
                font-weight: 700;
            }

            .progress-track {
                width: 100%;
                height: 6px;
                overflow: hidden;
                border-radius: 20px;
                background: #dce4ef;
            }

            .progress-bar {
                width: 80%;
                height: 100%;
                border-radius: 20px;
                background: #12b8ce;
            }


            /* =====================================================
                       CARD
                    ===================================================== */

            .form-card {
                padding: 29px 32px;
                border: 1px solid #d6dfeb;
                border-radius: 14px;
                background: white;
            }

            .card-title {
                color: #071d3b;
                font-size: 19px;
                font-weight: 900;
            }

            .card-description {
                margin-top: 8px;
                margin-bottom: 28px;
                color: #71839e;
                font-size: 11px;
            }


            /* =====================================================
                       FORM
                    ===================================================== */

            .form-group {
                margin-bottom: 25px;
            }

            .form-label {
                display: block;
                margin-bottom: 8px;
                color: #14233e;
                font-size: 11px;
                font-weight: 800;
            }

            .required {
                color: #d64d58;
            }

            .form-control {
                width: 100%;
                height: 47px;
                padding: 0 14px;
                border: 1px solid #cfdae8;
                border-radius: 9px;
                outline: none;
                background: white;
                color: #14233e;
                font-size: 12px;
            }

                .form-control:focus {
                    border-color: #12b8ce;
                    box-shadow: 0 0 0 3px rgba(18, 184, 206, .10);
                }


            /* =====================================================
                       UPLOAD BOX
                    ===================================================== */

            .upload-box {
                position: relative;
                min-height: 135px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                border: 2px dashed #ccd8e7;
                border-radius: 11px;
                background: #fbfcfe;
                text-align: center;
                transition: .2s ease;
            }

                .upload-box:hover {
                    border-color: #12b8ce;
                    background: #f5fcfd;
                }

                .upload-box.has-error {
                    border-color: #e0a3a8;
                    background: #fff9f9;
                }

                .upload-box input[type="file"] {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    opacity: 0;
                    cursor: pointer;
                }

            .upload-icon {
                color: #12b8ce;
                font-size: 27px;
                font-weight: 900;
            }

            .upload-title {
                margin-top: 8px;
                color: #14233e;
                font-size: 12px;
                font-weight: 800;
            }

            .upload-help {
                margin-top: 6px;
                color: #8292a8;
                font-size: 10px;
            }

            .selected-file {
                margin-top: 8px;
                color: #147f8e;
                font-size: 10px;
                font-weight: 800;
            }


            /* =====================================================
                       EXISTING FILE
                    ===================================================== */

            .existing-file {
                margin-top: 9px;
                padding: 11px 13px;
                border: 1px solid #bfe7ec;
                border-radius: 8px;
                background: #eefbfc;
                color: #147f8e;
                font-size: 10px;
                font-weight: 700;
            }


            /* =====================================================
                       VALIDATION
                    ===================================================== */

            .validation-message,
            .client-error {
                display: block;
                margin-top: 7px;
                color: #c9444d;
                font-size: 10px;
                font-weight: 600;
                line-height: 1.5;
            }

                .client-error:empty {
                    display: none;
                }

            .validation-summary {
                margin-bottom: 20px;
                padding: 13px 15px;
                border: 1px solid #f0c2c5;
                border-radius: 9px;
                background: #fff7f7;
                color: #b84048;
                font-size: 11px;
            }

                .validation-summary:empty {
                    display: none;
                }

            .upload-banner {
                margin-bottom: 20px;
                padding: 13px 15px;
                border: 1px solid #f0c2c5;
                border-radius: 9px;
                background: #fff7f7;
                color: #b84048;
                font-size: 11px;
                font-weight: 600;
                line-height: 1.5;
            }

                .upload-banner[hidden] {
                    display: none;
                }


            /* =====================================================
                       BUTTONS
                    ===================================================== */

            .actions {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-top: 24px;
            }

            .back-button,
            .continue-button {
                min-height: 43px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 21px;
                border-radius: 8px;
                font-size: 11px;
                font-weight: 800;
                text-decoration: none;
            }

            .back-button {
                min-width: 118px;
                border: 1px solid #d3ddea;
                background: white;
                color: #526783;
            }

            .continue-button {
                min-width: 145px;
                border: none;
                background: #12b8ce;
                color: white;
                cursor: pointer;
            }

                .continue-button:hover {
                    background: #0faabd;
                }

                .continue-button:disabled {
                    background: #8fd5df;
                    cursor: wait;
                }


            /* =====================================================
                       RESPONSIVE
                    ===================================================== */

            @@media(max-width: 900px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                    min-height: auto;
                }

                .main {
                    margin-left: 0;
                }

                .page {
                    width: calc(100% - 40px);
                }

                .producer-profile {
                    margin-top: 30px;
                }
            }

            @@media(max-width: 600px) {

                .actions {
                    flex-direction: column;
                    gap: 12px;
                }

                .back-button,
                .continue-button {
                    width: 100%;
                }
            }

    </style>

    <style id="reskWizardButtons">
        .resk-cancel { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px; border: 1px solid #e1e7ef; border-radius: 8px; background: transparent; color: #61728d; font-size: 13px; font-weight: 800; text-decoration: none; transition: background 0.2s, border-color 0.2s, color 0.2s; }
        .resk-cancel:hover { border-color: #f0c2c5; background: #fff7f7; color: #b84048; }
        .resk-save-draft { min-height: 44px; padding: 0 22px; border: 1px solid #d3dce8; border-radius: 8px; background: #ffffff; color: #14233e; font-family: inherit; font-size: 13px; font-weight: 800; cursor: pointer; transition: border-color 0.2s, color 0.2s; }
        .resk-save-draft:hover { border-color: #12b8ce; color: #0a9fb2; }
    </style>    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=resk2" />
</head>


<body>


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-icon">
                R
            </div>

            <div>

                <div class="brand-name">
                    R.E.S.K
                </div>

                <div class="brand-subtitle">
                    SOFTWARE STUDIO
                </div>

            </div>

        </div>


        <div class="steps-heading">
            NEW PROPOSAL
        </div>


        <div class="steps">


            <div class="step complete">

                <div class="step-number">
                    ✓
                </div>

                <div class="step-name">
                    Producer details
                </div>

            </div>


            <div class="step complete">

                <div class="step-number">
                    ✓
                </div>

                <div class="step-name">
                    Programme details
                </div>

            </div>


            <div class="step complete">

                <div class="step-number">
                    ✓
                </div>

                <div class="step-name">
                    Production details
                </div>

            </div>


            <div class="step active">

                <div class="step-number">
                    4
                </div>

                <div class="step-name">
                    Attachments
                </div>

            </div>


            <div class="step">

                <div class="step-number">
                    5
                </div>

                <div class="step-name">
                    Review & submit
                </div>

            </div>


        </div>


        <div class="producer-profile">

            <div class="producer-avatar">@await Component.InvokeAsync("ProducerAvatar", new { part = "avatar" })</div>

            <div class="producer-profile-info">

                <div class="producer-name">@await Component.InvokeAsync("ProducerAvatar", new { part = "name" })</div>

                <div class="producer-role">
                    Community Producer
                </div>

            </div>

        </div>

    
        <!-- ===== PRODUCER ACCOUNT (photo, name, Account settings, Log out) ===== -->
        <style>
            .producer-account:not(.resk-account), .sidebar > .producer-profile { display: none !important; }
            .resk-account { position: relative; margin-top: auto; padding: 0 8px; }
            .resk-profile { width: 100%; display: flex; align-items: center; gap: 11px; padding: 12px 10px; border: none; border-radius: 11px; background: #142a4b; color: #ffffff; cursor: pointer; text-align: left; font-family: inherit; }
            .resk-profile:hover { background: #193456; }
            .resk-avatar { width: 34px; height: 34px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: #0bb6ca; color: #ffffff; font-size: 11px; font-weight: 800; }
            .resk-text { min-width: 0; flex: 1; }
            .resk-name { overflow: hidden; color: #ffffff; font-size: 13px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
            .resk-role { margin-top: 4px; color: #b5c0d1; font-size: 10px; }
            .resk-menu { position: absolute; left: 8px; right: 8px; bottom: calc(100% + 9px); z-index: 10; padding: 7px; border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; background: #142a4b; box-shadow: 0 18px 35px rgba(0,0,0,0.25); opacity: 0; visibility: hidden; transform: translateY(8px); transition: 0.2s; }
            .resk-account.open .resk-menu { opacity: 1; visibility: visible; transform: translateY(0); }
            .resk-menu-link, .resk-logout { width: 100%; display: block; padding: 10px 11px; border: none; border-radius: 7px; background: transparent; color: #d6deea; font-family: inherit; font-size: 12px; font-weight: 600; text-align: left; text-decoration: none; cursor: pointer; }
            .resk-menu-link:hover, .resk-logout:hover { background: rgba(255,255,255,0.06); color: #ffffff; }
            .resk-logout { color: #ff9e9e; }
            .resk-divider { height: 1px; margin: 5px 4px; background: rgba(255,255,255,0.08); }
        </style>

        <div class="resk-account" id="reskAccount">

            <div class="resk-menu">
                <a href="/Producer/Settings" class="resk-menu-link">Account settings</a>
                <div class="resk-divider"></div>
                <form method="post" action="/Producer/Logout" style="margin:0;">
                    <button type="submit" class="resk-logout" id="reskLogoutButton" data-step="4">Log out</button>
                </form>
            </div>

            <button type="button" class="resk-profile" id="reskProfileButton" aria-expanded="false">
                <div class="resk-avatar">@await Component.InvokeAsync("ProducerAvatar", new { part = "avatar" })</div>
                <div class="resk-text">
                    <div class="resk-name">@await Component.InvokeAsync("ProducerAvatar", new { part = "name" })</div>
                    <div class="resk-role">Community Producer</div>
                </div>
            </button>

        </div>

        <script>
            (function () {
                var account = document.getElementById("reskAccount");
                var button = document.getElementById("reskProfileButton");
                var logoutButton = document.getElementById("reskLogoutButton");

                button.addEventListener("click", function (event) {
                    event.stopPropagation();
                    var isOpen = account.classList.toggle("open");
                    button.setAttribute("aria-expanded", isOpen ? "true" : "false");
                });

                document.addEventListener("click", function (event) {
                    if (!account.contains(event.target)) {
                        account.classList.remove("open");
                        button.setAttribute("aria-expanded", "false");
                    }
                });

                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape") {
                        account.classList.remove("open");
                        button.setAttribute("aria-expanded", "false");
                    }
                });

                // Log out: save this page to Drafts first, then sign out.
                logoutButton.addEventListener("click", function (event) {
                    var forms = Array.prototype.filter.call(document.querySelectorAll("form"), function (f) {
                        var method = (f.getAttribute("method") || "").toLowerCase();
                        return !account.contains(f) && method === "post";
                    });

                    var form = forms[0];

                    // No proposal form on the page: just log out normally.
                    if (!form) { return; }

                    event.preventDefault();

                    function addHidden(name, value) {
                        var input = document.createElement("input");
                        input.type = "hidden";
                        input.name = name;
                        input.value = value;
                        form.appendChild(input);
                    }

                    addHidden("step", logoutButton.getAttribute("data-step"));
                    addHidden("logout", "true");

                    form.setAttribute("action", "/Producer/SaveDraft");
                    HTMLFormElement.prototype.submit.call(form);
                });
            })();
        </script>
</aside>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="main">

        <div class="page">


            <header>

                <h1 class="page-title">
                    Supporting attachments
                </h1>

                <p class="page-description">
                    Upload supporting material for your programme proposal.
                </p>

            </header>


            <!-- PROGRESS -->

            <div class="progress-section">

                <div class="progress-info">

                    <span>
                        Step 4 of 5
                    </span>

                    <span>
                        80% complete
                    </span>

                </div>


                <div class="progress-track">

                    <div class="progress-bar">
                    </div>

                </div>

            </div>


            <!-- FORM -->

            <form id="attachmentsForm"
                  asp-controller="Producer"
                  asp-action="Attachments"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- Shown by the script below when a file can't be used -->
                <div id="uploadBanner"
                     class="upload-banner"
                     role="alert"
                     hidden>
                </div>


                <section class="form-card">


                    <h2 class="card-title">
                        Proposal documents
                    </h2>


                    <p class="card-description">
                        Upload your proposal document and any supporting material.
                    </p>


                    <!-- =========================================
                         PROPOSAL DOCUMENT
                    ========================================== -->

                    <div class="form-group">

                        <label asp-for="ProposalDocument"
                               class="form-label">

                            Proposal document
                            <span class="required">*</span>

                        </label>


                        <div class="upload-box">

                            <input asp-for="ProposalDocument"
                                   type="file"
                                   accept=".pdf"
                                   data-selected="proposalFileName"
                                   data-error="proposalClientError" />


                            <div>

                                <div class="upload-icon">
                                    ↑
                                </div>


                                <div class="upload-title">
                                    Click to upload or drag and drop
                                </div>


                                <div class="upload-help">
                                    PDF only · Maximum 20 MB
                                </div>


                                <div id="proposalFileName"
                                     class="selected-file">
                                </div>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            Model.ExistingProposalDocument))
                        {
                            <div class="existing-file">

                                ✓ Already uploaded: @Model.ExistingProposalDocument

                            </div>
                        }


                        <div id="proposalClientError"
                             class="client-error"></div>


                        <span asp-validation-for="ProposalDocument"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =========================================
                         SHOWREEL
                    ========================================== -->

                    <div class="form-group">

                        <label asp-for="PilotShowreelLink"
                               class="form-label">

                            Pilot / showreel link

                        </label>


                        <input asp-for="PilotShowreelLink"
                               type="url"
                               class="form-control"
                               placeholder="https://youtube.com/..." />


                        <span asp-validation-for="PilotShowreelLink"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =========================================
                         BUDGET
                    ========================================== -->

                    <div class="form-group">

                        <label asp-for="BudgetDocument"
                               class="form-label">

                            Budget document

                        </label>


                        <div class="upload-box">

                            <input asp-for="BudgetDocument"
                                   type="file"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx"
                                   data-selected="budgetFileName"
                                   data-error="budgetClientError" />


                            <div>

                                <div class="upload-icon">
                                    ↑
                                </div>


                                <div class="upload-title">
                                    Upload budget document
                                </div>


                                <div class="upload-help">
                                    PDF, Word or Excel · Maximum 20 MB
                                </div>


                                <div id="budgetFileName"
                                     class="selected-file">
                                </div>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            Model.ExistingBudgetDocument))
                        {
                            <div class="existing-file">

                                ✓ Already uploaded: @Model.ExistingBudgetDocument

                            </div>
                        }


                        <div id="budgetClientError"
                             class="client-error"></div>


                        <span asp-validation-for="BudgetDocument"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =========================================
                         ADDITIONAL FILE
                    ========================================== -->

                    <div class="form-group">

                        <label asp-for="AdditionalFile"
                               class="form-label">

                            Additional file

                        </label>


                        <div class="upload-box">

                            <input asp-for="AdditionalFile"
                                   type="file"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png"
                                   data-selected="additionalFileName"
                                   data-error="additionalClientError" />


                            <div>

                                <div class="upload-icon">
                                    ↑
                                </div>


                                <div class="upload-title">
                                    Upload additional supporting material
                                </div>


                                <div class="upload-help">
                                    PDF, Word, Excel or image · Maximum 20 MB
                                </div>


                                <div id="additionalFileName"
                                     class="selected-file">
                                </div>

                            </div>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(
                            Model.ExistingAdditionalFile))
                        {
                            <div class="existing-file">

                                ✓ Already uploaded: @Model.ExistingAdditionalFile

                            </div>
                        }


                        <div id="additionalClientError"
                             class="client-error"></div>


                        <span asp-validation-for="AdditionalFile"
                              class="validation-message">
                        </span>

                    </div>


                </section>


                <!-- =============================================
                     ACTIONS
                ============================================== -->

                <div class="actions">


                    <a asp-controller="Producer"
                       asp-action="ProductionDetails"
                       class="back-button">

                        ← Back

                    </a>


                    <div style="display:flex;align-items:center;gap:14px;margin-left:auto;flex-wrap:wrap;justify-content:flex-end;">
                        <a href="/Producer/CancelProposal" class="resk-cancel">Cancel</a>
                        <button type="button" class="resk-save-draft" onclick="var f=this.form;var s=document.createElement('input');s.type='hidden';s.name='step';s.value='4';f.appendChild(s);f.action='/Producer/SaveDraft';HTMLFormElement.prototype.submit.call(f);">Save draft</button>
                        <button id="continueButton"
                            type="submit"
                            class="continue-button">

                        Continue →

                    </button>
                    </div>


                </div>


            </form>


        </div>

    </main>


    <script>

            /*
             * Why this script exists:
             *
             * Chrome shows "This site can't be reached -
             * ERR_ACCESS_DENIED" when it can't read a file the
             * user selected (for example a OneDrive "online-only"
             * file while OneDrive is paused, a file that is open
             * or changed after it was selected, or a folder
             * blocked by Windows Security).
             *
             * The script tries to read each file BEFORE the form
             * is sent. If a file can't be read, it shows a clear
             * message on the page instead of letting Chrome fail.
             */

            (function () {

                const MAX_BYTES = 20 * 1024 * 1024;

                const UNREADABLE_MESSAGE =
                    "Your browser couldn't read this file. " +
                    "Close it in Word, Excel or your PDF reader. " +
                    "If it's in OneDrive, right-click it and choose " +
                    "\"Always keep on this device\", or copy it to a " +
                    "folder like C:\\Temp. Then select it again.";

                const form =
                    document.getElementById("attachmentsForm");

                const continueButton =
                    document.getElementById("continueButton");

                const banner =
                    document.getElementById("uploadBanner");

                const fileInputs =
                    Array.from(
                        form.querySelectorAll("input[type='file']"));

                const originalButtonText =
                    continueButton.textContent;

                let sending = false;


                function allowedExtensions(input) {

                    return (input.getAttribute("accept") || "")
                        .split(",")
                        .map(function (ext) {
                            return ext.trim().toLowerCase();
                        })
                        .filter(function (ext) {
                            return ext.length > 0;
                        });
                }


                function extensionOf(fileName) {

                    const dot = fileName.lastIndexOf(".");

                    return dot >= 0
                        ? fileName.substring(dot).toLowerCase()
                        : "";
                }


                // Reading the first byte is enough to find out whether
                // the browser is allowed to read the file.
                async function canReadFile(file) {

                    try {
                        await file.slice(0, 1).arrayBuffer();
                        return true;
                    }
                    catch (error) {
                        return false;
                    }
                }


                // Returns true if the input is empty or its file is OK.
                async function checkFileInput(input) {

                    const selectedLabel =
                        document.getElementById(input.dataset.selected);

                    const errorLabel =
                        document.getElementById(input.dataset.error);

                    const box =
                        input.closest(".upload-box");

                    selectedLabel.textContent = "";
                    errorLabel.textContent = "";
                    box.classList.remove("has-error");


                    if (!input.files || input.files.length === 0) {
                        return true;
                    }


                    const file = input.files[0];

                    let message = "";


                    if (file.size === 0) {

                        message = "This file is empty.";
                    }
                    else if (file.size > MAX_BYTES) {

                        message = "This file is larger than 20 MB.";
                    }
                    else if (allowedExtensions(input)
                                 .indexOf(extensionOf(file.name)) < 0) {

                        message = "This file type is not allowed.";
                    }
                    else if (!(await canReadFile(file))) {

                        message = UNREADABLE_MESSAGE;
                    }


                    if (message) {

                        errorLabel.textContent =
                            file.name + ": " + message;

                        box.classList.add("has-error");

                        // Clear the bad file so it is never sent.
                        input.value = "";

                        return false;
                    }


                    selectedLabel.textContent =
                        "Selected: " + file.name;

                    return true;
                }


                function showBanner(text) {

                    banner.textContent = text;
                    banner.hidden = false;

                    banner.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });
                }


                function resetButton() {

                    sending = false;

                    continueButton.disabled = false;
                    continueButton.textContent = originalButtonText;
                }


                // Check each file as soon as it is chosen.
                fileInputs.forEach(function (input) {

                    input.addEventListener("change", function () {

                        banner.hidden = true;

                        checkFileInput(input);
                    });
                });


                // Check every file again right before sending,
                // because a file can become unreadable after it
                // was selected (e.g. it was edited or OneDrive
                // went offline).
                form.addEventListener("submit", async function (event) {

                    event.preventDefault();

                    if (sending) {
                        return;
                    }

                    sending = true;

                    continueButton.disabled = true;
                    banner.hidden = true;


                    // Keep the browser's normal checks, such as the
                    // showreel link having to be a valid URL.
                    if (!form.reportValidity()) {

                        resetButton();
                        return;
                    }


                    let allFilesOk = true;

                    for (const input of fileInputs) {

                        if (!(await checkFileInput(input))) {
                            allFilesOk = false;
                        }
                    }


                    if (!allFilesOk) {

                        showBanner(
                            "One or more files couldn't be used. " +
                            "See the message under each file, fix it, " +
                            "and select the file again.");

                        resetButton();
                        return;
                    }


                    continueButton.textContent = "Uploading…";

                    // form.submit() sends the form without firing
                    // this submit handler again.
                    HTMLFormElement.prototype.submit.call(form);
                });


                // If the user comes back with the browser's Back
                // button, make the Continue button usable again.
                window.addEventListener("pageshow", function () {

                    resetButton();
                });

            })();

    </script>


</body>

</html>