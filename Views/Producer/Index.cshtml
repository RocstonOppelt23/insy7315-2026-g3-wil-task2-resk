@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    Layout = null;
    ViewData["Title"] = "Producer Dashboard";

    var currentUser = await UserManager.GetUserAsync(User);

    var producerUsername =
        currentUser?.Email
        ?? currentUser?.UserName
        ?? "Producer";

    var initial =
        !string.IsNullOrWhiteSpace(producerUsername)
            ? producerUsername.Substring(0, 1).ToUpper()
            : "P";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Producer Dashboard - R.E.S.K</title>

    <style>

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html,
            body {
                min-height: 100%;
            }

            body {
                font-family: Inter, "Segoe UI", Arial, sans-serif;
                background: #f4f7fb;
                color: #13223c;
                opacity: 0;
                animation: pageFadeIn 0.55s ease forwards;
            }

            @@keyframes pageFadeIn {

                from {
                    opacity: 0;
                }

                to {
                    opacity: 1;
                }
            }

            button,
            a {
                font-family: inherit;
            }


            /* =========================================================
                       SIDEBAR
                    ========================================================= */

            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                bottom: 0;
                width: 260px;
                display: flex;
                flex-direction: column;
                background: #0c1a33;
                color: white;
                padding: 36px 20px 38px;
                z-index: 100;
            }


            /* =========================================================
                       BRAND
                    ========================================================= */

            .brand {
                display: flex;
                align-items: center;
                gap: 15px;
                padding-left: 13px;
                margin-bottom: 42px;
            }

            .brand-icon {
                width: 56px;
                height: 56px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 2px solid #00b9d0;
                border-radius: 17px;
                color: #00bfd7;
                font-size: 28px;
                font-weight: 700;
            }

            .brand-name {
                color: white;
                font-size: 24px;
                font-weight: 800;
                letter-spacing: 1.5px;
            }

            .brand-subtitle {
                margin-top: 5px;
                color: #d3dae7;
                font-size: 9px;
            }


            /* =========================================================
                       NAVIGATION
                    ========================================================= */

            .nav-label {
                margin: 0 12px 8px;
                color: #72809a;
                font-size: 10px;
                font-weight: 800;
            }

            .sidebar-nav {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                min-height: 43px;
                padding: 0 32px;
                border-radius: 10px;
                color: #b9c2d1;
                font-size: 14px;
                font-weight: 500;
                text-decoration: none;
                transition: 0.2s;
            }

                .sidebar-link:hover {
                    color: white;
                    background: rgba(255,255,255,0.05);
                    transform: translateX(2px);
                }

                .sidebar-link.active {
                    background: #142a4b;
                    color: white;
                    font-weight: 700;
                }


            /* =========================================================
                       PRODUCER ACCOUNT
                    ========================================================= */

            .producer-account {
                position: relative;
                margin-top: auto;
                padding: 0 8px;
            }

            .producer-profile {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 12px 10px;
                border: none;
                border-radius: 11px;
                background: #142a4b;
                color: white;
                cursor: pointer;
                text-align: left;
            }

                .producer-profile:hover {
                    background: #193456;
                }

            .producer-avatar {
                width: 34px;
                height: 34px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #0bb6ca;
                color: white;
                font-size: 11px;
                font-weight: 800;
            }

            .producer-profile-text {
                min-width: 0;
                flex: 1;
            }

            .producer-name {
                overflow: hidden;
                color: white;
                font-size: 13px;
                font-weight: 700;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .producer-role {
                margin-top: 4px;
                color: #b5c0d1;
                font-size: 10px;
            }


            /* =========================================================
                       PROFILE MENU
                    ========================================================= */

            .profile-menu {
                position: absolute;
                left: 8px;
                right: 8px;
                bottom: calc(100% + 9px);
                padding: 7px;
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 10px;
                background: #142a4b;
                box-shadow: 0 18px 35px rgba(0,0,0,0.25);
                opacity: 0;
                visibility: hidden;
                transform: translateY(8px);
                transition: 0.2s;
            }

            .producer-account.open .profile-menu {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .profile-menu-link,
            .logout-button {
                width: 100%;
                display: block;
                padding: 10px 11px;
                border: none;
                border-radius: 7px;
                background: transparent;
                color: #d6deea;
                font-size: 12px;
                font-weight: 600;
                text-align: left;
                text-decoration: none;
                cursor: pointer;
            }

                .profile-menu-link:hover,
                .logout-button:hover {
                    background: rgba(255,255,255,0.06);
                    color: white;
                }

            .logout-button {
                color: #ff9e9e;
            }

            .menu-divider {
                height: 1px;
                margin: 5px 4px;
                background: rgba(255,255,255,0.08);
            }


            /* =========================================================
                       MAIN
                    ========================================================= */

            .main {
                min-height: 100vh;
                margin-left: 260px;
                padding: 28px 52px 38px;
                background: #f4f7fb;
            }

            .dashboard {
                width: 100%;
                max-width: 1070px;
                margin: 0 auto;
            }


            /* =========================================================
                       WELCOME
                    ========================================================= */

            .welcome {
                margin-bottom: 26px;
            }

                .welcome h1 {
                    color: #14233e;
                    font-size: 31px;
                    line-height: 1.2;
                    font-weight: 800;
                }

                .welcome p {
                    margin-top: 8px;
                    color: #697a96;
                    font-size: 14px;
                }


            /* =========================================================
                       STATS
                    ========================================================= */

            .stats-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 15px;
                margin-bottom: 21px;
            }

            .stat-card {
                min-height: 117px;
                padding: 20px;
                border: 1px solid #d9e1ec;
                border-radius: 13px;
                background: white;
            }

            .stat-title {
                margin-bottom: 12px;
                color: #61728d;
                font-size: 11px;
                font-weight: 800;
            }

            .stat-content {
                display: flex;
                align-items: baseline;
                gap: 10px;
            }

            .stat-number {
                color: #12213b;
                font-size: 35px;
                line-height: 1;
                font-weight: 800;
            }

            .stat-text {
                color: #687995;
                font-size: 11px;
            }

                .stat-text.review {
                    color: #d98a00;
                    font-weight: 700;
                }

                .stat-text.approved {
                    color: #209766;
                    font-weight: 700;
                }


            /* =========================================================
                       DASHBOARD GRID
                    ========================================================= */

            .dashboard-grid {
                display: grid;
                grid-template-columns: minmax(0,1.95fr) minmax(300px,1fr);
                gap: 15px;
            }

            .left-column,
            .right-column {
                display: flex;
                flex-direction: column;
                gap: 15px;
            }


            /* =========================================================
                       PANELS
                    ========================================================= */

            .panel {
                border: 1px solid #d9e1ec;
                border-radius: 13px;
                background: white;
                overflow: hidden;
            }

            .panel-padding {
                padding: 20px 23px;
            }

            .panel-title {
                color: #14233e;
                font-size: 19px;
                font-weight: 800;
            }

            .panel-subtitle {
                margin-top: 5px;
                color: #6d7e99;
                font-size: 11px;
            }


            /* =========================================================
                       EMPTY CURRENT PROPOSAL
                    ========================================================= */

            .current-proposal {
                margin-top: 20px;
                padding: 25px;
                border: 1px solid #dde4ee;
                border-radius: 12px;
                background: #f7f9fc;
            }

            .empty-title {
                color: #14233e;
                font-size: 19px;
                font-weight: 800;
            }

            .empty-text {
                margin-top: 10px;
                color: #627490;
                font-size: 11px;
                line-height: 1.8;
            }


            /* =========================================================
                       BUTTONS
                    ========================================================= */

            .outline-button {
                display: inline-block;
                margin-top: 18px;
                padding: 9px 27px;
                border: 1px solid #11b6ca;
                border-radius: 8px;
                background: white;
                color: #00a9bd;
                font-size: 10px;
                font-weight: 700;
                text-decoration: none;
            }

                .outline-button:hover {
                    background: #eefbfc;
                }


            /* =========================================================
                       NEXT ACTION
                    ========================================================= */

            .info-box {
                display: flex;
                gap: 12px;
                margin-top: 20px;
                padding: 13px;
                border: 1px solid #8ee0e9;
                border-radius: 10px;
                background: #eefbfc;
            }

            .info-icon {
                width: 28px;
                height: 28px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #10b3c7;
                color: white;
                font-size: 14px;
                font-weight: 800;
            }

            .info-title {
                margin-top: 4px;
                color: #14233e;
                font-size: 12px;
                font-weight: 800;
            }

            .info-description {
                margin-top: 13px;
                color: #61748f;
                font-size: 10px;
                line-height: 1.7;
            }

            .status-details {
                display: inline-block;
                margin-top: 8px;
                padding: 5px 10px;
                border-radius: 999px;
                background: white;
                color: #009cb0;
                font-size: 10px;
                font-weight: 700;
                text-decoration: none;
            }


            /* =========================================================
                       RECENT PROPOSALS
                    ========================================================= */

            .recent-header {
                padding: 17px 23px 13px;
            }

            .proposal-table-wrap {
                padding: 0 15px 25px;
            }

            .proposal-table {
                width: 100%;
                border-collapse: collapse;
            }

                .proposal-table thead {
                    background: #f2f5f9;
                }

                .proposal-table th {
                    padding: 12px 18px;
                    color: #64758f;
                    font-size: 10px;
                    font-weight: 800;
                    text-align: left;
                }

            .empty-table {
                padding: 45px 20px !important;
                color: #8493aa !important;
                text-align: center;
                font-size: 12px !important;
            }


            /* =========================================================
                       QUICK ACTIONS
                    ========================================================= */

            .quick-actions {
                display: flex;
                flex-direction: column;
                gap: 10px;
                margin-top: 20px;
            }

            .quick-action {
                min-height: 52px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 17px;
                border: 1px solid #d7e0eb;
                border-radius: 9px;
                background: white;
                color: #14233e;
                font-size: 12px;
                font-weight: 700;
                text-decoration: none;
            }

                .quick-action:hover {
                    border-color: #8ddde6;
                    background: #f8feff;
                }

                .quick-action.primary {
                    border-color: #8ddde6;
                    background: #eefbfc;
                }

            .quick-arrow {
                color: #00b2c7;
                font-size: 17px;
            }

            .draft-count {
                padding: 4px 7px;
                border-radius: 999px;
                background: #f1f4f8;
                color: #6a7b94;
                font-size: 10px;
            }

            .profile-update {
                display: inline-block;
                margin-top: 18px;
                color: #00abc0;
                font-size: 11px;
                font-weight: 700;
                text-decoration: none;
            }


            /* =========================================================
                       RESPONSIVE
                    ========================================================= */

            @@media(max-width:1150px) {

                .stats-grid {
                    grid-template-columns: repeat(2,1fr);
                }

                .dashboard-grid {
                    grid-template-columns: 1fr;
                }
            }

            @@media(max-width:800px) {

                .sidebar {
                    position: relative;
                    width: 100%;
                }

                .main {
                    margin-left: 0;
                    padding: 25px 20px;
                }

                .producer-account {
                    margin-top: 30px;
                }
            }

            @@media(max-width:560px) {

                .stats-grid {
                    grid-template-columns: 1fr;
                }

                .welcome h1 {
                    font-size: 25px;
                }
            }

    </style>

</head>


<body>


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="sidebar">


        <div class="brand">

            <div class="brand-icon">
                R
            </div>

            <div>

                <div class="brand-name">
                    R.E.S.K
                </div>

                <div class="brand-subtitle">
                    SOFTWARE STUDIO
                </div>

            </div>

        </div>


        <div class="nav-label">
            PROPOSAL WORKSPACE
        </div>


        <nav class="sidebar-nav">


            <a asp-controller="Producer"
               asp-action="Index"
               class="sidebar-link active">

                Dashboard

            </a>


            <a asp-controller="Producer"
               asp-action="Guidelines"
               class="sidebar-link">

                New proposal

            </a>


            <a asp-controller="Producer"
               asp-action="MyProposals"
               class="sidebar-link">

                My proposals

            </a>


            <a href="#"
               class="sidebar-link">

                Drafts

            </a>


            <a asp-controller="Producer"
               asp-action="Guidelines"
               class="sidebar-link">

                Guidelines

            </a>


            <a href="#"
               class="sidebar-link">

                Settings

            </a>


        </nav>


        <!-- =====================================================
             LOGGED-IN PRODUCER
        ====================================================== -->

        <div class="producer-account"
             id="producerAccount">


            <div class="profile-menu">


                <a href="#"
                   class="profile-menu-link">

                    Account settings

                </a>


                <div class="menu-divider"></div>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="logout-button">

                        Log out

                    </button>

                </form>


            </div>


            <button type="button"
                    class="producer-profile"
                    id="producerProfileButton"
                    aria-expanded="false">


                <div class="producer-avatar">

                    @initial

                </div>


                <div class="producer-profile-text">


                    <div class="producer-name"
                         title="@producerUsername">

                        @producerUsername

                    </div>


                    <div class="producer-role">

                        Community Producer

                    </div>


                </div>


            </button>


        </div>


    </aside>



    <!-- =========================================================
         MAIN DASHBOARD
    ========================================================== -->

    <main class="main">


        <div class="dashboard">


            <!-- =================================================
                 WELCOME
            ================================================== -->

            <section class="welcome">


                <h1>
                    Welcome back, @producerUsername
                </h1>


                <p>
                    Track your proposals, continue drafts and start a new programme submission.
                </p>


            </section>



            <!-- =================================================
                 STATISTICS - EVERYTHING STARTS AT ZERO
            ================================================== -->

            <section class="stats-grid">


                <article class="stat-card">

                    <div class="stat-title">
                        MY PROPOSALS
                    </div>

                    <div class="stat-content">

                        <div class="stat-number">
                            0
                        </div>

                        <div class="stat-text">
                            total submissions
                        </div>

                    </div>

                </article>



                <article class="stat-card">

                    <div class="stat-title">
                        IN REVIEW
                    </div>

                    <div class="stat-content">

                        <div class="stat-number">
                            0
                        </div>

                        <div class="stat-text review">
                            Awaiting feedback
                        </div>

                    </div>

                </article>



                <article class="stat-card">

                    <div class="stat-title">
                        APPROVED
                    </div>

                    <div class="stat-content">

                        <div class="stat-number">
                            0
                        </div>

                        <div class="stat-text approved">
                            Ready for next steps
                        </div>

                    </div>

                </article>



                <article class="stat-card">

                    <div class="stat-title">
                        DRAFTS
                    </div>

                    <div class="stat-content">

                        <div class="stat-number">
                            0
                        </div>

                        <div class="stat-text">
                            Continue editing
                        </div>

                    </div>

                </article>


            </section>



            <!-- =================================================
                 DASHBOARD CONTENT
            ================================================== -->

            <section class="dashboard-grid">


                <!-- LEFT -->

                <div class="left-column">


                    <!-- CURRENT PROPOSAL -->

                    <article class="panel panel-padding">


                        <div class="panel-title">
                            Current proposal
                        </div>


                        <div class="panel-subtitle">
                            Your most recently updated submission
                        </div>


                        <div class="current-proposal">


                            <div class="empty-title">

                                No proposals yet

                            </div>


                            <div class="empty-text">

                                You have not created a programme proposal yet.

                                <br />

                                Start your first proposal when you are ready.

                            </div>


                            <a asp-controller="Producer"
                               asp-action="Guidelines"
                               class="outline-button">

                                New proposal

                            </a>


                        </div>


                    </article>



                    <!-- =================================================
                         RECENT PROPOSALS
                    ================================================== -->

                    <article class="panel">


                        <div class="recent-header">


                            <div class="panel-title">

                                My recent proposals

                            </div>


                            <div class="panel-subtitle">

                                Recent submissions and their current status

                            </div>


                        </div>


                        <div class="proposal-table-wrap">


                            <table class="proposal-table">


                                <thead>

                                    <tr>

                                        <th>PROGRAMME</th>

                                        <th>UPDATED</th>

                                        <th>STATUS</th>

                                        <th>ACTION</th>

                                    </tr>

                                </thead>


                                <tbody>


                                    <tr>

                                        <td colspan="4"
                                            class="empty-table">

                                            No proposals have been submitted yet.

                                        </td>

                                    </tr>


                                </tbody>


                            </table>


                        </div>


                    </article>


                </div>



                <!-- =================================================
                     RIGHT COLUMN
                ================================================== -->

                <div class="right-column">


                    <!-- NEXT ACTION -->

                    <article class="panel panel-padding">


                        <div class="panel-title">

                            Next action

                        </div>


                        <div class="panel-subtitle">

                            What you need to do next

                        </div>


                        <div class="info-box">


                            <div class="info-icon">

                                i

                            </div>


                            <div>


                                <div class="info-title">

                                    Create your first proposal

                                </div>


                                <div class="info-description">

                                    You currently have no proposals.

                                    <br />

                                    Start a new programme submission to begin.

                                </div>


                                <a asp-controller="Producer"
                                   asp-action="Guidelines"
                                   class="status-details">

                                    Start proposal

                                </a>


                            </div>


                        </div>


                    </article>



                    <!-- QUICK ACTIONS -->

                    <article class="panel panel-padding">


                        <div class="panel-title">

                            Quick actions

                        </div>


                        <div class="panel-subtitle">

                            Continue your proposal work

                        </div>


                        <div class="quick-actions">


                            <a asp-controller="Producer"
                               asp-action="Guidelines"
                               class="quick-action primary">


                                <span>
                                    Start a new proposal
                                </span>


                                <span class="quick-arrow">
                                    ›
                                </span>


                            </a>



                            <a href="#"
                               class="quick-action">


                                <span>
                                    Continue saved drafts
                                </span>


                                <span class="draft-count">
                                    0 drafts
                                </span>


                            </a>



                            <a asp-controller="Producer"
                               asp-action="Guidelines"
                               class="quick-action">


                                <span>
                                    Read proposal guidelines
                                </span>


                                <span class="quick-arrow">
                                    ›
                                </span>


                            </a>


                        </div>


                        <a href="#"
                           class="profile-update">

                            Update producer profile

                        </a>


                    </article>


                </div>


            </section>


        </div>


    </main>



    <!-- =========================================================
         PROFILE MENU SCRIPT
    ========================================================== -->

    <script>

            const producerAccount =
                document.getElementById("producerAccount");

            const producerProfileButton =
                document.getElementById("producerProfileButton");


            producerProfileButton.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                    producerAccount.classList.toggle("open");

                    producerProfileButton.setAttribute(
                        "aria-expanded",
                        producerAccount.classList.contains("open")
                            ? "true"
                            : "false"
                    );

                }
            );


            document.addEventListener(
                "click",
                function (event) {

                    if (!producerAccount.contains(event.target)) {

                        producerAccount.classList.remove("open");

                        producerProfileButton.setAttribute(
                            "aria-expanded",
                            "false"
                        );

                    }

                }
            );


            document.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {

                        producerAccount.classList.remove("open");

                        producerProfileButton.setAttribute(
                            "aria-expanded",
                            "false"
                        );

                    }

                }
            );

    </script>


</body>

</html>