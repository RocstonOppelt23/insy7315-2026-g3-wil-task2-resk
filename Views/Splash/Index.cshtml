@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>R.E.S.K Software Studio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
        }

        body {
            overflow: hidden;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #0D172B;
        }

        /* ==============================
           SPLASH SCREEN
        ============================== */

        .splash-screen {
            width: 100vw;
            height: 100vh;

            display: flex;
            flex-direction: column;

            justify-content: center;
            align-items: center;

            background: #0D172B;
        }

        /* ==============================
           R.E.S.K LOGO
        ============================== */

        .resk-logo {
            display: flex;
            align-items: center;
            gap: 14px;

            animation: logoEnter 0.8s ease-out;
        }

        /* Cyan R square */

        .logo-box {
            width: 64px;
            height: 64px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 2px solid #12B9CB;
            border-radius: 16px;

            color: #12B9CB;

            font-size: 29px;
            font-weight: 500;

            background: rgba(18, 185, 203, 0.04);
        }

        /* Right side of logo */

        .logo-text {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .logo-name {
            color: #FFFFFF;

            font-size: 25px;
            font-weight: 800;

            letter-spacing: 1px;

            line-height: 1;
        }

        .logo-subtitle {
            margin-top: 9px;

            color: #FFFFFF;

            font-size: 10px;
            font-weight: 600;

            letter-spacing: 0.1px;
        }

        /* ==============================
           LOADER
        ============================== */

        .loader {
            width: 42px;
            height: 42px;

            margin-top: 55px;

            border: 4px solid rgba(255, 255, 255, 0.15);

            border-top-color: #12B9CB;

            border-radius: 50%;

            animation: spin 0.8s linear infinite;
        }

        .loading-text {
            margin-top: 16px;

            color: rgba(255, 255, 255, 0.65);

            font-size: 11px;
            font-weight: 600;

            letter-spacing: 3px;
        }

        /* ==============================
           ANIMATIONS
        ============================== */

        @@keyframes spin {

            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        @@keyframes logoEnter {

            0% {
                opacity: 0;
                transform: translateY(15px) scale(0.95);
            }

            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ==============================
           MOBILE
        ============================== */

        @@media (max-width: 600px) {

            .logo-box {
                width: 58px;
                height: 58px;

                font-size: 27px;
            }

            .logo-name {
                font-size: 23px;
            }

            .logo-subtitle {
                font-size: 9px;
            }

            .loader {
                margin-top: 45px;
            }
        }

    </style>
</head>


<body>

    <main class="splash-screen">

        <!-- =========================
             MANUALLY CODED R.E.S.K LOGO
        ========================== -->

        <div class="resk-logo">

            <div class="logo-box">
                R
            </div>

            <div class="logo-text">

                <div class="logo-name">
                    R.E.S.K
                </div>

                <div class="logo-subtitle">
                    SOFTWARE STUDIO
                </div>

            </div>

        </div>


        <!-- =========================
             LOADING SPINNER
        ========================== -->

        <div class="loader"></div>

        <div class="loading-text">
            LOADING
        </div>

    </main>


    <!-- =============================
         5 SECOND REDIRECT
    ============================== -->

    <script>

        setTimeout(function () {

            window.location.replace('/Account/Login');

        }, 5000);

    </script>

</body>
</html>