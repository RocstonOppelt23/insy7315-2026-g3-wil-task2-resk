@{
    var adminName = ViewData["AdminName"] as string ?? "Admin User";
    var adminInitials = ViewData["AdminInitials"] as string ?? "AD";
    var message = TempData["AdminMessage"] as string;
    var error = TempData["AdminError"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - R.E.S.K</title>

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html, body { min-height: 100%; }
        body { font-family: Inter, "Segoe UI", Arial, sans-serif; background: #f4f7fb; color: #13223c; }
        button, input, select, textarea, a { font-family: inherit; }

        /* ===== PAGE FADE ===== */
        .main { animation: pageFadeIn 0.4s ease-out both; }
        body.page-leaving .main { animation: pageFadeOut 0.18s ease-in both; }
        @@keyframes pageFadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
        @@keyframes pageFadeOut { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(-4px); } }
        @@media (prefers-reduced-motion: reduce) { .main, body.page-leaving .main { animation: none; } }

        /* ===== SIDEBAR ===== */
        .sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 260px; display: flex; flex-direction: column; background: #0c1a33; color: white; padding: 36px 20px 38px; z-index: 100; overflow-y: auto; }
        .brand { display: flex; align-items: center; gap: 15px; padding-left: 13px; margin-bottom: 42px; }
        .brand-icon { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; border: 2px solid #00b9d0; border-radius: 17px; color: #00bfd7; font-size: 28px; font-weight: 700; }
        .brand-name { color: white; font-size: 24px; font-weight: 800; letter-spacing: 1.5px; }
        .brand-subtitle { margin-top: 5px; color: #d3dae7; font-size: 9px; }
        .nav-label { margin: 0 12px 8px; color: #72809a; font-size: 10px; font-weight: 800; }
        .sidebar nav { display: flex !important; flex-direction: column !important; gap: 8px !important; margin: 0 !important; padding: 0 !important; list-style: none !important; }
        .sidebar nav ul, .sidebar nav li { display: block; margin: 0; padding: 0; list-style: none; }
        .sidebar nav a { display: flex !important; align-items: center !important; min-height: 43px; padding: 0 32px !important; border-radius: 10px; color: #b9c2d1 !important; font-size: 14px !important; font-weight: 500; text-decoration: none !important; background: transparent; transition: 0.2s; }
        .sidebar nav a:hover { color: #ffffff !important; background: rgba(255,255,255,0.05); transform: translateX(2px); }
        .sidebar nav a[aria-current="page"] { background: #142a4b !important; color: #ffffff !important; font-weight: 700 !important; }

        /* ===== ADMIN ACCOUNT ===== */
        .admin-account { position: relative; margin-top: auto; padding: 0 8px; }
        .admin-profile { width: 100%; display: flex; align-items: center; gap: 11px; padding: 12px 14px; border: none; border-radius: 11px; background: #142a4b; color: white; cursor: pointer; text-align: left; }
        .admin-profile:hover { background: #193456; }
        .admin-initials { width: 34px; flex-shrink: 0; color: #12c4da; font-size: 13px; font-weight: 800; }
        .admin-text { min-width: 0; flex: 1; }
        .admin-name { overflow: hidden; color: white; font-size: 13px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
        .admin-role { margin-top: 4px; color: #b5c0d1; font-size: 10px; }
        .account-menu { position: absolute; left: 8px; right: 8px; bottom: calc(100% + 9px); padding: 7px; border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; background: #142a4b; box-shadow: 0 18px 35px rgba(0,0,0,0.25); opacity: 0; visibility: hidden; transform: translateY(8px); transition: 0.2s; }
        .admin-account.open .account-menu { opacity: 1; visibility: visible; transform: translateY(0); }
        .logout-button { width: 100%; display: block; padding: 10px 11px; border: none; border-radius: 7px; background: transparent; color: #ff9e9e; font-size: 12px; font-weight: 600; text-align: left; cursor: pointer; }
        .logout-button:hover { background: rgba(255,255,255,0.06); }

        /* ===== MAIN ===== */
        .main { min-height: 100vh; margin-left: 260px; padding: 28px 52px 38px; }
        .page { width: 100%; max-width: 1070px; margin: 0 auto; }
        .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
        .page-header h1 { color: #14233e; font-size: 31px; line-height: 1.2; font-weight: 800; }
        .page-header p { margin-top: 8px; color: #697a96; font-size: 14px; }
        .header-actions { display: flex; flex-shrink: 0; gap: 16px; }

        .primary-button, .secondary-button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 24px; border-radius: 8px; font-size: 13px; font-weight: 800; text-decoration: none; white-space: nowrap; cursor: pointer; transition: background 0.2s, border-color 0.2s; }
        .primary-button { border: none; background: #12b8ce; color: white; }
        .primary-button:hover { background: #0faabd; }
        .secondary-button { min-width: 124px; border: 1px solid #d3dce8; background: white; color: #14233e; }
        .secondary-button:hover { border-color: #b9c6d8; background: #f8fafc; }

        .notice { margin-bottom: 18px; padding: 12px 16px; border-radius: 10px; font-size: 12px; font-weight: 600; }
        .notice-success { border: 1px solid #b9e6d0; background: #eefaf4; color: #1f7a52; }
        .notice-error { border: 1px solid #f0c2c5; background: #fff7f7; color: #b84048; }

        .card { padding: 26px 27px; border: 1px solid #d9e1ec; border-radius: 13px; background: white; }
        .card + .card { margin-top: 18px; }
        .card-title { color: #14233e; font-size: 18px; font-weight: 800; }
        .card-subtitle { margin-top: 7px; color: #6d7e99; font-size: 12px; }
        .section-label { display: block; margin-bottom: 10px; color: #5d6d87; font-size: 11px; font-weight: 800; text-transform: uppercase; }

        .input { width: 100%; height: 42px; padding: 0 14px; border: 1px solid #cfdae8; border-radius: 8px; outline: none; background: white; color: #14233e; font-size: 13px; }
        textarea.input { height: auto; min-height: 150px; padding: 13px 14px; line-height: 1.6; resize: vertical; }
        .input:focus { border-color: #12b8ce; box-shadow: 0 0 0 3px rgba(18,184,206,0.12); }

        .pill { display: inline-block; padding: 5px 13px; border-radius: 999px; font-size: 11px; font-weight: 800; white-space: nowrap; }
        .pill-assign { background: #fdf1d6; color: #b07200; }
        .pill-review { background: #fff4dc; color: #c77c00; }
        .pill-approved { background: #e3f5ec; color: #1f8a5c; }
        .pill-changes, .pill-rejected { background: #fde7e8; color: #c9444d; }
        .pill-submitted { background: #eef2f7; color: #5b6b85; }

        .summary-box { padding: 20px 22px; border: 1px solid #dde4ee; border-radius: 11px; background: #f7f9fc; }
        .summary-box h2 { color: #14233e; font-size: 17px; font-weight: 800; }
        .summary-box p { margin-top: 8px; color: #6d7e99; font-size: 12px; }

        @@media (max-width: 800px) {
            .sidebar { position: relative; width: 100%; }
            .main { margin-left: 0; padding: 25px 20px; }
            .admin-account { margin-top: 30px; }
            .page-header { flex-direction: column; align-items: stretch; }
            .header-actions { flex-wrap: wrap; }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ===================== SIDEBAR ===================== -->
    <aside class="sidebar">

        <div class="brand">
            <div class="brand-icon">R</div>
            <div>
                <div class="brand-name">R.E.S.K</div>
                <div class="brand-subtitle">SOFTWARE STUDIO</div>
            </div>
        </div>

        <div class="nav-label">MANAGEMENT</div>

        <!--NAV-START-->
        <nav class="navigation">

            <a class="nav-link" href="/Admin">
                Dashboard
            </a>

            <a class="nav-link" href="/Admin/Proposals" aria-current="page">
                Proposals
            </a>

            <a class="nav-link"
               asp-controller="Users"
               asp-action="Index">
                Users
            </a>

            <a class="nav-link" href="#">
                Categories
            </a>

            <a class="nav-link" href="#">
                Reports
            </a>

            <a class="nav-link" href="#">
                Roles &amp; permissions
            </a>

            <a class="nav-link" href="#">
                Audit log
            </a>

            <a class="nav-link" href="#">
                System settings
            </a>

        </nav>
        <!--NAV-END-->

        <div class="admin-account" id="adminAccount">

            <div class="account-menu">
                <form method="post" action="/Producer/Logout" style="margin:0;">
                    <button type="submit" class="logout-button">Log out</button>
                </form>
            </div>

            <button type="button" class="admin-profile" id="adminProfileButton" aria-expanded="false">
                <div class="admin-initials">@adminInitials</div>
                <div class="admin-text">
                    <div class="admin-name" title="@adminName">@adminName</div>
                    <div class="admin-role">Station Management</div>
                </div>
            </button>

        </div>

    </aside>

    <!-- ===================== MAIN ===================== -->
    <main class="main">
        <div class="page">

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="notice notice-success" role="status">@message</div>
            }

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="notice notice-error" role="alert">@error</div>
            }

            @RenderBody()

        </div>
    </main>

    <!-- ===================== SCRIPTS ===================== -->
    <script>
        (function () {

            // ---------- Fade out when following a link to another page ----------
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            document.addEventListener("click", function (event) {
                const link = event.target.closest("a[href]");
                if (!link || reduceMotion) { return; }

                const href = link.getAttribute("href");

                if (!href ||
                    href.startsWith("#") ||
                    link.target === "_blank" ||
                    link.hasAttribute("download") ||
                    link.origin !== window.location.origin ||
                    event.button !== 0 ||
                    event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                    return;
                }

                event.preventDefault();
                document.body.classList.add("page-leaving");

                setTimeout(function () {
                    window.location.href = link.href;
                }, 170);
            });

            window.addEventListener("pageshow", function () {
                document.body.classList.remove("page-leaving");
            });

            // ---------- Account menu (Log out) ----------
            const account = document.getElementById("adminAccount");
            const button = document.getElementById("adminProfileButton");

            button.addEventListener("click", function (event) {
                event.stopPropagation();
                const isOpen = account.classList.toggle("open");
                button.setAttribute("aria-expanded", isOpen ? "true" : "false");
            });

            document.addEventListener("click", function (event) {
                if (!account.contains(event.target)) {
                    account.classList.remove("open");
                    button.setAttribute("aria-expanded", "false");
                }
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    account.classList.remove("open");
                    button.setAttribute("aria-expanded", "false");
                }
            });

        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>