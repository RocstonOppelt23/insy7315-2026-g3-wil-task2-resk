@{
    Layout = null;
    ViewData["Title"] = "Create Account";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Create Account | R.E.S.K</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f5f7fa;
            color: #0d172b;
        }


        /* =========================================
           PAGE
        ========================================= */

        .register-page {
            min-height: 100vh;

            display: grid;

            grid-template-columns: 1fr 1fr;
        }


        /* =========================================
           LEFT PANEL
        ========================================= */

        .left-panel {
            position: relative;

            overflow: hidden;

            display: flex;

            align-items: center;
            justify-content: center;

            padding: 70px;

            background: #0d172b;
        }

        .left-panel::before {
            content: "";

            position: absolute;

            width: 500px;
            height: 500px;

            top: -260px;
            left: -220px;

            border-radius: 50%;

            background: rgba(18, 185, 203, 0.07);
        }

        .left-panel::after {
            content: "";

            position: absolute;

            width: 450px;
            height: 450px;

            bottom: -250px;
            right: -200px;

            border-radius: 50%;

            background: rgba(18, 185, 203, 0.05);
        }

        .left-content {
            position: relative;

            z-index: 2;

            width: 100%;

            max-width: 520px;
        }


        /* =========================================
           R.E.S.K LOGO
        ========================================= */

        .resk-logo {
            display: flex;

            align-items: center;

            gap: 14px;
        }

        .logo-box {
            width: 64px;
            height: 64px;

            display: flex;

            align-items: center;
            justify-content: center;

            border: 2px solid #12b9cb;

            border-radius: 16px;

            background: rgba(18, 185, 203, 0.04);

            color: #12b9cb;

            font-size: 29px;

            font-weight: 500;
        }

        .logo-copy {
            display: flex;

            flex-direction: column;
        }

        .logo-name {
            color: white;

            font-size: 25px;

            font-weight: 800;

            letter-spacing: 1px;

            line-height: 1;
        }

        .logo-subtitle {
            margin-top: 9px;

            color: white;

            font-size: 10px;

            font-weight: 600;
        }


        /* =========================================
           LEFT CONTENT
        ========================================= */

        .system-description {
            margin-top: 70px;
        }

        .system-description h1 {
            max-width: 500px;

            color: white;

            font-size: 43px;

            line-height: 1.15;

            font-weight: 750;
        }

        .accent {
            color: #12b9cb;
        }

        .system-description p {
            max-width: 450px;

            margin-top: 22px;

            color: #aeb8c8;

            font-size: 15px;

            line-height: 1.7;
        }


        /* =========================================
           RIGHT SIDE
        ========================================= */

        .right-panel {
            display: flex;

            align-items: center;
            justify-content: center;

            padding: 45px;

            background: #f5f7fa;
        }

        .register-container {
            width: 100%;

            max-width: 430px;
        }


        /* =========================================
           HEADER
        ========================================= */

        .register-header {
            margin-bottom: 30px;
        }

        .register-header h2 {
            margin-bottom: 10px;

            color: #0d172b;

            font-size: 34px;

            font-weight: 750;
        }

        .register-header p {
            color: #778196;

            font-size: 14px;

            line-height: 1.5;
        }


        /* =========================================
           ERRORS
        ========================================= */

        .error-message {
            margin-bottom: 20px;

            padding: 14px 16px;

            border: 1px solid #fecaca;

            border-radius: 9px;

            background: #fef2f2;

            color: #b91c1c;

            font-size: 13px;

            line-height: 1.5;
        }

        .error-message ul {
            margin: 0;

            padding-left: 18px;
        }


        /* =========================================
           FORM
        ========================================= */

        .form-group {
            margin-bottom: 19px;
        }

        .form-label {
            display: block;

            margin-bottom: 8px;

            color: #263247;

            font-size: 13px;

            font-weight: 650;
        }

        .form-control {
            width: 100%;

            height: 52px;

            padding: 0 15px;

            border: 1px solid #d7dde7;

            border-radius: 9px;

            outline: none;

            background: white;

            color: #0d172b;

            font-family: inherit;

            font-size: 14px;

            transition: 0.2s ease;
        }

        .form-control::placeholder {
            color: #9ca6b6;
        }

        .form-control:focus {
            border-color: #12b9cb;

            box-shadow:
                0 0 0 3px rgba(18, 185, 203, 0.12);
        }


        /* =========================================
           PASSWORD
        ========================================= */

        .password-container {
            position: relative;
        }

        .password-container .form-control {
            padding-right: 75px;
        }

        .show-password {
            position: absolute;

            top: 50%;
            right: 15px;

            transform: translateY(-50%);

            border: 0;

            background: transparent;

            color: #0b9eaf;

            font-family: inherit;

            font-size: 12px;

            font-weight: 700;

            cursor: pointer;
        }


        /* =========================================
           PASSWORD REQUIREMENTS
        ========================================= */

        .password-requirements {
            margin-top: 9px;

            color: #778196;

            font-size: 11px;

            line-height: 1.6;
        }


        /* =========================================
           REGISTER BUTTON
        ========================================= */

        .register-button {
            width: 100%;

            height: 52px;

            margin-top: 5px;

            border: none;

            border-radius: 9px;

            background: #12b9cb;

            color: white;

            font-family: inherit;

            font-size: 14px;

            font-weight: 700;

            cursor: pointer;

            transition:
                background 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .register-button:hover {
            background: #0fa7b8;

            transform: translateY(-1px);

            box-shadow:
                0 8px 20px rgba(18, 185, 203, 0.22);
        }


        /* =========================================
           LOGIN LINK
        ========================================= */

        .login-section {
            margin-top: 25px;

            padding-top: 23px;

            border-top: 1px solid #e1e5eb;

            text-align: center;
        }

        .login-section p {
            color: #778196;

            font-size: 13px;
        }

        .login-link {
            color: #0b9eaf;

            font-weight: 700;

            text-decoration: none;
        }

        .login-link:hover {
            text-decoration: underline;
        }


        /* =========================================
           FOOTER
        ========================================= */

        .footer-text {
            margin-top: 30px;

            text-align: center;

            color: #9aa3b2;

            font-size: 11px;
        }


        /* =========================================
           MOBILE
        ========================================= */

        @@media (max-width: 850px) {

            .register-page {
                display: block;
            }

            .left-panel {
                display: none;
            }

            .right-panel {
                min-height: 100vh;

                padding: 30px 22px;
            }
        }

    </style>
</head>


<body>

<div class="register-page">


    <!-- =========================================
         LEFT SIDE
    ========================================== -->

    <section class="left-panel">

        <div class="left-content">


            <!-- LOGO -->

            <div class="resk-logo">

                <div class="logo-box">
                    R
                </div>

                <div class="logo-copy">

                    <div class="logo-name">
                        R.E.S.K
                    </div>

                    <div class="logo-subtitle">
                        SOFTWARE STUDIO
                    </div>

                </div>

            </div>


            <!-- DESCRIPTION -->

            <div class="system-description">

                <h1>

                    Join the Cape Town TV

                    <span class="accent">
                        Workflow
                    </span>

                    Management System

                </h1>


                <p>
                    Create your producer account to submit,
                    manage and track programme proposals
                    through the Cape Town TV workflow.
                </p>

            </div>

        </div>

    </section>



    <!-- =========================================
         RIGHT SIDE
    ========================================== -->

    <main class="right-panel">

        <div class="register-container">


            <!-- HEADER -->

            <header class="register-header">

                <h2>
                    Create account
                </h2>

                <p>
                    Register for access to the Cape Town TV
                    Workflow Management System.
                </p>

            </header>



            <!-- SINGLE ERROR -->

            @if (ViewBag.Error != null)
            {
                <div class="error-message"
                     role="alert">

                    @ViewBag.Error

                </div>
            }



            <!-- IDENTITY ERRORS -->

            @if (ViewBag.Errors != null)
            {
                <div class="error-message"
                     role="alert">

                    <ul>

                        @foreach (var error in ViewBag.Errors)
                        {
                            <li>
                                @error
                            </li>
                        }

                    </ul>

                </div>
            }



            <!-- =================================
                 REGISTER FORM
            ================================== -->

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- EMAIL -->

                <div class="form-group">

                    <label for="email"
                           class="form-label">

                        Email address

                    </label>

                    <input id="email"
                           name="email"
                           type="email"
                           class="form-control"
                           placeholder="name@capetowntv.org"
                           autocomplete="email"
                           required />

                </div>



                <!-- PASSWORD -->

                <div class="form-group">

                    <label for="password"
                           class="form-label">

                        Password

                    </label>

                    <div class="password-container">

                        <input id="password"
                               name="password"
                               type="password"
                               class="form-control"
                               placeholder="Create a password"
                               autocomplete="new-password"
                               required />

                        <button id="passwordToggle"
                                type="button"
                                class="show-password">

                            Show

                        </button>

                    </div>


                    <div class="password-requirements">

                        Minimum 8 characters with uppercase,
                        lowercase, number and special character.

                    </div>

                </div>



                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label for="confirmPassword"
                           class="form-label">

                        Confirm password

                    </label>

                    <div class="password-container">

                        <input id="confirmPassword"
                               name="confirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm your password"
                               autocomplete="new-password"
                               required />

                        <button id="confirmPasswordToggle"
                                type="button"
                                class="show-password">

                            Show

                        </button>

                    </div>

                </div>



                <!-- CREATE ACCOUNT -->

                <button type="submit"
                        class="register-button">

                    Create account

                </button>



                <!-- BACK TO LOGIN -->

                <div class="login-section">

                    <p>

                        Already have an account?

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="login-link">

                            Sign in

                        </a>

                    </p>

                </div>

            </form>


            <div class="footer-text">

                R.E.S.K Software Studio • Cape Town TV

            </div>

        </div>

    </main>

</div>



<script>

    const password =
        document.getElementById("password");

    const confirmPassword =
        document.getElementById("confirmPassword");

    const passwordToggle =
        document.getElementById("passwordToggle");

    const confirmPasswordToggle =
        document.getElementById("confirmPasswordToggle");


    // PASSWORD SHOW / HIDE

    passwordToggle.addEventListener(
        "click",
        function () {

            if (password.type === "password") {

                password.type = "text";

                passwordToggle.textContent = "Hide";

            }
            else {

                password.type = "password";

                passwordToggle.textContent = "Show";

            }

        });


    // CONFIRM PASSWORD SHOW / HIDE

    confirmPasswordToggle.addEventListener(
        "click",
        function () {

            if (confirmPassword.type === "password") {

                confirmPassword.type = "text";

                confirmPasswordToggle.textContent = "Hide";

            }
            else {

                confirmPassword.type = "password";

                confirmPasswordToggle.textContent = "Show";

            }

        });

</script>

</body>
</html>