@{
    Layout = null;
    ViewData["Title"] = "Reset Instructions Sent";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Reset Instructions Sent | R.E.S.K Software Studio</title>

    <style>

        /* =========================================================
           RESET
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
        }

        html {
            background: #f5f7fa;
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;

            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            background: #f5f7fa;
        }


        /* =========================================================
           PAGE
        ========================================================= */

        .confirmation-page {
            width: 100%;
            min-height: 100vh;

            display: grid;
            grid-template-columns: 46% 54%;

            background: #f5f7fa;

            opacity: 0;

            animation:
                pageEnter
                0.75s
                cubic-bezier(0.22, 1, 0.36, 1)
                forwards;

            transition:
                opacity 0.5s ease,
                transform 0.5s ease;
        }

        @@keyframes pageEnter {

            from {
                opacity: 0;

                transform:
                    translateY(8px)
                    scale(0.995);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);
            }
        }

        .confirmation-page.page-leaving {
            opacity: 0;

            transform:
                translateX(15px);
        }


        /* =========================================================
           LEFT BRAND PANEL
        ========================================================= */

        .brand-panel {
            position: relative;

            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow: hidden;

            padding: 60px;

            background: #0d172b;
        }

        .brand-panel::before {
            content: "";

            position: absolute;

            width: 550px;
            height: 550px;

            left: 50%;
            top: 50%;

            transform:
                translate(-50%, -50%);

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(18,185,203,0.065) 0%,
                    rgba(18,185,203,0.020) 40%,
                    transparent 70%
                );

            pointer-events: none;
        }


        /* =========================================================
           MOVING CIRCLES
        ========================================================= */

        .gravity-circle {
            position: absolute;

            display: block;

            border-radius: 50%;

            pointer-events: none;

            will-change: transform;

            z-index: 1;
        }


        .circle-one {
            width: 250px;
            height: 250px;

            top: 3%;
            left: 2%;

            background:
                rgba(18,185,203,0.025);

            border:
                1px solid
                rgba(18,185,203,0.14);

            animation:
                gravitateOne
                10s
                ease-in-out
                infinite;
        }


        .circle-two {
            width: 190px;
            height: 190px;

            right: 5%;
            bottom: 6%;

            background:
                rgba(18,185,203,0.018);

            border:
                1px solid
                rgba(18,185,203,0.14);

            animation:
                gravitateTwo
                12s
                ease-in-out
                infinite;
        }


        .circle-three {
            width: 125px;
            height: 125px;

            top: 15%;
            right: 10%;

            background:
                rgba(18,185,203,0.018);

            border:
                1px solid
                rgba(18,185,203,0.16);

            animation:
                gravitateThree
                9s
                ease-in-out
                infinite;
        }


        .circle-four {
            width: 80px;
            height: 80px;

            left: 13%;
            bottom: 14%;

            background:
                rgba(18,185,203,0.025);

            border:
                1px solid
                rgba(18,185,203,0.15);

            animation:
                gravitateFour
                8s
                ease-in-out
                infinite;
        }


        .circle-five {
            width: 45px;
            height: 45px;

            left: 48%;
            top: 15%;

            background:
                rgba(18,185,203,0.035);

            border:
                1px solid
                rgba(18,185,203,0.18);

            animation:
                gravitateFive
                7s
                ease-in-out
                infinite;
        }


        /* =========================================================
           CIRCLE ANIMATIONS
        ========================================================= */

        @@keyframes gravitateOne {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            20% {
                transform:
                    translate3d(70px, 20px, 0)
                    scale(1.04);
            }

            40% {
                transform:
                    translate3d(110px, 90px, 0)
                    scale(0.97);
            }

            60% {
                transform:
                    translate3d(65px, 155px, 0)
                    scale(1.05);
            }

            80% {
                transform:
                    translate3d(-10px, 85px, 0)
                    scale(0.98);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        @@keyframes gravitateTwo {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            20% {
                transform:
                    translate3d(-65px, -25px, 0)
                    scale(1.04);
            }

            40% {
                transform:
                    translate3d(-115px, -90px, 0)
                    scale(0.97);
            }

            60% {
                transform:
                    translate3d(-70px, -150px, 0)
                    scale(1.05);
            }

            80% {
                transform:
                    translate3d(10px, -80px, 0)
                    scale(0.98);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        @@keyframes gravitateThree {

            0% {
                transform:
                    translate3d(0, 0, 0);
            }

            25% {
                transform:
                    translate3d(-65px, 35px, 0);
            }

            50% {
                transform:
                    translate3d(-100px, 115px, 0);
            }

            75% {
                transform:
                    translate3d(-25px, 165px, 0);
            }

            100% {
                transform:
                    translate3d(0, 0, 0);
            }
        }


        @@keyframes gravitateFour {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            25% {
                transform:
                    translate3d(55px, -35px, 0)
                    scale(1.08);
            }

            50% {
                transform:
                    translate3d(110px, -70px, 0)
                    scale(0.96);
            }

            75% {
                transform:
                    translate3d(50px, -125px, 0)
                    scale(1.05);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        @@keyframes gravitateFive {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            25% {
                transform:
                    translate3d(55px, 45px, 0)
                    scale(1.12);
            }

            50% {
                transform:
                    translate3d(20px, 100px, 0)
                    scale(0.94);
            }

            75% {
                transform:
                    translate3d(-45px, 55px, 0)
                    scale(1.08);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        /* =========================================================
           BRAND CONTENT
        ========================================================= */

        .brand-content {
            position: relative;

            z-index: 5;

            width: 100%;
            max-width: 460px;
        }


        /* =========================================================
           LOGO
        ========================================================= */

        .resk-logo {
            display: flex;
            align-items: center;

            gap: 18px;

            margin-bottom: 50px;
        }


        .logo-box {
            width: 68px;
            height: 68px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border:
                2px solid
                #12b9cb;

            border-radius: 16px;

            background:
                rgba(18,185,203,0.025);

            color: #12b9cb;

            font-size: 30px;
            font-weight: 500;

            animation:
                logoGlow
                3s
                ease-in-out
                infinite;
        }


        @@keyframes logoGlow {

            0%,
            100% {
                box-shadow:
                    0 0 0
                    rgba(18,185,203,0);
            }

            50% {
                box-shadow:
                    0 0 30px
                    rgba(18,185,203,0.15);
            }
        }


        .logo-name {
            color: #ffffff;

            font-size: 27px;
            font-weight: 800;

            letter-spacing: 1.5px;

            line-height: 1;
        }


        .logo-subtitle {
            margin-top: 8px;

            color:
                rgba(255,255,255,0.78);

            font-size: 10px;
            font-weight: 700;

            letter-spacing: 0.4px;
        }


        /* =========================================================
           BRAND TEXT
        ========================================================= */

        .brand-title {
            max-width: 430px;

            color: #ffffff;

            font-size: 37px;
            line-height: 1.2;

            font-weight: 700;

            letter-spacing: -0.5px;
        }


        .brand-description {
            max-width: 410px;

            margin-top: 20px;

            color:
                rgba(255,255,255,0.55);

            font-size: 14px;
            line-height: 1.8;
        }


        .brand-accent {
            width: 48px;
            height: 3px;

            margin-top: 30px;

            border-radius: 20px;

            background: #12b9cb;
        }


        /* =========================================================
           RIGHT PANEL
        ========================================================= */

        .content-panel {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding:
                60px
                80px;

            background: #f5f7fa;
        }


        .content-wrapper {
            width: 100%;
            max-width: 440px;
        }


        /* =========================================================
           SUCCESS ICON
        ========================================================= */

        .success-icon {
            position: relative;

            width: 76px;
            height: 76px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-bottom: 27px;

            border:
                2px solid
                rgba(18,185,203,0.32);

            border-radius: 50%;

            background:
                rgba(18,185,203,0.06);

            color: #12aabb;

            font-size: 32px;
            font-weight: 700;

            animation:
                successPulse
                2.5s
                ease-in-out
                infinite;
        }


        .success-icon::after {
            content: "";

            position: absolute;

            inset: -8px;

            border:
                1px solid
                rgba(18,185,203,0.10);

            border-radius: 50%;

            animation:
                ringPulse
                2.5s
                ease-in-out
                infinite;
        }


        @@keyframes successPulse {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.04);
            }
        }


        @@keyframes ringPulse {

            0%,
            100% {
                opacity: 0.4;
                transform: scale(0.95);
            }

            50% {
                opacity: 1;
                transform: scale(1.05);
            }
        }


        /* =========================================================
           TEXT
        ========================================================= */

        .confirmation-title {
            color: #0d172b;

            font-size: 34px;
            font-weight: 750;

            line-height: 1.2;

            letter-spacing: -0.7px;
        }


        .confirmation-description {
            margin-top: 15px;

            color: #7a8494;

            font-size: 14px;
            line-height: 1.75;
        }


        /* =========================================================
           MESSAGE
        ========================================================= */

        .confirmation-message {
            margin-top: 25px;

            padding:
                16px
                18px;

            border:
                1px solid
                rgba(18,185,203,0.16);

            border-radius: 10px;

            background:
                rgba(18,185,203,0.04);

            color: #596579;

            font-size: 13px;
            line-height: 1.7;
        }


        .confirmation-message strong {
            color: #263348;
        }


        /* =========================================================
           BUTTON
        ========================================================= */

        .signin-button {
            width: 100%;
            height: 52px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-top: 28px;

            border-radius: 10px;

            background: #12b9cb;

            color: #ffffff;

            font-size: 14px;
            font-weight: 700;

            text-decoration: none;

            box-shadow:
                0 7px 20px
                rgba(18,185,203,0.16);

            transition:
                background 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .signin-button:hover {
            background: #0fa9ba;

            color: #ffffff;

            transform:
                translateY(-2px);

            box-shadow:
                0 10px 24px
                rgba(18,185,203,0.22);
        }


        /* =========================================================
           TRY AGAIN
        ========================================================= */

        .try-again {
            margin-top: 23px;

            text-align: center;

            color: #7a8494;

            font-size: 13px;
        }


        .try-again-link {
            margin-left: 4px;

            color: #0ba8b9;

            font-weight: 700;

            text-decoration: none;
        }


        .try-again-link:hover {
            color: #087f8c;

            text-decoration: underline;
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        .confirmation-footer {
            margin-top: 36px;

            text-align: center;

            color: #a0a7b1;

            font-size: 10px;
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 1000px) {

            .confirmation-page {
                grid-template-columns:
                    42% 58%;
            }

            .brand-panel {
                padding: 45px;
            }

            .brand-title {
                font-size: 32px;
            }

            .content-panel {
                padding:
                    50px
                    55px;
            }
        }


        @@media (max-width: 780px) {

            .confirmation-page {
                display: block;
            }

            .brand-panel {
                min-height: 350px;

                padding:
                    45px
                    30px;
            }

            .resk-logo {
                margin-bottom: 28px;
            }

            .brand-title {
                font-size: 29px;
            }

            .content-panel {
                min-height: auto;

                padding:
                    55px
                    25px;
            }

            .circle-one {
                width: 170px;
                height: 170px;
            }

            .circle-two {
                width: 140px;
                height: 140px;
            }

            .circle-three {
                width: 90px;
                height: 90px;
            }
        }


        @@media (max-width: 480px) {

            .brand-panel {
                padding:
                    40px
                    22px;
            }

            .logo-box {
                width: 58px;
                height: 58px;

                font-size: 26px;
            }

            .logo-name {
                font-size: 23px;
            }

            .brand-title {
                font-size: 25px;
            }

            .content-panel {
                padding:
                    45px
                    20px;
            }

            .confirmation-title {
                font-size: 30px;
            }
        }

    </style>
</head>

<body>

<main id="confirmationPage"
      class="confirmation-page">


    <!-- =====================================================
         LEFT PANEL
    ====================================================== -->

    <section class="brand-panel">


        <!-- MOVING BACKGROUND CIRCLES -->

        <div class="gravity-circle circle-one"></div>

        <div class="gravity-circle circle-two"></div>

        <div class="gravity-circle circle-three"></div>

        <div class="gravity-circle circle-four"></div>

        <div class="gravity-circle circle-five"></div>


        <!-- BRAND CONTENT -->

        <div class="brand-content">


            <div class="resk-logo">


                <div class="logo-box">

                    R

                </div>


                <div>


                    <div class="logo-name">

                        R.E.S.K

                    </div>


                    <div class="logo-subtitle">

                        SOFTWARE STUDIO

                    </div>


                </div>


            </div>


            <h2 class="brand-title">

                Account recovery made simple

            </h2>


            <p class="brand-description">

                R.E.S.K helps keep your Cape Town TV production
                workflow secure while making account recovery
                straightforward.

            </p>


            <div class="brand-accent"></div>


        </div>


    </section>



    <!-- =====================================================
         RIGHT PANEL
    ====================================================== -->

    <section class="content-panel">


        <div class="content-wrapper">


            <!-- SUCCESS ICON -->

            <div class="success-icon">

                ✓

            </div>


            <!-- TITLE -->

            <h1 class="confirmation-title">

                Check your email

            </h1>


            <p class="confirmation-description">

                Your password reset request has been processed.

            </p>


            <!-- MESSAGE -->

            <div class="confirmation-message">

                @if (TempData["ResetMessage"] != null)
                {
                    <span>

                        @TempData["ResetMessage"]

                    </span>
                }
                else
                {
                    <span>

                        If an account exists for the email address
                        you entered, password reset instructions
                        will be sent to that address.

                    </span>
                }

                <br />
                <br />

                <strong>
                    Didn't receive anything?
                </strong>

                Check your spam or junk folder, or return to the
                password recovery screen and try again.

            </div>


            <!-- BACK TO LOGIN -->

            <a asp-controller="Account"
               asp-action="Login"
               class="signin-button transition-link">

                Back to sign in

            </a>


            <!-- TRY AGAIN -->

            <div class="try-again">

                Need to try another email?

                <a asp-controller="Account"
                   asp-action="ForgotPassword"
                   class="try-again-link transition-link">

                    Try again

                </a>

            </div>


            <!-- FOOTER -->

            <div class="confirmation-footer">

                R.E.S.K Software Studio · Cape Town TV

            </div>


        </div>


    </section>


</main>


<script>

    // ==========================================================
    // PAGE
    // ==========================================================

    const confirmationPage =
        document.getElementById(
            "confirmationPage"
        );


    // ==========================================================
    // PAGE TRANSITIONS
    // ==========================================================

    document
        .querySelectorAll(
            ".transition-link"
        )
        .forEach(
            function (link) {

                link.addEventListener(
                    "click",
                    function (event) {

                        if (
                            event.ctrlKey ||
                            event.metaKey ||
                            event.shiftKey ||
                            event.altKey
                        ) {
                            return;
                        }


                        event.preventDefault();


                        const destination =
                            link.href;


                        confirmationPage.classList.add(
                            "page-leaving"
                        );


                        setTimeout(
                            function () {

                                window.location.href =
                                    destination;

                            },
                            450
                        );

                    }
                );

            }
        );


    // ==========================================================
    // RESET WHEN USING BROWSER BACK
    // ==========================================================

    window.addEventListener(
        "pageshow",
        function () {

            confirmationPage.classList.remove(
                "page-leaving"
            );

        }
    );

</script>

</body>
</html>