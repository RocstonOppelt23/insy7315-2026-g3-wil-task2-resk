@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Sign In | R.E.S.K</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f5f7fa;
            color: #0d172b;
        }

        /* ==============================
           PAGE
        ============================== */

        .login-page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        /* ==============================
           LEFT PANEL
        ============================== */

        .left-panel {
            position: relative;
            overflow: hidden;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 70px;

            background: #0d172b;
        }

        .left-panel::before {
            content: "";
            position: absolute;

            width: 500px;
            height: 500px;

            top: -260px;
            left: -220px;

            border-radius: 50%;

            background: rgba(18, 185, 203, 0.07);
        }

        .left-panel::after {
            content: "";
            position: absolute;

            width: 450px;
            height: 450px;

            bottom: -250px;
            right: -200px;

            border-radius: 50%;

            background: rgba(18, 185, 203, 0.05);
        }

        .left-content {
            position: relative;
            z-index: 2;

            width: 100%;
            max-width: 520px;
        }

        /* ==============================
           MANUALLY CODED R.E.S.K LOGO
        ============================== */

        .resk-logo {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .logo-box {
            width: 64px;
            height: 64px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 2px solid #12b9cb;
            border-radius: 16px;

            background: rgba(18, 185, 203, 0.04);

            color: #12b9cb;

            font-size: 29px;
            font-weight: 500;
        }

        .logo-copy {
            display: flex;
            flex-direction: column;
        }

        .logo-name {
            color: #ffffff;

            font-size: 25px;
            font-weight: 800;

            letter-spacing: 1px;
            line-height: 1;
        }

        .logo-subtitle {
            margin-top: 9px;

            color: #ffffff;

            font-size: 10px;
            font-weight: 600;
        }

        /* ==============================
           LEFT CONTENT
        ============================== */

        .system-description {
            margin-top: 70px;
        }

        .system-description h1 {
            max-width: 500px;

            color: #ffffff;

            font-size: 43px;
            line-height: 1.15;

            font-weight: 750;
        }

        .accent {
            color: #12b9cb;
        }

        .system-description p {
            max-width: 450px;

            margin-top: 22px;

            color: #aeb8c8;

            font-size: 15px;
            line-height: 1.7;
        }

        /* ==============================
           RIGHT PANEL
        ============================== */

        .right-panel {
            display: flex;
            align-items: center;
            justify-content: center;

            padding: 50px;

            background: #f5f7fa;
        }

        .login-container {
            width: 100%;
            max-width: 430px;
        }

        /* ==============================
           HEADER
        ============================== */

        .login-header {
            margin-bottom: 35px;
        }

        .login-header h2 {
            margin-bottom: 10px;

            color: #0d172b;

            font-size: 34px;
            font-weight: 750;
        }

        .login-header p {
            color: #778196;

            font-size: 14px;
            line-height: 1.5;
        }

        /* ==============================
           ERROR
        ============================== */

        .error-message {
            margin-bottom: 22px;
            padding: 14px 16px;

            border: 1px solid #fecaca;
            border-radius: 9px;

            background: #fef2f2;

            color: #b91c1c;

            font-size: 13px;
            line-height: 1.5;
        }

        /* ==============================
           FORM
        ============================== */

        .form-group {
            margin-bottom: 22px;
        }

        .form-label {
            display: block;

            margin-bottom: 8px;

            color: #263247;

            font-size: 13px;
            font-weight: 650;
        }

        .form-control {
            width: 100%;
            height: 52px;

            padding: 0 15px;

            border: 1px solid #d7dde7;
            border-radius: 9px;

            outline: none;

            background: #ffffff;

            color: #0d172b;

            font-family: inherit;
            font-size: 14px;

            transition: border-color 0.2s ease,
                        box-shadow 0.2s ease;
        }

        .form-control::placeholder {
            color: #9ca6b6;
        }

        .form-control:focus {
            border-color: #12b9cb;

            box-shadow:
                0 0 0 3px rgba(18, 185, 203, 0.12);
        }

        /* ==============================
           PASSWORD
        ============================== */

        .password-container {
            position: relative;
        }

        .password-container .form-control {
            padding-right: 75px;
        }

        .show-password {
            position: absolute;

            top: 50%;
            right: 15px;

            transform: translateY(-50%);

            border: 0;
            outline: 0;

            background: transparent;

            color: #0b9eaf;

            font-family: inherit;
            font-size: 12px;
            font-weight: 700;

            cursor: pointer;
        }

        .show-password:hover {
            color: #087f8d;
        }

        .caps-warning {
            display: none;

            margin-top: 7px;

            color: #b7791f;

            font-size: 12px;
        }

        /* ==============================
           LOGIN OPTIONS
        ============================== */

        .login-options {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

            margin-bottom: 27px;
        }

        .remember-me {
            display: flex;
            align-items: center;

            gap: 8px;

            color: #5d687a;

            font-size: 13px;

            cursor: pointer;
        }

        .remember-me input {
            width: 16px;
            height: 16px;

            accent-color: #12b9cb;
        }

        .forgot-password {
            color: #0b9eaf;

            font-size: 13px;
            font-weight: 650;

            text-decoration: none;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }

        /* ==============================
           SIGN IN
        ============================== */

        .login-button {
            width: 100%;
            height: 52px;

            border: 0;
            border-radius: 9px;

            background: #12b9cb;

            color: #ffffff;

            font-family: inherit;
            font-size: 14px;
            font-weight: 700;

            cursor: pointer;

            transition:
                background 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .login-button:hover {
            background: #0fa7b8;

            transform: translateY(-1px);

            box-shadow:
                0 8px 20px rgba(18, 185, 203, 0.22);
        }

        .login-button:active {
            transform: translateY(0);
        }

        /* ==============================
           CREATE ACCOUNT
        ============================== */

        .register-section {
            margin-top: 28px;
            padding-top: 25px;

            border-top: 1px solid #e1e5eb;

            text-align: center;
        }

        .register-section p {
            color: #778196;

            font-size: 13px;
        }

        .register-link {
            color: #0b9eaf;

            font-weight: 700;

            text-decoration: none;
        }

        .register-link:hover {
            text-decoration: underline;
        }

        /* ==============================
           FOOTER
        ============================== */

        .footer-text {
            margin-top: 40px;

            text-align: center;

            color: #9aa3b2;

            font-size: 11px;
        }

        /* ==============================
           MOBILE
        ============================== */

        @@media (max-width: 850px) {

            .login-page {
                display: block;
            }

            .left-panel {
                display: none;
            }

            .right-panel {
                min-height: 100vh;

                padding: 30px 22px;
            }
        }

    </style>
</head>

<body>

<div class="login-page">

    <!-- =========================================
         LEFT SIDE
    ========================================== -->

    <section class="left-panel">

        <div class="left-content">

            <!-- MANUALLY CODED LOGO -->

            <div class="resk-logo">

                <div class="logo-box">
                    R
                </div>

                <div class="logo-copy">

                    <div class="logo-name">
                        R.E.S.K
                    </div>

                    <div class="logo-subtitle">
                        SOFTWARE STUDIO
                    </div>

                </div>

            </div>


            <!-- SYSTEM DESCRIPTION -->

            <div class="system-description">

                <h1>
                    Cape Town TV
                    <span class="accent">
                        Workflow
                    </span>
                    Management System
                </h1>

                <p>
                    A secure platform for managing programme
                    proposals, reviews and production workflows
                    across Cape Town TV.
                </p>

            </div>

        </div>

    </section>


    <!-- =========================================
         RIGHT SIDE
    ========================================== -->

    <main class="right-panel">

        <div class="login-container">

            <header class="login-header">

                <h2>
                    Welcome back
                </h2>

                <p>
                    Sign in to access the Cape Town TV
                    Workflow Management System.
                </p>

            </header>


            <!-- =================================
                 ERROR FROM ACCOUNT CONTROLLER
            ================================== -->

            @if (ViewBag.Error != null)
            {
                <div class="error-message"
                     role="alert">

                    @ViewBag.Error

                </div>
            }


            <!-- =================================
                 LOGIN FORM
            ================================== -->

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- EMAIL -->

                <div class="form-group">

                    <label for="email"
                           class="form-label">

                        Email address

                    </label>

                    <input id="email"
                           name="email"
                           type="email"
                           class="form-control"
                           placeholder="name@capetowntv.org"
                           autocomplete="email"
                           required />

                </div>


                <!-- PASSWORD -->

                <div class="form-group">

                    <label for="password"
                           class="form-label">

                        Password

                    </label>

                    <div class="password-container">

                        <input id="password"
                               name="password"
                               type="password"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />

                        <button id="passwordToggle"
                                type="button"
                                class="show-password">

                            Show

                        </button>

                    </div>

                    <div id="capsWarning"
                         class="caps-warning">

                        Caps Lock is on

                    </div>

                </div>


                <!-- OPTIONS -->

                <div class="login-options">

                    <label class="remember-me">

                        <input name="rememberMe"
                               type="checkbox"
                               value="true" />

                        <span>
                            Remember me
                        </span>

                    </label>


                    <a href="#"
                       class="forgot-password">

                        Forgot password?

                    </a>

                </div>


                <!-- LOGIN -->

                <button type="submit"
                        class="login-button">

                    Sign in

                </button>


                <!-- REGISTER -->

                <div class="register-section">

                    <p>

                        Don't have an account?

                        <a href="#"
                           class="register-link">

                            Create an account

                        </a>

                    </p>

                </div>

            </form>


            <div class="footer-text">

                R.E.S.K Software Studio • Cape Town TV

            </div>

        </div>

    </main>

</div>


<!-- ==========================================
     LOGIN FUNCTIONS
=========================================== -->

<script>

    const password =
        document.getElementById("password");

    const passwordToggle =
        document.getElementById("passwordToggle");

    const capsWarning =
        document.getElementById("capsWarning");


    // SHOW / HIDE PASSWORD

    passwordToggle.addEventListener(
        "click",
        function () {

            if (password.type === "password") {

                password.type = "text";

                passwordToggle.textContent = "Hide";

            }
            else {

                password.type = "password";

                passwordToggle.textContent = "Show";

            }

        });


    // CAPS LOCK WARNING

    password.addEventListener(
        "keyup",
        function (event) {

            const capsOn =
                event.getModifierState("CapsLock");

            capsWarning.style.display =
                capsOn ? "block" : "none";

        });

</script>

</body>
</html>