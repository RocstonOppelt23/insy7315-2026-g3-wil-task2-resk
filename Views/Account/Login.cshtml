@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Sign In | R.E.S.K Software Studio</title>

    <style>

        /* =========================================================
           RESET
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
        }

        html {
            background: #f5f7fa;
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;

            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            background: #f5f7fa;
        }


        /* =========================================================
           PAGE
        ========================================================= */

        .login-page {
            width: 100%;
            min-height: 100vh;

            display: grid;
            grid-template-columns: 46% 54%;

            background: #f5f7fa;

            opacity: 0;

            animation:
                pageEnter
                0.75s
                cubic-bezier(0.22, 1, 0.36, 1)
                forwards;

            transition:
                opacity 0.5s ease,
                transform 0.5s ease;
        }

        @@keyframes pageEnter {

            from {
                opacity: 0;

                transform:
                    translateY(8px)
                    scale(0.995);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);
            }
        }

        .login-page.page-leaving {
            opacity: 0;

            transform:
                translateX(-15px);
        }


        /* =========================================================
           LEFT BRAND PANEL
        ========================================================= */

        .brand-panel {
            position: relative;

            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow: hidden;

            padding: 60px;

            background: #0d172b;
        }

        .brand-panel::before {
            content: "";

            position: absolute;

            width: 550px;
            height: 550px;

            left: 50%;
            top: 50%;

            transform:
                translate(-50%, -50%);

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(18,185,203,0.065) 0%,
                    rgba(18,185,203,0.020) 40%,
                    transparent 70%
                );

            pointer-events: none;
        }


        /* =========================================================
           MOVING BACKGROUND CIRCLES
        ========================================================= */

        .gravity-circle {
            position: absolute;

            display: block;

            border-radius: 50%;

            pointer-events: none;

            will-change: transform;

            z-index: 1;
        }


        /* LARGE TOP LEFT */

        .circle-one {
            width: 250px;
            height: 250px;

            top: 3%;
            left: 2%;

            background:
                rgba(18,185,203,0.025);

            border:
                1px solid
                rgba(18,185,203,0.14);

            animation:
                gravitateOne
                10s
                ease-in-out
                infinite;
        }


        /* LARGE BOTTOM RIGHT */

        .circle-two {
            width: 190px;
            height: 190px;

            right: 5%;
            bottom: 6%;

            background:
                rgba(18,185,203,0.018);

            border:
                1px solid
                rgba(18,185,203,0.14);

            animation:
                gravitateTwo
                12s
                ease-in-out
                infinite;
        }


        /* MEDIUM TOP RIGHT */

        .circle-three {
            width: 125px;
            height: 125px;

            top: 15%;
            right: 10%;

            background:
                rgba(18,185,203,0.018);

            border:
                1px solid
                rgba(18,185,203,0.16);

            animation:
                gravitateThree
                9s
                ease-in-out
                infinite;
        }


        /* SMALL BOTTOM LEFT */

        .circle-four {
            width: 80px;
            height: 80px;

            left: 13%;
            bottom: 14%;

            background:
                rgba(18,185,203,0.025);

            border:
                1px solid
                rgba(18,185,203,0.15);

            animation:
                gravitateFour
                8s
                ease-in-out
                infinite;
        }


        /* SMALL CENTRE */

        .circle-five {
            width: 45px;
            height: 45px;

            left: 48%;
            top: 15%;

            background:
                rgba(18,185,203,0.035);

            border:
                1px solid
                rgba(18,185,203,0.18);

            animation:
                gravitateFive
                7s
                ease-in-out
                infinite;
        }


        /* =========================================================
           CIRCLE MOVEMENT
        ========================================================= */

        @@keyframes gravitateOne {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            20% {
                transform:
                    translate3d(70px, 20px, 0)
                    scale(1.04);
            }

            40% {
                transform:
                    translate3d(110px, 90px, 0)
                    scale(0.97);
            }

            60% {
                transform:
                    translate3d(65px, 155px, 0)
                    scale(1.05);
            }

            80% {
                transform:
                    translate3d(-10px, 85px, 0)
                    scale(0.98);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        @@keyframes gravitateTwo {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            20% {
                transform:
                    translate3d(-65px, -25px, 0)
                    scale(1.04);
            }

            40% {
                transform:
                    translate3d(-115px, -90px, 0)
                    scale(0.97);
            }

            60% {
                transform:
                    translate3d(-70px, -150px, 0)
                    scale(1.05);
            }

            80% {
                transform:
                    translate3d(10px, -80px, 0)
                    scale(0.98);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        @@keyframes gravitateThree {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    rotate(0deg);
            }

            25% {
                transform:
                    translate3d(-65px, 35px, 0)
                    rotate(6deg);
            }

            50% {
                transform:
                    translate3d(-100px, 115px, 0)
                    rotate(0deg);
            }

            75% {
                transform:
                    translate3d(-25px, 165px, 0)
                    rotate(-6deg);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    rotate(0deg);
            }
        }


        @@keyframes gravitateFour {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            25% {
                transform:
                    translate3d(55px, -35px, 0)
                    scale(1.08);
            }

            50% {
                transform:
                    translate3d(110px, -70px, 0)
                    scale(0.96);
            }

            75% {
                transform:
                    translate3d(50px, -125px, 0)
                    scale(1.05);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        @@keyframes gravitateFive {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            25% {
                transform:
                    translate3d(55px, 45px, 0)
                    scale(1.12);
            }

            50% {
                transform:
                    translate3d(20px, 100px, 0)
                    scale(0.94);
            }

            75% {
                transform:
                    translate3d(-45px, 55px, 0)
                    scale(1.08);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        /* =========================================================
           BRAND CONTENT
        ========================================================= */

        .brand-content {
            position: relative;

            z-index: 5;

            width: 100%;
            max-width: 460px;
        }


        /* =========================================================
           LOGO
        ========================================================= */

        .resk-logo {
            display: flex;
            align-items: center;

            gap: 18px;

            margin-bottom: 55px;
        }

        .logo-box {
            width: 68px;
            height: 68px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border:
                2px solid
                #12b9cb;

            border-radius: 16px;

            background:
                rgba(18,185,203,0.025);

            color: #12b9cb;

            font-size: 30px;
            font-weight: 500;

            animation:
                logoGlow
                3s
                ease-in-out
                infinite;
        }

        @@keyframes logoGlow {

            0%,
            100% {
                box-shadow:
                    0 0 0
                    rgba(18,185,203,0);
            }

            50% {
                box-shadow:
                    0 0 30px
                    rgba(18,185,203,0.15);
            }
        }

        .logo-name {
            color: #ffffff;

            font-size: 27px;
            font-weight: 800;

            letter-spacing: 1.5px;

            line-height: 1;
        }

        .logo-subtitle {
            margin-top: 8px;

            color:
                rgba(255,255,255,0.78);

            font-size: 10px;
            font-weight: 700;

            letter-spacing: 0.4px;
        }


        /* =========================================================
           BRAND TEXT
        ========================================================= */

        .brand-title {
            max-width: 430px;

            color: #ffffff;

            font-size: 37px;
            line-height: 1.2;

            font-weight: 700;

            letter-spacing: -0.5px;
        }

        .brand-description {
            max-width: 410px;

            margin-top: 20px;

            color:
                rgba(255,255,255,0.55);

            font-size: 14px;
            line-height: 1.8;
        }

        .brand-accent {
            width: 48px;
            height: 3px;

            margin-top: 30px;

            border-radius: 20px;

            background: #12b9cb;
        }


        /* =========================================================
           RIGHT PANEL
        ========================================================= */

        .form-panel {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding:
                60px
                80px;

            background: #f5f7fa;
        }

        .form-wrapper {
            width: 100%;
            max-width: 440px;
        }


        /* =========================================================
           FORM HEADER
        ========================================================= */

        .form-header {
            margin-bottom: 31px;
        }

        .form-header h1 {
            color: #0d172b;

            font-size: 34px;
            font-weight: 750;

            letter-spacing: -0.7px;
        }

        .form-header p {
            margin-top: 10px;

            color: #7a8494;

            font-size: 14px;
            line-height: 1.6;
        }


        /* =========================================================
           SUCCESS MESSAGE
        ========================================================= */

        .success-message {
            margin-bottom: 20px;

            padding:
                13px
                15px;

            border:
                1px solid
                rgba(18,185,203,0.20);

            border-radius: 10px;

            background:
                rgba(18,185,203,0.055);

            color: #087f8c;

            font-size: 13px;
            line-height: 1.5;
        }


        /* =========================================================
           VALIDATION
        ========================================================= */

        .validation-summary {
            margin-bottom: 20px;

            padding:
                13px
                15px;

            border:
                1px solid
                rgba(220,53,69,0.20);

            border-radius: 10px;

            background:
                rgba(220,53,69,0.055);

            color: #b42333;

            font-size: 13px;
            line-height: 1.5;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

        .validation-summary li + li {
            margin-top: 4px;
        }


        /* =========================================================
           FORM
        ========================================================= */

        .form-group {
            margin-bottom: 19px;
        }

        .form-label {
            display: block;

            margin-bottom: 8px;

            color: #263348;

            font-size: 13px;
            font-weight: 650;
        }

        .input-wrapper {
            position: relative;
        }

        .form-control {
            width: 100%;
            height: 51px;

            padding:
                0
                15px;

            border:
                1px solid
                #d7dce3;

            border-radius: 10px;

            outline: none;

            background: #ffffff;

            color: #182235;

            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            font-size: 14px;

            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease,
                transform 0.2s ease;
        }

        .form-control::placeholder {
            color: #a3aab5;
        }

        .form-control:hover {
            border-color: #b9c1cc;
        }

        .form-control:focus {
            border-color: #12b9cb;

            box-shadow:
                0 0 0 3px
                rgba(18,185,203,0.10);

            transform:
                translateY(-1px);
        }

        .password-input {
            padding-right: 70px;
        }

        .password-toggle {
            position: absolute;

            top: 50%;
            right: 14px;

            transform:
                translateY(-50%);

            border: none;

            background: transparent;

            color: #778292;

            font-family: inherit;

            font-size: 12px;
            font-weight: 700;

            cursor: pointer;
        }

        .password-toggle:hover {
            color: #12aabb;
        }


        /* =========================================================
           CAPS LOCK WARNING
        ========================================================= */

        .caps-warning {
            display: none;

            margin-top: 7px;

            color: #b7791f;

            font-size: 11px;
            font-weight: 600;
        }

        .caps-warning.visible {
            display: block;
        }


        /* =========================================================
           LOGIN OPTIONS
        ========================================================= */

        .login-options {
            display: flex;

            align-items: center;
            justify-content: space-between;

            gap: 20px;

            margin:
                3px
                0
                24px;
        }

        .remember-option {
            display: flex;
            align-items: center;

            gap: 8px;

            color: #697586;

            font-size: 12px;

            cursor: pointer;
        }

        .remember-option input {
            width: 15px;
            height: 15px;

            accent-color: #12b9cb;
        }

        .forgot-link {
            color: #0ba8b9;

            font-size: 12px;
            font-weight: 700;

            text-decoration: none;
        }

        .forgot-link:hover {
            color: #087f8c;

            text-decoration: underline;
        }


        /* =========================================================
           SIGN IN BUTTON
        ========================================================= */

        .sign-in-button {
            width: 100%;
            height: 52px;

            border: none;

            border-radius: 10px;

            background: #12b9cb;

            color: #ffffff;

            font-family: inherit;

            font-size: 14px;
            font-weight: 700;

            cursor: pointer;

            box-shadow:
                0 7px 20px
                rgba(18,185,203,0.16);

            transition:
                background 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .sign-in-button:hover {
            background: #0fa9ba;

            transform:
                translateY(-2px);

            box-shadow:
                0 10px 24px
                rgba(18,185,203,0.22);
        }

        .sign-in-button:active {
            transform:
                translateY(0);
        }


        /* =========================================================
           REGISTER SECTION
        ========================================================= */

        .register-section {
            margin-top: 27px;

            padding-top: 25px;

            border-top:
                1px solid
                #e1e5ea;

            text-align: center;

            color: #7a8494;

            font-size: 13px;
        }

        .register-link {
            margin-left: 5px;

            color: #0ba8b9;

            font-weight: 700;

            text-decoration: none;
        }

        .register-link:hover {
            color: #087f8c;

            text-decoration: underline;
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        .login-footer {
            margin-top: 38px;

            text-align: center;

            color: #a0a7b1;

            font-size: 10px;
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 1000px) {

            .login-page {
                grid-template-columns:
                    42% 58%;
            }

            .brand-panel {
                padding: 45px;
            }

            .brand-title {
                font-size: 32px;
            }

            .form-panel {
                padding:
                    50px
                    55px;
            }
        }


        @@media (max-width: 780px) {

            .login-page {
                display: block;
            }

            .brand-panel {
                min-height: 350px;

                padding:
                    45px
                    30px;
            }

            .resk-logo {
                margin-bottom: 28px;
            }

            .brand-title {
                font-size: 29px;
            }

            .form-panel {
                min-height: auto;

                padding:
                    55px
                    25px;
            }

            .circle-one {
                width: 170px;
                height: 170px;
            }

            .circle-two {
                width: 140px;
                height: 140px;
            }

            .circle-three {
                width: 90px;
                height: 90px;
            }
        }


        @@media (max-width: 480px) {

            .brand-panel {
                padding:
                    40px
                    22px;
            }

            .logo-box {
                width: 58px;
                height: 58px;

                font-size: 26px;
            }

            .logo-name {
                font-size: 23px;
            }

            .brand-title {
                font-size: 25px;
            }

            .form-panel {
                padding:
                    45px
                    20px;
            }

            .form-header h1 {
                font-size: 30px;
            }

            .login-options {
                align-items: flex-start;
                flex-direction: column;

                gap: 12px;
            }
        }

    </style>
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=resk2" />
</head>

<body>

<main id="loginPage"
      class="login-page">


    <!-- =====================================================
         LEFT PANEL
    ====================================================== -->

    <section class="brand-panel">


        <!-- MOVING BACKGROUND CIRCLES -->

        <div class="gravity-circle circle-one"></div>
        <div class="gravity-circle circle-two"></div>
        <div class="gravity-circle circle-three"></div>
        <div class="gravity-circle circle-four"></div>
        <div class="gravity-circle circle-five"></div>


        <!-- BRAND CONTENT -->

        <div class="brand-content">


            <!-- LOGO -->

            <div class="resk-logo">


                <div class="logo-box">

                    R

                </div>


                <div>


                    <div class="logo-name">

                        R.E.S.K

                    </div>


                    <div class="logo-subtitle">

                        SOFTWARE STUDIO

                    </div>


                </div>


            </div>


            <h2 class="brand-title">

                Cape Town TV Workflow Management System

            </h2>


            <p class="brand-description">

                A secure and streamlined platform for managing
                proposals, reviewing content and keeping your
                production workflow organised.

            </p>


            <div class="brand-accent"></div>


        </div>


    </section>



    <!-- =====================================================
         RIGHT PANEL
    ====================================================== -->

    <section class="form-panel">


        <div class="form-wrapper">


            <!-- HEADER -->

            <div class="form-header">


                <h1>

                    Welcome back

                </h1>


                <p>

                    Sign in to continue to your production workspace.

                </p>


            </div>


            <!-- SUCCESS MESSAGE -->

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-message">

                    @TempData["SuccessMessage"]

                </div>
            }


            <!-- VALIDATION -->

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary"
                     asp-validation-summary="All">

                </div>
            }


            <!-- =================================================
                 LOGIN FORM
            ================================================== -->

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  id="loginForm">


                @Html.AntiForgeryToken()


                <!-- EMAIL -->

                <div class="form-group">


                    <label for="email"
                           class="form-label">

                        Email address

                    </label>


                    <input id="email"
                           name="email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email"
                           value="@ViewBag.Email"
                           autocomplete="email"
                           required />


                </div>


                <!-- PASSWORD -->

                <div class="form-group">


                    <label for="password"
                           class="form-label">

                        Password

                    </label>


                    <div class="input-wrapper">


                        <input id="password"
                               name="password"
                               type="password"
                               class="form-control password-input"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />


                        <button id="passwordToggle"
                                type="button"
                                class="password-toggle"
                                aria-label="Show password">

                            Show

                        </button>


                    </div>


                    <div id="capsWarning"
                         class="caps-warning">

                        Caps Lock is on

                    </div>


                </div>


                <!-- OPTIONS -->

                <div class="login-options">


                    <label class="remember-option">


                        @if (ViewBag.RememberMe == true)
                        {
                            <input type="checkbox"
                                   name="rememberMe"
                                   value="true"
                                   checked />
                        }
                        else
                        {
                            <input type="checkbox"
                                   name="rememberMe"
                                   value="true" />
                        }


                        <span>

                            Remember me

                        </span>


                    </label>


                    <a asp-controller="Account"
                       asp-action="ForgotPassword"
                       class="forgot-link transition-link">

                        Forgot password?

                    </a>


                </div>


                <!-- SIGN IN -->

                <button type="submit"
                        class="sign-in-button">

                    Sign in

                </button>


            </form>


            <!-- REGISTER -->

            <div class="register-section">

                Don't have an account?

                <a asp-controller="Account"
                   asp-action="Register"
                   class="register-link transition-link">

                    Create account

                </a>

            </div>


            <!-- FOOTER -->

            <div class="login-footer">

                R.E.S.K Software Studio · Cape Town TV

            </div>


        </div>


    </section>


</main>


<script>

    // ==========================================================
    // PASSWORD SHOW / HIDE
    // ==========================================================

    const passwordInput =
        document.getElementById(
            "password"
        );


    const passwordToggle =
        document.getElementById(
            "passwordToggle"
        );


    passwordToggle.addEventListener(
        "click",
        function () {

            const hidden =
                passwordInput.type ===
                "password";


            passwordInput.type =
                hidden
                    ? "text"
                    : "password";


            passwordToggle.textContent =
                hidden
                    ? "Hide"
                    : "Show";


            passwordToggle.setAttribute(
                "aria-label",
                hidden
                    ? "Hide password"
                    : "Show password"
            );

        }
    );


    // ==========================================================
    // CAPS LOCK WARNING
    // ==========================================================

    const capsWarning =
        document.getElementById(
            "capsWarning"
        );


    function checkCapsLock(event) {

        const capsOn =
            event.getModifierState &&
            event.getModifierState(
                "CapsLock"
            );


        capsWarning.classList.toggle(
            "visible",
            capsOn
        );

    }


    passwordInput.addEventListener(
        "keydown",
        checkCapsLock
    );


    passwordInput.addEventListener(
        "keyup",
        checkCapsLock
    );


    // ==========================================================
    // SMOOTH PAGE TRANSITIONS
    // ==========================================================

    const loginPage =
        document.getElementById(
            "loginPage"
        );


    document
        .querySelectorAll(
            ".transition-link"
        )
        .forEach(
            function (link) {

                link.addEventListener(
                    "click",
                    function (event) {

                        if (
                            event.ctrlKey ||
                            event.metaKey ||
                            event.shiftKey ||
                            event.altKey
                        ) {
                            return;
                        }


                        event.preventDefault();


                        const destination =
                            link.href;


                        loginPage.classList.add(
                            "page-leaving"
                        );


                        setTimeout(
                            function () {

                                window.location.href =
                                    destination;

                            },
                            450
                        );

                    }
                );

            }
        );


    // ==========================================================
    // RESET TRANSITION WHEN BROWSER BACK IS USED
    // ==========================================================

    window.addEventListener(
        "pageshow",
        function () {

            loginPage.classList.remove(
                "page-leaving"
            );

        }
    );

</script>

</body>
</html>