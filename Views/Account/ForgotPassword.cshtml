@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password | R.E.S.K Software Studio</title>

    <style>

        /* =========================================================
           RESET
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
        }

        html {
            background: #f5f7fa;
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;

            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            background: #f5f7fa;
        }


        /* =========================================================
           PAGE
        ========================================================= */

        .forgot-page {
            width: 100%;
            min-height: 100vh;

            display: grid;
            grid-template-columns: 46% 54%;

            background: #f5f7fa;

            opacity: 0;

            animation:
                pageEnter
                0.75s
                cubic-bezier(0.22, 1, 0.36, 1)
                forwards;

            transition:
                opacity 0.5s ease,
                transform 0.5s ease;
        }

        @@keyframes pageEnter {

            from {
                opacity: 0;

                transform:
                    translateY(8px)
                    scale(0.995);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);
            }
        }

        .forgot-page.page-leaving {
            opacity: 0;

            transform:
                translateX(15px);
        }


        /* =========================================================
           LEFT PANEL
        ========================================================= */

        .brand-panel {
            position: relative;

            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow: hidden;

            padding: 60px;

            background: #0d172b;
        }

        .brand-panel::before {
            content: "";

            position: absolute;

            width: 550px;
            height: 550px;

            left: 50%;
            top: 50%;

            transform:
                translate(-50%, -50%);

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(18,185,203,0.065) 0%,
                    rgba(18,185,203,0.020) 40%,
                    transparent 70%
                );

            pointer-events: none;
        }


        /* =========================================================
           MOVING BACKGROUND CIRCLES
        ========================================================= */

        .gravity-circle {
            position: absolute;

            display: block;

            border-radius: 50%;

            pointer-events: none;

            will-change: transform;

            z-index: 1;
        }


        .circle-one {
            width: 250px;
            height: 250px;

            top: 3%;
            left: 2%;

            background:
                rgba(18,185,203,0.025);

            border:
                1px solid
                rgba(18,185,203,0.14);

            animation:
                gravitateOne
                10s
                ease-in-out
                infinite;
        }


        .circle-two {
            width: 190px;
            height: 190px;

            right: 5%;
            bottom: 6%;

            background:
                rgba(18,185,203,0.018);

            border:
                1px solid
                rgba(18,185,203,0.14);

            animation:
                gravitateTwo
                12s
                ease-in-out
                infinite;
        }


        .circle-three {
            width: 125px;
            height: 125px;

            top: 15%;
            right: 10%;

            background:
                rgba(18,185,203,0.018);

            border:
                1px solid
                rgba(18,185,203,0.16);

            animation:
                gravitateThree
                9s
                ease-in-out
                infinite;
        }


        .circle-four {
            width: 80px;
            height: 80px;

            left: 13%;
            bottom: 14%;

            background:
                rgba(18,185,203,0.025);

            border:
                1px solid
                rgba(18,185,203,0.15);

            animation:
                gravitateFour
                8s
                ease-in-out
                infinite;
        }


        .circle-five {
            width: 45px;
            height: 45px;

            left: 48%;
            top: 15%;

            background:
                rgba(18,185,203,0.035);

            border:
                1px solid
                rgba(18,185,203,0.18);

            animation:
                gravitateFive
                7s
                ease-in-out
                infinite;
        }


        /* =========================================================
           CIRCLE MOVEMENT
        ========================================================= */

        @@keyframes gravitateOne {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            20% {
                transform:
                    translate3d(70px, 20px, 0)
                    scale(1.04);
            }

            40% {
                transform:
                    translate3d(110px, 90px, 0)
                    scale(0.97);
            }

            60% {
                transform:
                    translate3d(65px, 155px, 0)
                    scale(1.05);
            }

            80% {
                transform:
                    translate3d(-10px, 85px, 0)
                    scale(0.98);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        @@keyframes gravitateTwo {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            20% {
                transform:
                    translate3d(-65px, -25px, 0)
                    scale(1.04);
            }

            40% {
                transform:
                    translate3d(-115px, -90px, 0)
                    scale(0.97);
            }

            60% {
                transform:
                    translate3d(-70px, -150px, 0)
                    scale(1.05);
            }

            80% {
                transform:
                    translate3d(10px, -80px, 0)
                    scale(0.98);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        @@keyframes gravitateThree {

            0% {
                transform:
                    translate3d(0, 0, 0);
            }

            25% {
                transform:
                    translate3d(-65px, 35px, 0);
            }

            50% {
                transform:
                    translate3d(-100px, 115px, 0);
            }

            75% {
                transform:
                    translate3d(-25px, 165px, 0);
            }

            100% {
                transform:
                    translate3d(0, 0, 0);
            }
        }


        @@keyframes gravitateFour {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            25% {
                transform:
                    translate3d(55px, -35px, 0)
                    scale(1.08);
            }

            50% {
                transform:
                    translate3d(110px, -70px, 0)
                    scale(0.96);
            }

            75% {
                transform:
                    translate3d(50px, -125px, 0)
                    scale(1.05);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        @@keyframes gravitateFive {

            0% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }

            25% {
                transform:
                    translate3d(55px, 45px, 0)
                    scale(1.12);
            }

            50% {
                transform:
                    translate3d(20px, 100px, 0)
                    scale(0.94);
            }

            75% {
                transform:
                    translate3d(-45px, 55px, 0)
                    scale(1.08);
            }

            100% {
                transform:
                    translate3d(0, 0, 0)
                    scale(1);
            }
        }


        /* =========================================================
           BRAND CONTENT
        ========================================================= */

        .brand-content {
            position: relative;

            z-index: 5;

            width: 100%;
            max-width: 460px;
        }


        /* =========================================================
           LOGO
        ========================================================= */

        .resk-logo {
            display: flex;
            align-items: center;

            gap: 18px;

            margin-bottom: 50px;
        }


        .logo-box {
            width: 68px;
            height: 68px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border:
                2px solid
                #12b9cb;

            border-radius: 16px;

            background:
                rgba(18,185,203,0.025);

            color: #12b9cb;

            font-size: 30px;
            font-weight: 500;

            animation:
                logoGlow
                3s
                ease-in-out
                infinite;
        }


        @@keyframes logoGlow {

            0%,
            100% {
                box-shadow:
                    0 0 0
                    rgba(18,185,203,0);
            }

            50% {
                box-shadow:
                    0 0 30px
                    rgba(18,185,203,0.15);
            }
        }


        .logo-name {
            color: #ffffff;

            font-size: 27px;
            font-weight: 800;

            letter-spacing: 1.5px;

            line-height: 1;
        }


        .logo-subtitle {
            margin-top: 8px;

            color:
                rgba(255,255,255,0.78);

            font-size: 10px;
            font-weight: 700;

            letter-spacing: 0.4px;
        }


        /* =========================================================
           BRAND TEXT
        ========================================================= */

        .brand-title {
            max-width: 430px;

            color: #ffffff;

            font-size: 37px;
            line-height: 1.2;

            font-weight: 700;

            letter-spacing: -0.5px;
        }


        .brand-description {
            max-width: 410px;

            margin-top: 20px;

            color:
                rgba(255,255,255,0.55);

            font-size: 14px;
            line-height: 1.8;
        }


        .brand-accent {
            width: 48px;
            height: 3px;

            margin-top: 30px;

            border-radius: 20px;

            background: #12b9cb;
        }


        /* =========================================================
           RIGHT PANEL
        ========================================================= */

        .form-panel {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding:
                60px
                80px;

            background: #f5f7fa;
        }


        .form-wrapper {
            width: 100%;

            max-width: 440px;
        }


        /* =========================================================
           BACK LINK
        ========================================================= */

        .back-link {
            display: inline-block;

            margin-bottom: 32px;

            color: #718096;

            font-size: 13px;
            font-weight: 600;

            text-decoration: none;

            transition:
                color 0.2s ease;
        }


        .back-link:hover {
            color: #12aabb;
        }


        /* =========================================================
           HEADER
        ========================================================= */

        .form-header {
            margin-bottom: 30px;
        }


        .form-header h1 {
            color: #0d172b;

            font-size: 34px;
            font-weight: 750;

            letter-spacing: -0.7px;
        }


        .form-header p {
            margin-top: 11px;

            color: #7a8494;

            font-size: 14px;
            line-height: 1.7;
        }


        /* =========================================================
           VALIDATION
        ========================================================= */

        .validation-summary {
            margin-bottom: 20px;

            padding:
                13px
                15px;

            border:
                1px solid
                rgba(220,53,69,0.20);

            border-radius: 10px;

            background:
                rgba(220,53,69,0.055);

            color: #b42333;

            font-size: 13px;
            line-height: 1.5;
        }


        .validation-summary ul {
            margin: 0;

            padding-left: 18px;
        }


        .validation-summary li + li {
            margin-top: 4px;
        }


        /* =========================================================
           FORM
        ========================================================= */

        .form-group {
            margin-bottom: 23px;
        }


        .form-label {
            display: block;

            margin-bottom: 8px;

            color: #263348;

            font-size: 13px;
            font-weight: 650;
        }


        .form-control {
            width: 100%;
            height: 52px;

            padding:
                0
                16px;

            border:
                1px solid
                #d7dce3;

            border-radius: 10px;

            outline: none;

            background: #ffffff;

            color: #182235;

            font-family:
                "Segoe UI",
                Arial,
                sans-serif;

            font-size: 14px;

            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease,
                transform 0.2s ease;
        }


        .form-control::placeholder {
            color: #a3aab5;
        }


        .form-control:hover {
            border-color: #b9c1cc;
        }


        .form-control:focus {
            border-color: #12b9cb;

            box-shadow:
                0 0 0 3px
                rgba(18,185,203,0.10);

            transform:
                translateY(-1px);
        }


        /* =========================================================
           BUTTON
        ========================================================= */

        .reset-button {
            width: 100%;
            height: 52px;

            border: none;

            border-radius: 10px;

            background: #12b9cb;

            color: #ffffff;

            font-family: inherit;

            font-size: 14px;
            font-weight: 700;

            cursor: pointer;

            box-shadow:
                0 7px 20px
                rgba(18,185,203,0.16);

            transition:
                background 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .reset-button:hover {
            background: #0fa9ba;

            transform:
                translateY(-2px);

            box-shadow:
                0 10px 24px
                rgba(18,185,203,0.22);
        }


        .reset-button:active {
            transform:
                translateY(0);
        }


        /* =========================================================
           SECURITY NOTE
        ========================================================= */

        .security-note {
            margin-top: 27px;

            padding:
                16px
                17px;

            border:
                1px solid
                rgba(18,185,203,0.12);

            border-radius: 10px;

            background:
                rgba(18,185,203,0.035);

            color: #778292;

            font-size: 12px;
            line-height: 1.65;
        }


        .security-note strong {
            color: #425066;
        }


        /* =========================================================
           SIGN IN
        ========================================================= */

        .signin-section {
            margin-top: 27px;

            padding-top: 24px;

            border-top:
                1px solid
                #e1e5ea;

            text-align: center;

            color: #7a8494;

            font-size: 13px;
        }


        .signin-link {
            margin-left: 5px;

            color: #0ba8b9;

            font-weight: 700;

            text-decoration: none;
        }


        .signin-link:hover {
            color: #087f8c;

            text-decoration: underline;
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        .forgot-footer {
            margin-top: 34px;

            text-align: center;

            color: #a0a7b1;

            font-size: 10px;
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 1000px) {

            .forgot-page {
                grid-template-columns:
                    42% 58%;
            }


            .brand-panel {
                padding: 45px;
            }


            .brand-title {
                font-size: 32px;
            }


            .form-panel {
                padding:
                    50px
                    55px;
            }
        }


        @@media (max-width: 780px) {

            .forgot-page {
                display: block;
            }


            .brand-panel {
                min-height: 350px;

                padding:
                    45px
                    30px;
            }


            .resk-logo {
                margin-bottom: 28px;
            }


            .brand-title {
                font-size: 29px;
            }


            .form-panel {
                min-height: auto;

                padding:
                    55px
                    25px;
            }


            .circle-one {
                width: 170px;
                height: 170px;
            }


            .circle-two {
                width: 140px;
                height: 140px;
            }


            .circle-three {
                width: 90px;
                height: 90px;
            }
        }


        @@media (max-width: 480px) {

            .brand-panel {
                padding:
                    40px
                    22px;
            }


            .logo-box {
                width: 58px;
                height: 58px;

                font-size: 26px;
            }


            .logo-name {
                font-size: 23px;
            }


            .brand-title {
                font-size: 25px;
            }


            .form-panel {
                padding:
                    45px
                    20px;
            }


            .form-header h1 {
                font-size: 30px;
            }
        }

    </style>
</head>

<body>

<main id="forgotPage"
      class="forgot-page">


    <!-- =====================================================
         LEFT PANEL
    ====================================================== -->

    <section class="brand-panel">


        <!-- MOVING BACKGROUND CIRCLES -->

        <div class="gravity-circle circle-one"></div>

        <div class="gravity-circle circle-two"></div>

        <div class="gravity-circle circle-three"></div>

        <div class="gravity-circle circle-four"></div>

        <div class="gravity-circle circle-five"></div>


        <!-- BRAND -->

        <div class="brand-content">


            <div class="resk-logo">


                <div class="logo-box">

                    R

                </div>


                <div>


                    <div class="logo-name">

                        R.E.S.K

                    </div>


                    <div class="logo-subtitle">

                        SOFTWARE STUDIO

                    </div>


                </div>


            </div>


            <h2 class="brand-title">

                Recover your account securely

            </h2>


            <p class="brand-description">

                Enter the email address associated with your account
                and we'll help you regain access to the Cape Town TV
                Workflow Management System.

            </p>


            <div class="brand-accent"></div>


        </div>


    </section>



    <!-- =====================================================
         RIGHT PANEL
    ====================================================== -->

    <section class="form-panel">


        <div class="form-wrapper">


            <!-- BACK -->

            <a asp-controller="Account"
               asp-action="Login"
               class="back-link transition-link">

                ← Back to sign in

            </a>


            <!-- HEADER -->

            <div class="form-header">


                <h1>

                    Forgot password?

                </h1>


                <p>

                    Enter your email address and we'll send you
                    instructions to reset your password.

                </p>


            </div>


            <!-- SERVER VALIDATION -->

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary"
                     asp-validation-summary="All">
                </div>
            }


            <!-- =================================================
                 FORM
            ================================================== -->

            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post"
                  id="forgotPasswordForm">


                @Html.AntiForgeryToken()


                <div class="form-group">


                    <label for="email"
                           class="form-label">

                        Email address

                    </label>


                    <input id="email"
                           name="email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email"
                           value="@ViewBag.Email"
                           autocomplete="email"
                           required />


                </div>


                <button type="submit"
                        class="reset-button">

                    Send reset instructions

                </button>


            </form>


            <!-- SECURITY -->

            <div class="security-note">

                <strong>
                    Account security
                </strong>

                <br />

                For your protection, we'll use the same response
                whether or not an account exists for the email
                address entered.

            </div>


            <!-- SIGN IN -->

            <div class="signin-section">

                Remember your password?

                <a asp-controller="Account"
                   asp-action="Login"
                   class="signin-link transition-link">

                    Sign in

                </a>

            </div>


            <!-- FOOTER -->

            <div class="forgot-footer">

                R.E.S.K Software Studio · Cape Town TV

            </div>


        </div>


    </section>


</main>


<script>

    // ==========================================================
    // PAGE
    // ==========================================================

    const forgotPage =
        document.getElementById(
            "forgotPage"
        );


    // ==========================================================
    // SMOOTH PAGE TRANSITIONS
    // ==========================================================

    document
        .querySelectorAll(
            ".transition-link"
        )
        .forEach(
            function (link) {

                link.addEventListener(
                    "click",
                    function (event) {

                        if (
                            event.ctrlKey ||
                            event.metaKey ||
                            event.shiftKey ||
                            event.altKey
                        ) {
                            return;
                        }


                        event.preventDefault();


                        const destination =
                            link.href;


                        forgotPage.classList.add(
                            "page-leaving"
                        );


                        setTimeout(
                            function () {

                                window.location.href =
                                    destination;

                            },
                            450
                        );

                    }
                );

            }
        );


    // ==========================================================
    // RESET PAGE AFTER BROWSER BACK
    // ==========================================================

    window.addEventListener(
        "pageshow",
        function () {

            forgotPage.classList.remove(
                "page-leaving"
            );

        }
    );

</script>

</body>
</html>