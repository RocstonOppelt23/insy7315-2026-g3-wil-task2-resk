@model RESK.WIL.Models.ReskPasswordViewModel

@{
    Layout = "~/Views/Account/_ReskPlain.cshtml";
    ViewData["Title"] = "Choose a new password";
    ViewData["BoxClass"] = "wide";
}

@section Styles {
    <style>
        .box.wide { max-width: 460px; }
        h1, .lead { text-align: center; }
        .errors { margin-top: 18px; padding: 12px 16px; border: 1px solid #f0c2c5; border-radius: 10px; background: #fff7f7; color: #b84048; font-size: 13px; font-weight: 600; list-style: none; }
        .errors li + li { margin-top: 6px; }
        .field { margin-top: 20px; }
        .hint { margin-top: 8px; font-size: 12px; }
        .primary-button { width: 100%; margin-top: 26px; }
        .leave { margin-top: 16px; text-align: center; }
        .leave button { border: none; background: none; color: #5d6d87; font-size: 12px; font-weight: 700; text-decoration: underline; cursor: pointer; }
    </style>
}

<h1>Choose a new password</h1>
<p class="lead">@(Model.Required ? Model.Reason : "Change the password for " + Model.Email + ".")</p>

@if (Model.Errors.Count > 0)
{
    <ul class="errors" role="alert">
        @foreach (var error in Model.Errors)
        {
            <li>@error</li>
        }
    </ul>
}

<form method="post" action="/Account/UpdatePassword" autocomplete="off">
    @Html.AntiForgeryToken()

    <div class="field">
        <label class="section-label" for="currentPassword">Current password</label>
        <input class="input" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required />
    </div>

    <div class="field">
        <label class="section-label" for="newPassword">New password</label>
        <input class="input" id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="@Model.MinLength" required />
        <p class="hint">@Model.Rule.</p>
    </div>

    <div class="field">
        <label class="section-label" for="confirmPassword">Confirm new password</label>
        <input class="input" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required />
    </div>

    <button type="submit" class="primary-button">Save new password</button>
</form>

<form method="post" action="/Producer/Logout" class="leave">
    <button type="submit">Sign out instead</button>
</form>