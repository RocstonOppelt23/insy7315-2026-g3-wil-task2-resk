    <style>
        .tabs { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; padding: 10px 12px; }
        .tab { display: flex; align-items: center; justify-content: center; min-height: 34px; padding: 0 8px; border-radius: 8px; color: var(--resk-text-soft); font-size: 13px; font-weight: 500; text-decoration: none; }
        .tab:hover { background: var(--resk-surface); color: var(--resk-navy-800); }
        .tab[aria-current="page"] { background: #eaf7f9; color: var(--resk-cyan-darker); font-weight: 800; }

        [hidden] { display: none !important; }
        .settings-card { margin-top: 18px; }
        .settings-card fieldset { min-width: 0; border: none; }
        .settings-card .card-title { font-size: 21px; }
        .block-title { margin-top: 34px; color: var(--resk-navy-800); font-size: 18px; font-weight: 800; }
        .block-sub { margin-top: 7px; color: var(--resk-text-muted); font-size: 12px; }
        .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 26px; margin-top: 24px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px 24px; margin-top: 20px; }
        .input[readonly], .input:disabled { background: var(--resk-surface-alt); color: var(--resk-text-soft); }

        .form-errors { margin-top: 18px; padding: 14px 18px; border: 1px solid var(--resk-danger-border); border-radius: 10px; background: var(--resk-danger-bg); color: var(--resk-danger-dark); font-size: 12px; font-weight: 600; list-style: none; }
        .form-errors li + li { margin-top: 6px; }

        .toggles { display: flex; flex-direction: column; gap: 14px; margin-top: 20px; }
        .toggle { display: flex; align-items: center; gap: 18px; padding: 15px 20px; border: 1px solid var(--resk-border); border-radius: 10px; background: var(--resk-surface-alt); }
        .toggle.highlight { border-color: #a9e3ec; background: var(--resk-cyan-soft); }
        .toggle-main { display: flex; flex: 1; align-items: center; gap: 18px; min-width: 0; cursor: pointer; }
        .toggle input[type=checkbox], .switch-only input { position: absolute; opacity: 0; pointer-events: none; }
        .switch { position: relative; display: block; width: 38px; height: 21px; flex-shrink: 0; border: 1px solid var(--resk-border-mid); border-radius: 999px; background: white; transition: background 0.2s, border-color 0.2s; }
        .switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 15px; height: 15px; border-radius: 50%; background: var(--resk-border-mid); transition: transform 0.2s, background 0.2s; }
        input:checked + .switch { border-color: var(--resk-cyan); background: var(--resk-cyan); }
        input:checked + .switch::after { background: white; transform: translateX(17px); }
        input:focus-visible + .switch { outline: 2px solid var(--resk-cyan); outline-offset: 2px; }
        .toggle strong { display: block; color: var(--resk-navy-800); font-size: 13px; }
        .toggle small { display: block; margin-top: 5px; color: var(--resk-text-muted); font-size: 11px; line-height: 1.5; }
        .toggle .input { width: 260px; flex-shrink: 0; }
        .soon { display: inline-block; margin-left: 8px; padding: 2px 9px; border-radius: 999px; background: var(--resk-warning-soft); color: var(--resk-warning-dark); font-size: 10px; font-weight: 800; vertical-align: middle; }

        .chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 18px; }
        .chip-box { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 16px; border: 1px solid var(--resk-border); border-radius: 8px; background: var(--resk-surface-alt); color: var(--resk-navy-800); font-size: 12px; cursor: pointer; }
        .chip-box input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--resk-cyan); }
        .chip-box select { height: 30px; padding: 0 6px; border: 1px solid var(--resk-border-mid); border-radius: 6px; background: white; color: var(--resk-navy-800); font-size: 12px; }

        .info-box { margin-top: 26px; padding: 16px 20px; border: 1px solid #a9e3ec; border-radius: 10px; background: var(--resk-cyan-soft); }
        .info-box strong { display: block; color: var(--resk-navy-800); font-size: 13px; }
        .info-box span { display: block; margin-top: 6px; color: var(--resk-text-soft); font-size: 11px; line-height: 1.5; }
        .info-box.off { border-color: var(--resk-border); background: var(--resk-surface-alt); }
        .warn-bar { margin-top: 24px; padding: 13px 20px; border: 1px solid #f0d9a0; border-radius: 10px; background: var(--resk-warning-soft); color: var(--resk-warning-dark); font-size: 12px; font-weight: 800; }
        .foot-note { margin-top: 18px; color: var(--resk-text-muted); font-size: 11px; line-height: 1.6; }

        .lang-list { display: flex; flex-direction: column; gap: 14px; margin-top: 18px; }
        .lang { display: flex; align-items: center; gap: 16px; padding: 14px 16px; border: 1px solid var(--resk-border); border-radius: 10px; background: var(--resk-surface-alt); }
        .lang-code { width: 36px; height: 36px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--resk-cyan); color: white; font-size: 10px; font-weight: 800; text-transform: uppercase; }
        .lang:first-child .lang-code { background: var(--resk-navy-700); }
        .lang-text { flex: 1; min-width: 0; }
        .lang-text strong { display: block; color: var(--resk-navy-800); font-size: 13px; }
        .lang-text small { display: block; margin-top: 5px; color: var(--resk-text-muted); font-size: 11px; }
        .state { min-width: 78px; padding: 6px 14px; border: none; border-radius: 999px; background: var(--resk-success-soft); color: var(--resk-success); font-size: 11px; font-weight: 800; cursor: pointer; }
        .state.off { background: var(--resk-surface-2); color: var(--resk-text-soft); }
        .remove { width: 30px; height: 30px; border: none; border-radius: 8px; background: transparent; color: var(--resk-text-faint); font-size: 18px; line-height: 1; cursor: pointer; }
        .remove:hover { background: var(--resk-danger-soft); color: var(--resk-danger); }
        .add-lang { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 74px; margin-top: 14px; border: 1.5px dashed #c9d6e6; border-radius: 10px; background: white; color: var(--resk-cyan-dark); font-size: 13px; font-weight: 800; cursor: pointer; }
        .add-lang:hover { background: #f7fcfd; }
        .add-form { display: grid; grid-template-columns: 1.4fr 0.7fr 1.2fr auto auto; gap: 12px; align-items: end; margin-top: 14px; padding: 16px; border: 1.5px dashed #a9e3ec; border-radius: 10px; background: #f7fcfd; }
        .mini-button { height: 42px; padding: 0 18px; border: 1px solid var(--resk-border-mid); border-radius: 8px; background: white; color: var(--resk-navy-800); font-size: 12px; font-weight: 800; cursor: pointer; }
        .mini-button.go { border-color: var(--resk-cyan); background: var(--resk-cyan); color: white; }

        table.events { width: 100%; margin-top: 22px; border-collapse: collapse; }
        .events thead th { padding: 14px 20px; background: var(--resk-surface); color: var(--resk-text-soft); font-size: 10px; font-weight: 800; text-align: left; text-transform: uppercase; }
        .events thead th:first-child { border-radius: 8px 0 0 8px; }
        .events thead th:last-child { border-radius: 0 8px 8px 0; }
        .events th.col, .events td.col { width: 150px; }
        .events tbody td { padding: 18px 20px; border-bottom: 1px solid var(--resk-surface-2); vertical-align: middle; }
        .events tbody strong { display: block; color: var(--resk-navy-800); font-size: 13px; }
        .events tbody small { display: block; margin-top: 6px; color: var(--resk-text-muted); font-size: 11px; }
        .switch-only { position: relative; display: inline-block; cursor: pointer; }

        .saved-text { margin-top: 14px; color: var(--resk-text-faint); font-size: 11px; text-align: right; }

        @@media (max-width: 1000px) {
            .tabs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .grid-2, .grid-3, .chips { grid-template-columns: 1fr; }
            .toggle { flex-wrap: wrap; }
            .toggle .input { width: 100%; }
            .add-form { grid-template-columns: 1fr; }
            .events th.col, .events td.col { width: 80px; }
        }
    </style>